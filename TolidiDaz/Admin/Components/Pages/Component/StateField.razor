@using static Dto.Enum.EnumConstant
 @if(Value== ProductExistStatus.Existent)
{
    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">@Title</span>
}
else if(Value==ProductExistStatus.Nonexistent)
{
    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">@Title</span>
}
else
{
    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">نامشخص</span>
}



@code{
    [Parameter] public ProductExistStatus? Value { get; set; }
    [Parameter] public string? Title { get; set; }
}