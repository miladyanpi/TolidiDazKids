@using Admin.Components.Constant
@using Admin.Services.MageManagementService
@typeparam TService where TService : class, IImageManagementByFtpService
@implements IDisposable
@inject TService ImageService
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- Header -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت تصاویر</h2>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">تصاویر موردنظر را انتخاب و بارگذاری کنید.</p>
        </div>
        <a href="@BackUrl"
           class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg
            border border-red-300 text-red-600 bg-white
            hover:bg-red-50 hover:border-red-400
            dark:bg-gray-800 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950/40
            transition-colors">
            <i class="bi bi-arrow-return-right"></i>
            بازگشت
        </a>
    </div>

    <div class="space-y-6">

        <!-- Upload -->
        <section class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">آپلود فایل</h3>
            <UploadPublicFilesToFtp Title="آپلود فایل"
                                    StaticFileAccept="@StaticFileAccept.ImageFiles"
                                    OnChangeUpload="ImageService.AddToListImagesAsync" />
        </section>

        @if (ImageService.ResultUploadImages?.Any() == true)
        {
            <section class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">لیست فایل‌های آپلود شده</h3>
                <Admin.Components.Pages.Component.GridFilesftpPublic Title="لیست فایلهای آپلود شده"
                                                                     ResultUploadFiles="ImageService.ResultUploadImages"
                                                                     OnClickcallBack="ImageService.DeleteImage" />
            </section>
        }
        else
        {
            <div class="rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-700 p-12 text-center bg-white/50 dark:bg-gray-800/50">
                <div class="mx-auto w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center mb-4">
                    <i class="bi bi-images text-3xl text-gray-400"></i>
                </div>
                <p class="text-gray-500 dark:text-gray-400">هنوز تصویری بارگذاری نشده است.</p>
            </div>
        }
    </div>
</main>


