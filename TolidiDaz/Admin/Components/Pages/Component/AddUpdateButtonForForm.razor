@using Dto.Enum

<div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
    <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
        ذخیره
    </button>

</div>

@* <div class="modal-footer d-flex justify-content-between">

    <button class="btn btn-info" type="submit">ذخیره</button>
    <button class="btn btn-danger" type="button" href="@Link" data-bs-dismiss="modal" @onclick="@(async () => await GotoToLink())">@Title</button>
</div> *@


@code {

    [Parameter]
    public EventCallback Save { get; set; }

    [Parameter]
    public AlertToast? AlertToast { get; set; } = new AlertToast(EnumConstant.MessageType.success, "اطلاعات با موفقیت ثبت شد");
    [Parameter]
    public string? Link { get; set; } = "#";
    public string? Title { get; set; } = "بستن";
    private async Task SaveMehod()
    {
        await Save.InvokeAsync();
    }
    protected async override Task OnInitializedAsync()
    {
        if (Link != "#")
        {
            Title = "بازگشت";
        }
        else
        {
            Title = "بستن";
        }
    }
    private async Task GotoToLink()
    {
        if (Link != "#")
        {
            var parameter = new Dictionary<string, object>();
            NavManager.NavigateTo(NavManager.GetUriWithQueryParameters(Link, parameter));
        }
    }
}