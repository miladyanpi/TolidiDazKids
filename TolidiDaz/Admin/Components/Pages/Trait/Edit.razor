@page "/UpdateTrait/{guid}"
@using Admin.Services.Trait

@inject TraitService _TraitService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش اطلاعات ویژگی  ویژه</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات ویژگی  را ویرایش نمایید</p>
        </div>
        <BackButton UrlPage="Trait" />
    </div>
    @if (isLoading)
    {
        <FetchingData/>

    }
    else if (_TraitService.updateTrait == null)
    {
        <DataNotFound/>
    }
    else
    {
        <!-- Add category form -->
        <EditForm Model="_TraitService.updateTrait" OnValidSubmit="HandleSubmitAsync" FormName="UpdateForm">
            <DataAnnotationsValidator />
            <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
                <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                        فرم ویژگی 
                    </h3>
                </div>

                <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Trait Info -->
                    <div class="space-y-4">
                        <div>
                            <CustomLabel For="@(() => _TraitService.updateTrait.Title)"></CustomLabel>
                            <ValidationMessage For="@(() => _TraitService.updateTrait.Title)" class="validate" />
                            <InputText id="Trait-Title" @bind-Value="_TraitService.updateTrait.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div >
                            <CustomLabel  For="@(() => _TraitService.updateTrait.Description)"></CustomLabel>
                            <InputTextArea @bind-Value="_TraitService.updateTrait.Description" rows="10" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel For="@(() => _TraitService.updateTrait.Visible)"></CustomLabel>
                            <InputRadioGroup @bind-Value="_TraitService.updateTrait.Visible" Name="status">
                                <InsertUpdateVisible />
                            </InputRadioGroup>
                            <ValidationMessage For="@(() => _TraitService.updateTrait.Visible)" class="validate" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </EditForm>
    }
</main>

@code {

    [Parameter]
    public string? guid { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;
  
    protected override async Task OnParametersSetAsync()
    {
        bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            isLoading = true;
            await _TraitService.GetUpdateDataAsync(guid);
            isLoading = false;
        }
        else
        {

            NavManager.NavigateTo("/Trait");
        }
    }
    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;
        try
        {
            isSubmitting = true;
            await _TraitService.UpdateAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}