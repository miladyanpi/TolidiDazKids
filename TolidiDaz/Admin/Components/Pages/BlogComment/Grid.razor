@page "/BlogComment/{guid}"
@using Admin.Services.Blog
@using Admin.Services.BlogComment

@inject BlogCommentService _BlogCommentService
@inject BlogService _BlogService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت نظرات کاربران/بلاگ</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست نظرات کاربران برای بلاگ <span class="text-danger bold">@_BlogService.updateBlog.Title</span></p>
        </div>
        <BackButton UrlPage="Blog" />

    </div>

    <!-- Users list -->
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 pb-2 border-b border-gray-200 flex-wrap dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                لیست نظرات کاربران
            </h3>
            <Search OnClickcallBack="@_BlogCommentService.GetAllDataAsync" PlaceHolder="جستجو..." />
        </div>

        <!-- Users table -->
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">#</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.AuthorName)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.ResultBlog)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.Rating)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.IsVerifiedBuyer)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.Status)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.LikeCount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.DislikeCount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.RegisterDate)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => _BlogCommentService.resultBlogComment.RegisterTime)"></CustomLabel></th>

                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">عملیات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    <!-- User 1 -->
                    @{
                        decimal i = (_BlogCommentService.pagingModel.Page - 1) * _BlogCommentService.pagingModel.Take;

                    }
                    @foreach (var item in _BlogCommentService.ResultBlogComments)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@k</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.AuthorName</td>

                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@item.ResultBlog.Title</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Rating</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@((MarkupString)item.IsVerifiedBuyer)</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                @((MarkupString)item.Status)
                                @if (item.Status2 == EnumConstant.CommentStatus.Pending)
                                {
                                    <button @onclick="@(() => _BlogCommentService.SetStatusMessage(item.ID, EnumConstant.CommentStatus.Approved))"
                                            title="تایید پیام"
                                            class="text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>
                                    <button @onclick="@(() => _BlogCommentService.SetStatusMessage(item.ID, EnumConstant.CommentStatus.Rejected))"
                                            title="رد پیام"
                                            class="text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.5"
                                             stroke="currentColor"
                                             class="size-6">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M9.75 9.75 14.25 14.25M14.25 9.75 9.75 14.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>

                                }
                                else if (item.Status2 == EnumConstant.CommentStatus.Approved)
                                {
                                  
                                    <button @onclick="@(() => _BlogCommentService.SetStatusMessage(item.ID, EnumConstant.CommentStatus.Rejected))"
                                            title="رد پیام"
                                            class="text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.5"
                                             stroke="currentColor"
                                             class="size-6">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M9.75 9.75 14.25 14.25M14.25 9.75 9.75 14.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>

                                }

                                else if (item.Status2 == EnumConstant.CommentStatus.Rejected)
                                {
                                    <button @onclick="@(() => _BlogCommentService.SetStatusMessage(item.ID, EnumConstant.CommentStatus.Approved))"
                                            title="تایید پیام"
                                            class="text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.LikeCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.DislikeCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.RegisterDate</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.RegisterTime</td>

                         
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">

                               
                                <button @onclick="@(() => GoToShowBlogComment(item.IdentityCode))" title="نمایش پیام" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954 5.485a2.25 2.25 0 0 0 2.292 0L22.5 12" />
                                    </svg>
                                </button>
                                <button @onclick="@(async () => await _BlogCommentService.DeleteAsync(item.ID))" title="حذف" class="text-secondary-600 hover:text-secondary-900 dark:text-secondary-50 dark:hover:text-secondary-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                </button>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <Pagination pagingModel="_BlogCommentService.pagingModel" OnClickcallBack="@CallBackPagingAsync" />
    </div>
</main>
@code {
    [Parameter]
    public string? guid { get; set; } = null;
    protected override async Task OnInitializedAsync()
    {
        bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            var q1= _BlogCommentService.GetDataAsync();
            var q2 = _BlogService.GetUpdateDataAsync(guid);
            await Task.WhenAll(q1, q2);
        }
       

    }
   
   
    private async Task CallBackPagingAsync(decimal page)
    {
        _BlogCommentService.pagingModel.Page = page;
        await _BlogCommentService.GetDataAsync();
    }
    private void Edit(Guid? GUID)
    {
        NavManager.NavigateTo($"/UpdateBlog/{GUID}");
    }

    private void GoToShowBlogComment(Guid? guid)
    {

        NavManager.NavigateTo($"/ShowBlogComment/{guid}");
    }


}