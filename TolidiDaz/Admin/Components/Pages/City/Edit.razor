@page "/UpdateCity/{guid}"
@using Admin.Services.City
@using Admin.Services.Province

@inject CityService _CityService
@inject ProvinceService _ProvinceService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش اطلاعات شهر ویژه</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات شهر را ویرایش نمایید</p>
        </div>
        <BackButton UrlPage="City" />
    </div>
    @if (isLoading)
    {
       <FetchingData/>

    }
    else if (_CityService.updateCity == null)
    {
       <DataNotFound/>
    }
    else
    {
        <!-- Add category form -->
        <EditForm Model="_CityService.updateCity" OnValidSubmit="HandleSubmit" FormName="UpdateForm">
            <DataAnnotationsValidator />
            <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
                <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                        فرم شهر
                    </h3>
                </div>

                <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- City Info -->
                    <div class="space-y-4">
                        <div>
                            <CustomLabel ForId="category-parent" For="@(() => _CityService.updateCity.ProvinceID)"></CustomLabel>
                            <ValidationMessage For="@(() => _CityService.updateCity.ProvinceID)" class="validate" />
                            <InputSelect @bind-Value=" _CityService.updateCity.ProvinceID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _ProvinceService.ResultProvinces)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <CustomLabel ForId="City-Title" For="@(() => _CityService.updateCity.Title)"></CustomLabel>
                            <ValidationMessage For="@(() => _CityService.updateCity.Title)" class="validate" />
                            <InputText id="City-Title" @bind-Value="_CityService.updateCity.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                    </div>
                    <!-- Settings -->
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _CityService.updateCity.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_CityService.updateCity.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _CityService.updateCity.Visible)" class="validate" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" disabled="@isSubmitting" class="px-5 py-2 text-sm font-medium rounded-lg bg-primary text-white hover:opacity-90 transition disabled:opacity-50 disabled:cursor-not-allowed shadow-sm flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <span>ذخیره</span>
                    }
                </button>
            </div>
        </EditForm>
    }
</main>

@code {

    [Parameter]
    public string? guid { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;
    protected override async Task OnInitializedAsync()
    {
        await _ProvinceService.GetAllDataAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            isLoading = true;
            await _CityService.GetUpdateDataAsync(guid);
            isLoading = false;
        }
        else
        {
            // شناسه نامعتبر بود کاربر رو برگردون به لیست شهرها
            NavManager.NavigateTo("/City");
        }
    }
    private async Task HandleSubmit()
    {
        if (isSubmitting) return;
        try
        {
            isSubmitting = true;
            await _CityService.UpdateAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}