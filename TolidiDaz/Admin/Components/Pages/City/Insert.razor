@page "/InsertCity"
@using Admin.Services.City
@using Admin.Services.Province
@inject CityService _CityService
@inject ProvinceService _ProvinceService

<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- Header Page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن شهر جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات شهر جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="City" />
    </div>

    <!-- Form Section -->
    <EditForm Model="_CityService.addCity" OnValidSubmit="HandleSubmitAsync" FormName="AddForm">
        <DataAnnotationsValidator />
        
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <!-- Form Title -->
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات شهر
                </h3>
            </div>

            <!-- Fields Grid -->
            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Column 1: Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="category-parent" For="@(() => _CityService.addCity.ProvinceID)" />
                        <ValidationMessage For="@(() => _CityService.addCity.ProvinceID)" class="validate" />
                        <InputSelect id="category-parent" @bind-Value="_CityService.addCity.ProvinceID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _ProvinceService.ResultProvinces)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <CustomLabel ForId="City-Title" For="@(() => _CityService.addCity.Title)" />
                        <ValidationMessage For="@(() => _CityService.addCity.Title)" class="validate" />
                        <InputText id="City-Title" @bind-Value="_CityService.addCity.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div>

                <!-- Column 2: Settings -->
                <div class="space-y-4">
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _CityService.addCity.Visible)" />
                        <InputRadioGroup @bind-Value="_CityService.addCity.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _CityService.addCity.Visible)" class="validate" />
                    </div>
                </div>
            </div>

            <!-- Footer & Actions (الان دقیقاً داخل کادر اصلی قرار دارد) -->
            <div class="modal-footer px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" disabled="@isSubmitting" class="px-6 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed transition duration-150 ease-in-out">
                    @(isSubmitting ? "در حال ذخیره..." : "ذخیره")
                </button>
            </div>
        </div>
    </EditForm>
</main>

@code {
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await _ProvinceService.GetAllDataAsync();
        if (_ProvinceService.ResultProvinces.Count > 0)
        {
            _CityService.addCity.ProvinceID = _ProvinceService.ResultProvinces[0].ID;
        }

    }

    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
           

            await _CityService.AddAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
