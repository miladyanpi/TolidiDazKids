    private async Task Add()
    {
        addSetting.JsonTel = ResultTels.Count > 0 ? JsonConvert.SerializeObject(ResultTels) : null;
        addSetting.JsonMobile = ResultMobiles.Count > 0 ? JsonConvert.SerializeObject(ResultMobiles) : null;

        var resdata = await RootApiAddSetting.RunMethodApi("Settings", addSetting, method: Method.Post);
        if (resdata.Status == ResultMessageApi.Success)
        {
            addSetting = new AddSetting();
            await JS.CallAlertToast(resdata.Message);
            await GetData();
        }
    }
  
