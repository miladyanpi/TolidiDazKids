        if (resdata is null)
        {
            NavManager.NavigateTo("/login", true);
            return;
        }
        int Count = resdata.CountAllRecordTable;
        ResultSettings = resdata.Entities!.ToList();
        if(ResultSettings.Count>0)
        {
            updateSetting.ID = ResultSettings[0].ID;
            updateSetting.Name = ResultSettings[0].Name;
            updateSetting.CountShowRecord = ResultSettings[0].CountShowRecord;
            updateSetting.PhoneSender = ResultSettings[0].PhoneSender;
            updateSetting.UserName = ResultSettings[0].UserName;
            updateSetting.Password = ResultSettings[0].Password;
            updateSetting.CurrencyUnit = ResultSettings[0].CurrencyUnit2;
            updateSetting.Email = ResultSettings[0].Email;
            updateSetting.JsonTel = ResultSettings[0].JsonTel;
            updateSetting.JsonMobile = ResultSettings[0].JsonMobile;
            updateSetting.Address = ResultSettings[0].Address;
            updateSetting.RegisterDate = ResultSettings[0].RegisterDate;
            updateSetting.RegisterTime = ResultSettings[0].RegisterTime;
            updateSetting.EditDate = ResultSettings[0].EditDate;
            updateSetting.EditTime = ResultSettings[0].EditTime;
            updateSetting.Visible = ResultSettings[0].Visible;
            updateSetting.JsonPicture = ResultSettings[0].JsonPicture;
            updateSetting.Slug = ResultSettings[0].Slug;
            updateSetting.IdentityCode = ResultSettings[0].IdentityCode;
            ResultTels = ResultSettings[0].ResultTels;
            ResultMobiles = ResultSettings[0].ResultMobiles;
        }
        else
