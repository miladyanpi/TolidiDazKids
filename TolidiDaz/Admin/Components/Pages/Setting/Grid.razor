        updateSetting.JsonMobile = ResultMobiles.Count > 0 ? JsonConvert.SerializeObject(ResultMobiles) : null;

        var Result = await RootApiUpdateSetting.RunMethodApi("Settings", updateSetting, method: Method.Patch);
