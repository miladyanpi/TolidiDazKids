@page "/Setting"
@using Dto.Models.DtoSetting
@using Dto.Models.DtoUploadFile
@using Microsoft.AspNetCore.Components.Authorization
@inject SweetAlertService Swal
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService localStorageService
@inject NavigationManager NavManager
@inject IRootApi<ResponseApiEntity<AddSetting>> RootApiAddSetting
@inject IToastMessage JS
@inject SweetAlertService Swal
@inject IRootApi<ResponseApiEntities<ResultSetting>> RootApiResultSettings
@inject IRootApi<ResponseApiEntity<ResultSetting>> RootApiResultSetting
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFiles
@inject IRootApi<ResponseApiEntity<UpdateSetting>> RootApiUpdateSetting
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]
<!--Page content-->
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!--Page header-->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">تنظیمات سیستم</h2>
            <p class="text-gray-600 dark:text-gray-400">مدیریت تنظیمات کلی سیستم فروشگاه</p>
        </div>
    </div>

    <!--General settings-->
    @if (ResultSettings.Count == 0)
    {
        <EditForm Model="addSetting" OnValidSubmit="Add" FormName="AddForm">
            <DataAnnotationsValidator />
