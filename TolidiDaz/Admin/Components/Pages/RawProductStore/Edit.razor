@page "/UpdateRawProductStore"
@using Dto.Models.DtoAccount
@using Dto.Models.DtoRawProduct
@using Dto.Models.DtoRawProductStore
@using Dto.Models.DtoUploadFile
@using System.Net.Http.Headers
@using Newtonsoft.Json
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<UpdateRawProductStore>> RootApiUpdateRawProductStore
@inject IRootApi<ResponseApiEntity<AddRawProductStore>> RootApiAddRawProductStore
@inject IRootApi<ResponseApiEntities<ResultRawProduct>> RootApiRawProducts

@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش اطلاعات انبار مواد اولیه</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات انبار مواد اولیه را ویرایش نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add category form -->
    <EditForm Model="updateRawProductStore" OnValidSubmit="Update" FormName="UpdateForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم انبار مواد اولیه
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- RawProductStore Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="RawProductStore-parent" For="@(() => updateRawProductStore.RawProductID)"></CustomLabel>
                        <ValidationMessage For="@(() => updateRawProductStore.RawProductID)" class="validate" />
                        <InputSelect @bind-Value="updateRawProductStore.RawProductID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in resultRawProducts)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="RawProductStore-MessurmentType" For="@(() => updateRawProductStore.MessurmentType)"></CustomLabel>
                        <ValidationMessage For="@(() => updateRawProductStore.MessurmentType)" class="validate" />
                        <InputSelect @bind-Value="updateRawProductStore.MessurmentType" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in MessurmentTypes)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="RawProductStore-Amount" For="@(() => updateRawProductStore.Amount)"></CustomLabel>
                        <ValidationMessage For="@(() => updateRawProductStore.Amount)" class="validate" />
                        <InputNumber @bind-Value="updateRawProductStore.Amount" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="RawProductStore-Price" For="@(() => updateRawProductStore.Price)"></CustomLabel>
                        <ValidationMessage For="@(() => updateRawProductStore.Price)" class="validate" />
                        <InputNumber @bind-Value="updateRawProductStore.Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div class="form-group ">
                        <CustomLabel For="@(() => updateRawProductStore.BuyDate)"></CustomLabel>
                        <ValidationMessage For="@(() => updateRawProductStore.BuyDate)" class="validate" />
                        <InputPersianDatePicker @bind-Value="updateRawProductStore.BuyDate"
                                                MinDateSetOnToday="false"
                                                Placeholder="تاریخ خرید"
                                                CssClass="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div>
                <!-- Settings -->
                <div class="space-y-4">

                  @*   <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">وضعیت*</label>
                        <InputRadioGroup @bind-Value="updateRawProductStore.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => updateRawProductStore.Visible)" class="validate" />
                    </div> *@

                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {
    private UpdateRawProductStore? updateRawProductStore { get; set; } = new() { Visible = true };
    [SupplyParameterFromQuery]
    public int ID { get; set; }
    List<ResultRawProduct> resultRawProducts = new();
    List<(int ID, string Title)> MessurmentTypes = new List<(int, string)>();

    protected async override Task OnInitializedAsync()
    {
        var resdata = await RootApiRawProducts.RunMethodApi($"RawProducts/All", null, method: Method.Get);
        resultRawProducts = resdata.Entities.ToList();
        if (resultRawProducts.Count > 0)
            updateRawProductStore.RawProductID = resultRawProducts[0].ID;

        MessurmentTypes = EnumConstant.GetListMessurmentType();
        if (MessurmentTypes.Count > 0)
            updateRawProductStore.MessurmentType = MessurmentTypes[0].ID;
        await GetData();

    }
 
    private async Task Update()
    {
        if (updateRawProductStore.Price <= 0)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "مبلغ بیشتر از صفر وارد کنید",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;
        }

        if (updateRawProductStore.Amount <= 0)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "مقدار بیشتر از صفر وارد کنید",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;
        }

        var resdata = await RootApiUpdateRawProductStore.RunMethodApi("RawProductStores", updateRawProductStore, method: Method.Patch);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateRawProductStore.RunMethodApi($"RawProductStores/{ID}", null, method: Method.Get);
        updateRawProductStore = resdataEdit.Entity;



    }
    private void GoBack()
    {
        NavManager.NavigateTo("/RawProductStore");
    }

}

