@page "/CartItems"
@using Dto.Models.DtoCartItem
@using Dto.Models.DtoProvince
@using Newtonsoft.Json
@using System.ComponentModel
@using static Dto.Enum.EnumConstant
@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntities<ResultCartItem>> RootApiGet
@inject IRootApi<ResponseApiEntity<ResultCartItem>> RootApiDelete
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFiles

@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<!-- page content -->
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت اقلام سبد خرید</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست تمام اقلام سبد خرید ثبت شده در سیستم</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="() => { GoToCarts();}" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- CartItemss table -->
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 pb-2 border-b border-gray-200 flex-wrap dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                لیست اقلام سبد خرید
            </h3>
            <Search OnClickcallBack="@GetData" PlaceHolder="جستجو..." />
        </div>

        <!-- Users table -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            ردیف
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultCartItems.RegisterDate)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultCartItems.ResultProduct.Title)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultCartItems.ResultProduct.Price)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultCartItems.Quantity)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultCartItems.TotalAmount)"></CustomLabel>
                        </th>

                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            اقدامات
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    @{
                        decimal i = (pagingModel.Page - 1) * pagingModel.Take;

                    }
                    @foreach (var item in ResultCartItems)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@k</div>
                            </td>

                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900 dark:text-white">@item.RegisterDate</div>
                                <div class="text-sm text-gray-500 dark:text-gray-400">@item.RegisterTime</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.ResultProduct.Title </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.ResultProduct.Price.ToString("N0") تومان </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.Quantity</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.TotalAmount.ToString("N0") تومان</div>
                            </td>
                         
                        </tr>
                    }


                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <Pagination pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />
    </div>
  
</main>
@code {
    public EnumComponentName.ComponentNameType ComponentNameType { get; set; } = EnumComponentName.ComponentNameType.Insert;

    private PagingModel pagingModel { get; set; } = new();
    private ResultCartItem resultCartItems { get; set; } = new();
    private List<ResultCartItem>? ResultCartItems { get; set; } = new List<ResultCartItem>();
    [SupplyParameterFromQuery]
    public string? IdentityCode { get; set; }
    [SupplyParameterFromQuery]
    public string? CustomerIdentityCode { get; set; }

    protected async override Task OnInitializedAsync()
    {

        pagingModel.Page = 1;
        pagingModel.Take = BaseCode.GetCountShowRecord();
        await GetData();
    }

    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();
    }

    private async Task GetData(string? SearchText = "")
    {
        var Search = BaseCode.GetSearchText(SearchText);
        var resdata = await RootApiGet.RunMethodApi($"CartItems?Page={pagingModel.Page}&IdentityCode={IdentityCode}&Take={pagingModel.Take}{Search}", null, method: Method.Get);
        decimal Count = resdata?.CountAllRecordTable ?? 0;
        ResultCartItems = resdata.Entities?.ToList() ?? new List<ResultCartItem>();
        pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
        pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
    }

    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {

            var resdata = await RootApiDelete.RunMethodApi($"CartItems/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {
                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }

    private void GoToCarts()
    {
        var parameter = new Dictionary<string, object>
        {
            {"IdentityCode", CustomerIdentityCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/CustomerCart", parameter!));
    }
   
  
}