@page "/Blog"
@using Admin.Services.Blog
@using Admin.Services.GroupBlog
@using Dto.Models.DtoBlog
@inject NavigationManager NavManager
@inject BlogService _BlogService
@inject GroupBlogService _GroupBlogService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت بلاگ</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست تمام بلاگ</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/InsertBlog" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                بلاگ جدید
            </a>
        </div>
    </div>
    <div class="mb-3 bg-white p-4">
        <CustomLabel ForId="category-parent" For="@(() => resultBlog.GroupBlogID)"></CustomLabel>
        <InputSelect @bind-Value="resultBlog.GroupBlogID" @bind-Value:after="@(async () => await _BlogService.GetDataAsync())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
            @foreach (var item in _GroupBlogService.ResultGroupBlogs)
            {
                <option value="@item.ID">@item.Title</option>
            }
        </InputSelect>

    </div>
    <!-- Users list -->
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 pb-2 border-b border-gray-200 flex-wrap dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                لیست بلاگ
            </h3>
            <Search OnClickcallBack="@_BlogService.GetDataAsync" PlaceHolder="جستجو..." />
        </div>

        <!-- Users table -->
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">#</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.Title)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.ResultGroupBlog)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.ResultTeam)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.StudyDuration)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.NumberOfVisits)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.JsonLableTexts)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultBlog.RegisterDate)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultBlog.Visible)"></CustomLabel>
                        </th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">عملیات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    <!-- User 1 -->
                    @{
                        decimal i = (_BlogService.pagingModel.Page - 1) * _BlogService.pagingModel.Take;

                    }
                    @foreach (var item in _BlogService.ResultBlogs)
                    {
                        var ResultUploadImages = !string.IsNullOrEmpty(@item.JsonPicture) ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(@item.JsonPicture) : new List<ResultUploadFile>();
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@k</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    @if (ResultUploadImages.Count > 0)
                                    {
                                        var path = @ApiLink.FullPath + @ResultUploadImages[0].PathFileName;

                                        <div class="flex-shrink-0 h-10 w-10">
                                            <img class="h-10 w-10 rounded-md object-cover" src="@path" alt="@item.Title">
                                        </div>
                                    }
                                    <div class="mr-4">
                                        <div class="text-sm font-medium text-gray-900 dark:text-white">@item.Title</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@item.ResultGroupBlog.Title</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@item.ResultTeam.Name (@item.ResultTeam.Title)</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.StudyDuration</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.NumberOfVisits</td>
                            <td><JsonLableData ResultJsonLables="item.ResultJsonLables" /></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.RegisterDate</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <Visible Value="@item.Visible" />
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button title="تصاویر" @onclick="@( () =>  ListFiles(item.IdentityCode))"
                                        class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 ml-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                         stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <title>تصاویر</title>
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M3 5.25C3 4.007 4.007 3 5.25 3h13.5C19.993 3 21 4.007 21 5.25v13.5c0 1.243-1.007 2.25-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18.75V5.25z" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M8.25 13.5l2.25-3 3 3.75 4.5-6.75" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M15 8.25a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                                    </svg>

                                </button>
                                <button @onclick="@(() => GoToBlogComment(item.IdentityCode))" title="نظرات کاربران" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                         stroke-width="1.5" stroke="currentColor" class="size-6">

                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M2.25 12c0 4.556 4.03 8.25 9 8.25 1.336 0 2.604-.247 3.72-.688.254-.1.53-.13.8-.087l3.09.515a.75.75 0 0 0 .857-.857l-.515-3.09a1.125 1.125 0 0 1 .087-.8c.441-1.116.688-2.384.688-3.72 0-4.97-4.03-9-9-9s-9 4.03-9 9Z" />

                                    </svg>
                                </button>
                                <button @onclick="@(() => Edit(item.IdentityCode))" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                    </svg>
                                </button>
                                <button @onclick="@(async () => await _BlogService.DeleteAsync(item.ID))" class="text-secondary-600 hover:text-secondary-900 dark:text-secondary-50 dark:hover:text-secondary-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                </button>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <Pagination pagingModel="_BlogService.pagingModel" OnClickcallBack="@CallBackPagingAsync" />
    </div>
</main>
@code {

    private ResultBlog resultBlog { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _BlogService.OnChange += HandleStateChange;
        await _BlogService.GetDataAsync();
    }
    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        _BlogService.OnChange -= HandleStateChange;
    }
    private async Task CallBackPagingAsync(decimal page)
    {
        _BlogService.pagingModel.Page = page;
        await _BlogService.GetDataAsync();
    }
    private void Edit(Guid? GUID)
    {
        NavManager.NavigateTo($"/UpdateBlog/{GUID}");
    }
    private void ListFiles(Guid? GUID)
    {
        NavManager.NavigateTo($"/BlogFiles/{GUID}");
    }
    private void GoToBlogComment(Guid? GUID)
    {
        NavManager.NavigateTo($"/BlogComment/{GUID}");
    }
}
