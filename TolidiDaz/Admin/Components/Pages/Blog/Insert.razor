@page "/InsertBlog"
@using Admin.Services.Blog
@using Admin.Services.GroupBlog
@using Admin.Services.Team
@inject BlogService _BlogService
@inject GroupBlogService _GroupBlogService
@inject TeamService _TeamService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن بلاگ جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات بلاگ جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="Blog" />
    </div>
    <!-- Add category form -->
    <EditForm Model="_BlogService.addBlog" OnValidSubmit="_BlogService.AddAsync" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات بلاگ
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="category-parent" For="@(() => _BlogService.addBlog.GroupBlogID)"></CustomLabel>
                        <ValidationMessage For="@(() => _BlogService.addBlog.GroupBlogID)" class="validate" />
                        <InputSelect @bind-Value="_BlogService.addBlog.GroupBlogID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _GroupBlogService.ResultGroupBlogs)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>

                    </div>
                    <div>
                        <CustomLabel ForId="category-parent" For="@(() => _BlogService.addBlog.TeamID)"></CustomLabel>
                        <ValidationMessage For="@(() => _BlogService.addBlog.TeamID)" class="validate" />
                        <InputSelect @bind-Value="_BlogService.addBlog.TeamID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _TeamService.ResultTeams)
                            {
                                <option value="@item.ID">@item.Name (@item.Title)</option>
                            }
                        </InputSelect>

                    </div>
                    <div>
                        <CustomLabel ForId="Blog-Title" For="@(() => _BlogService.addBlog.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => _BlogService.addBlog.Title)" class="validate" />
                        <InputText id="Blog-Title" @bind-Value="_BlogService.addBlog.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Blog-StudyDuration" For="@(() => _BlogService.addBlog.StudyDuration)"></CustomLabel>
                        <ValidationMessage For="@(() => _BlogService.addBlog.StudyDuration)" class="validate" />
                        <InputText @bind-Value="_BlogService.addBlog.StudyDuration" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div class="form-group ">
                        <CustomLabel For="@(() => _BlogService.addBlog.JsonLableTexts)"></CustomLabel>
                        <Admin.Components.Pages.Lable.Grid JsonLable="@_BlogService.addBlog.JsonLableTexts" GetListAddJsonLables="_BlogService.SetDataLable" />
                </div>
      
                </div>


                <!-- Settings -->
                <div class="space-y-4">

                    <div>
                        <CustomLabel ForId="Blog-description" For="@(() => _BlogService.addBlog.Description)"></CustomLabel>
                        <TextEditor @bind-Value="_BlogService.addBlog.Description" />
                    </div>
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _BlogService.addBlog.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_BlogService.addBlog.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _BlogService.addBlog.Visible)" class="validate" />
                    </div>

                </div>

            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _GroupBlogService.OnChange += StateHasChanged;
            _TeamService.OnChange += StateHasChanged;
            var q1= _GroupBlogService.GetAllDataAsync();
            var q2= _TeamService.GetAllDataAsync();
            await Task.WhenAll(q1, q2);
            if (_GroupBlogService.ResultGroupBlogs.Count > 0)
                _BlogService.addBlog.GroupBlogID = _GroupBlogService.ResultGroupBlogs[0].ID;
            if (_TeamService.ResultTeams.Count > 0)
                _BlogService.addBlog.TeamID = _TeamService.ResultTeams[0].ID;
        }
    }
    public void Dispose()
    {
        _GroupBlogService.OnChange -= StateHasChanged;
        _TeamService.OnChange -= StateHasChanged;
    }
}

