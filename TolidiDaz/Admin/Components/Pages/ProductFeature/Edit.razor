@page "/UpdateProductFeature/{guid}"
@using Admin.Services.Category
@using Admin.Services.ProductFeature
@inject ProductFeatureService _ProductFeatureService
@inject CategoryService _CategoryService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش مشخصات ویژگی</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات مشخصات ویژگی را ویرایش نمایید</p>
        </div>
        <BackButton UrlPage="ProductFeature" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_ProductFeatureService.updateProductFeature" OnValidSubmit="HandleSubmit" FormName="AddForm">
        <DataAnnotationsValidator />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left column - ProductFeature info -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Basic info card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 p-6 border border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-6 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary-600 after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary-600 after:rounded-lg">اطلاعات پایه ویژگی</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>

                            <CustomLabel ForId="ProductFeature-category1" For="@(() => _CategoryService.updateCategory.ParentID1)"></CustomLabel>
                            <InputSelect @bind-Value="_CategoryService.updateCategory.ParentID1" @bind-Value:after="@( () => GetCategoryParent2InUpdate())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys1)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>

                        </div>
                        <div>

                            <CustomLabel ForId="ProductFeature-category2" For="@(() => _ProductFeatureService.updateProductFeature.CategoryID)"></CustomLabel>
                            <InputSelect @bind-Value="_ProductFeatureService.updateProductFeature.CategoryID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys2)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <CustomLabel ForId="ProductFeature-name" For="@(() => _ProductFeatureService.updateProductFeature.Title)"></CustomLabel>
                            <ValidationMessage For="@(() => _ProductFeatureService.updateProductFeature.Title)" class="validate" />
                            <InputText id="ProductFeature-name" @bind-Value="_ProductFeatureService.updateProductFeature.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div >
                            <CustomLabel ForId="Visible-stock" For="@(() => _ProductFeatureService.updateProductFeature.Visible)"></CustomLabel>
                            <InputRadioGroup @bind-Value="_ProductFeatureService.updateProductFeature.Visible" Name="status">
                                <InsertUpdateVisible />
                            </InputRadioGroup>
                            <ValidationMessage For="@(() => _ProductFeatureService.updateProductFeature.Visible)" class="validate" />
                        </div>
                    </div>
                </div>
                 <SaveButton Disabled="@isSubmitting"/>
            </div>

        </div>
    </EditForm>
</main>

@code {

    [Parameter]
    public string? guid { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;
    protected override async Task OnParametersSetAsync()
    {
        await _CategoryService.GetAllDataAsync();

         bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            isLoading = true;
            await _ProductFeatureService.GetUpdateDataAsync(guid);
            isLoading = false;
        }
        else
        {
       
            NavManager.NavigateTo("/ProductFeature");
        }
    }
    private async Task GetCategoryParent2InUpdate()
    {
        _CategoryService.GetCategoryParent2InUpdate();
        if (_CategoryService.ResultCategorys2.Count>0)
        {
            _ProductFeatureService.updateProductFeature.CategoryID = _CategoryService.ResultCategorys2[0].ID;
        }
        else
        {
            _ProductFeatureService.updateProductFeature.CategoryID = null;
        }
    }
     private async Task HandleSubmit()
    {
        if (isSubmitting) return;
        try
        {
            isSubmitting = true;
            await _ProductFeatureService.UpdateAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}