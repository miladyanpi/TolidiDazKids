                                        <div class="text-sm text-gray-500 dark:text-gray-400">@item.ResultCustomerUserInfo.UserName</div>
                                    </div>

                                </div>
                            </td>

                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.BirthDate</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Gender</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.ResultCustomerUserInfo.Mobile</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.Roles != null)
                                {
