                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">@role.RoleTitle</span>
                                        <span>-</span>
                                    }
                                }

                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.CartCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.OrderCount</td>

                            <td class="px-6 py-4 whitespace-nowrap">
                                <Visible Value="item.Visible" />
                            </td>
                       
