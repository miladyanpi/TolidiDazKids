@page "/Product"
@using Admin.Services
@using Admin.Services.Category
@using Dto.Models
@using Dto.Models.DtoProduct
@using Dto.Models.DtoUploadFile
@using Newtonsoft.Json
@using Admin.Services.Search
@inject SearchService _SearchService
@inject DisableService _DisableService
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntities<ResultProduct>> RootApiGet
@inject IRootApi<ResponseApiEntity<ResultProduct>> RootApiDelete
@inject IRootApi<ResponseApiEntity<UpdateProduct>> RootApiSetDefault
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFiles
@inject CategoryService _CategoryService

@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="bg-white shadow-lg rounded-2xl p-6 mb-8 dark:bg-gray-800">

        <!-- عنوان فیلتر -->
        <h3 class="text-lg font-semibold mb-4 text-gray-700 dark:text-gray-200">
            فیلتر
        </h3>


        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (!_DisableService.Disabled)
            {


                <div>

                    <CustomLabel ForId="ProductFeature-category1" For="@(() => _CategoryService.addCategory.ParentID1)"></CustomLabel>
                    <InputSelect @_SearchService.Disabled @bind-Value="_CategoryService.addCategory.ParentID1" @bind-Value:after="@( ()=> GetCategoryParent1())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        @foreach (var item in _CategoryService.ResultCategorys1)
                        {
                            <option value="@item.ID">@item.Title</option>
                        }
                    </InputSelect>

                </div>
                <div>

                    <CustomLabel ForId="ProductFeature-category2" For="@(() => _CategoryService.addCategory.ParentID2)"></CustomLabel>
                    <InputSelect @_SearchService.Disabled @bind-Value="_CategoryService.addCategory.ParentID2" @bind-Value:after="@( ()=> GetCategoryParent2())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        @foreach (var item in _CategoryService.ResultCategorys2)
                        {
                            <option value="@item.ID">@item.Title</option>
                        }
                    </InputSelect>
                </div>
                <div>

                    <CustomLabel ForId="ProductFeature-category3" For="@(() => _CategoryService.CategoryID)"></CustomLabel>
                    <InputSelect @bind-Value="_CategoryService.CategoryID" @bind-Value:after="@( async ()=> await GetData())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        @foreach (var item in _CategoryService.ResultCategorys3)
                        {
                            <option value="@item.ID">@item.Title</option>
                        }
                    </InputSelect>
                </div>
            }
            <div>
                <InputCheckbox @bind-Value="SearchAllFlag" @bind-Value:after="(async () => await Search())" />
                <label>جستجو در تمام دسته بندی ها</label>

            </div>
        </div>
    </div>
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت محصولات</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست تمام محصولات</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/InsertProduct" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                محصول جدید
            </a>
        </div>
    </div>
    <!-- Categories list -->
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 border-b border-gray-200 flex-wrap pb-2 dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                لیست محصولات
            </h3>
            <Search OnClickcallBack="@GetData" PlaceHolder="جستجو..." />
        </div>
        <!-- Categories table -->
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">#</th>

                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.Title)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.ResultCategory.Title)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.SkuCode)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.Count)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.Discount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.Price)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.ViewCount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.ProductExistStatus)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProduct.Visible)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">عملیات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    @{
                        decimal i = (pagingModel.Page - 1) * pagingModel.Take;

                    }

                    @foreach (var item in ResultProducts)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@i</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    @if (item.ResultUploadFiles != null && item.ResultUploadFiles.Count > 0)
                                    {
                                        var path = @ApiLink.FullPath + @item.ResultUploadFiles[0].PathFileName;

                                        <div class="flex-shrink-0 h-10 w-10">
                                            <img class="h-10 w-10 rounded-md object-cover" src="@path" alt="@item.Title">
                                        </div>
                                    }
                                    <div class="mr-4">
                                        <div class="text-sm font-medium text-gray-900 dark:text-white">@item.Title</div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">کد:@item.ProductCode</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.ResultCategory.Title</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.SkuCode</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Count</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Discount.ToString("N0")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                @if (item.Discount > 0)
                                {
                                    Int64 finishPrice = item.Price - item.Discount;
                                    <div class="font-medium">@finishPrice.ToString("N0") <span class="text-xs">تومان</span></div>
                                    <div class="text-xs text-gray-400 line-through">@item.Price.ToString("N0") تومان</div>
                                }
                                else
                                {
                                    <div class="font-medium">@item.Price.ToString("N0") <span class="text-xs">تومان</span></div>
                                }


                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.ViewCount.ToString("N0")</td>

                            <td class="px-6 py-4 whitespace-nowrap">
                                <StateField Value="@item.ProductExistStatus2" Title="@item.ProductExistStatus" />
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <Visible Value="item.Visible" />
                            </td>
                             <td class="px-6 py-4 whitespace-nowrap text-sm font-medium relative" @onclick:stopPropagation="true">
                                <div class="flex justify-end">
                                    <!-- دکمه اصلی منو -->
                                    <button @onclick="() => ToggleDropdown(item.ID)"
                                            class="flex items-center gap-2 px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500">

                                        <span class="font-medium text-sm">عملیات</span>

                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                             style="@(openDropdownId == item.ID ? "transform: rotate(180deg)" : "")">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                        </svg>
                                    </button>

                                    <!-- منوی کشویی -->
                                    @if (openDropdownId == item.ID)
                                    {
                                        <!-- Overlay شفاف برای بستن با کلیک خارج -->
                                        <div class="fixed inset-0 z-40 bg-transparent" @onclick="CloseDropdown" @onclick:stopPropagation="false"></div>

                                        <!-- خود منو -->
                                        <div class="absolute left-0 md:right-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 py-2 z-50"
                                             @onclick:stopPropagation="true">
                                            <div class="px-2">
                                                <button title="قیمت عمده" @onclick="@(() => GoToPricingRule(item.ID))" class="text-red-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">

                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 12 3l9 4.5M3 7.5 12 12m-9-4.5v9L12 21m0-9 9-4.5M12 12v9m9-13.5v9L12 21"></path>

                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 5.25 12 7.5l4.5-2.25"></path>
                                                    </svg>

                                                </button>
                                                <button title="تصاویر" @onclick="@(async () => await ListFiles(item.ID))"
                                                        class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 ml-4">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                         viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                         class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                              d="M19.5 14.25v-5.379a1.5 1.5 0 0 0-.44-1.06l-3.87-3.87a1.5 1.5 0 0 0-1.06-.44H8.25A2.25 2.25 0 0 0 6 6.75v10.5A2.25 2.25 0 0 0 8.25 19.5h7.5A2.25 2.25 0 0 0 18 17.25V15m-6-8.25V9a.75.75 0 0 0 .75.75H15" />
                                                    </svg>
                                                </button>
                                                <button @onclick="@(() => GoToProductComment(item.ID))" title="نظرات کاربران" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                         stroke-width="1.5" stroke="currentColor" class="size-6">

                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                              d="M2.25 12c0 4.556 4.03 8.25 9 8.25 1.336 0 2.604-.247 3.72-.688.254-.1.53-.13.8-.087l3.09.515a.75.75 0 0 0 .857-.857l-.515-3.09a1.125 1.125 0 0 1 .087-.8c.441-1.116.688-2.384.688-3.72 0-4.97-4.03-9-9-9s-9 4.03-9 9Z" />

                                                    </svg>
                                                </button>
                                                <button @onclick="@(() => GoToUpdate(item.ID))" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                                    </svg>
                                                </button>
                                                <button @onclick="@(async () => await Delete(item.ID))" class="text-secondary-600 hover:text-secondary-900 dark:text-secondary-50 dark:hover:text-secondary-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                           
                        </tr>

                    }
                </tbody>
            </table>

        </div>
        <!-- Pagination -->
        <Pagination pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />

    </div>
</main>


@code {
    bool SearchAllFlag = false;
    public UpdateProduct? updateProduct { get; set; } = new();
    private PagingModel pagingModel { get; set; } = new();
    private ResultProduct resultProduct { get; set; } = new();
    private List<ResultProduct>? ResultProducts { get; set; } = new List<ResultProduct>();
    private List<int> expandedRows { get; set; } = new List<int>();
    private List<int> expandedRowsLevel3 { get; set; } = new List<int>();
    public int ID { get; set; } = 0;
    private int? openDropdownId = null;

    private void ToggleDropdown(int id)
    {
        openDropdownId = openDropdownId == id ? null : id;
    }

    private void CloseDropdown()
    {
        openDropdownId = null;
    }
    protected async override Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = BaseCode.GetCountShowRecord();
        await _CategoryService.GetInitialData();
        await GetData();
    }

    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();
    }
    private async Task GetCategoryParent2()
    {
        await _CategoryService.GetCategoryParent2(_CategoryService.addCategory.ParentID2);
        await GetData();

    }
    private async Task GetCategoryParent1()
    {
        await _CategoryService.GetCategoryParent1(_CategoryService.addCategory.ParentID1);
        await GetData();

    }
    private async Task Search()
    {

        _DisableService.SetDisabled(SearchAllFlag);
        await GetData();
    }
    private async Task GetData()
    {
        var Search = BaseCode.GetSearchText(_SearchService.SearchText);
        ResponseApiEntities<ResultProduct> resdata;
        if (SearchAllFlag)
        {
            resdata = await RootApiGet.RunMethodApi($"Products?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}", null, method: Method.Get);

        }
        else
        {
            resdata = await RootApiGet.RunMethodApi($"Products?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&CategoryID={_CategoryService.CategoryID}", null, method: Method.Get);
        }
        if (resdata != null)
        {
            decimal Count = resdata.CountAllRecordTable;
            ResultProducts = resdata.Entities.ToList();
            pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
            pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
        }

    }

    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {
            DeleteUploadFile deleteUploadFile = new DeleteUploadFile();
            var dataTemp = ResultProducts.Where(s => s.ID == ID).FirstOrDefault();
            var resultUploadFiles = dataTemp != null && dataTemp.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(dataTemp.JsonPicture) : new List<ResultUploadFile>();
            deleteUploadFile.ResultUploadFiles = resultUploadFiles;
            deleteUploadFile.ID = ID;

            var resdata = await RootApiDelete.RunMethodApi($"Products/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {
                _ = await RootApiResultUploadFiles.RunMethodApi($"DeleteFile/MultiFiles", deleteUploadFile, method: Method.Post);

                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }


    private async Task ListFiles(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID", id.ToString()},


        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/ProductFiles", parameter!));
    }
    private void GoToInsert()
    {

        NavManager.NavigateTo("/InsertProduct", forceLoad: true);
    }
    private void GoToPricingRule(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ProductID", id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/PricingRule", parameter!), forceLoad: true);

    }

    private void GoToUpdate(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID", id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/UpdateProduct", parameter!));
    }
    private void GoToProductComment(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ProductID", id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/ProductComment/", parameter!));
    }
}