@page "/InsertProduct"
@using Admin.Services.Category
@using Admin.Services.Product
@using Admin.Services.ProductFeature
@inject ProductService _ProductService
@inject CategoryService _CategoryService
@inject ProductFeatureService _ProductFeatureService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->

    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن محصول جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات محصول جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="Product" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_ProductService.addProduct" OnValidSubmit="HandleSubmitAsync" FormName="AddForm">
        <DataAnnotationsValidator />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left column - Product info -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Basic info card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 p-6 border border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-6 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary-600 after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary-600 after:rounded-lg">اطلاعات پایه محصول</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>

                            <CustomLabel For="@(() => _CategoryService.addCategory.ParentID1)"></CustomLabel>
                            <InputSelect @bind-Value="_CategoryService.addCategory.ParentID1" @bind-Value:after="@( ()=>  GetCategoryParent2InAdd())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys1)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>

                        </div>
                        <div>

                            <CustomLabel  For="@(() => _CategoryService.addCategory.ParentID2)"></CustomLabel>
                            <InputSelect @bind-Value="_CategoryService.addCategory.ParentID2" @bind-Value:after="@( () => GetCategoryParent3InAdd())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys2)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <CustomLabel For="@(() => _ProductService.CategoryID)"></CustomLabel>
                            <InputSelect @bind-Value="_ProductService.CategoryID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys3)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <CustomLabel For="@(() => _ProductService.addProduct.Title)"></CustomLabel>
                            <ValidationMessage For="@(() => _ProductService.addProduct.Title)" class="validate" />
                            <InputText id="product-name" @bind-Value="_ProductService.addProduct.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel  For="@(() => _ProductService.addProduct.Brand)"></CustomLabel>
                            <ValidationMessage For="@(() => _ProductService.addProduct.Brand)" class="validate" />
                            <InputText id="product-brand" @bind-Value="_ProductService.addProduct.Brand" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>

                        
                     
                    </div>
                  
                    <div class="row">
                        <CustomLabel  For="@(() => _ProductService.addProduct.ShortDescription)"></CustomLabel>
                        <TextEditor @bind-Value="_ProductService.addProduct.ShortDescription" />
                    </div>
                    <div class="row">
                        <CustomLabel  For="@(() => _ProductService.addProduct.Description)"></CustomLabel>
                        <TextEditor @bind-Value="_ProductService.addProduct.Description" />
                    </div>
                </div>
                
                <!-- Pricing card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 p-6 border border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-6 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary-600 after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary-600 after:rounded-lg">قیمت‌گذاری و موجودی</h3>
                 
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                   
                        <div>
                            <CustomLabel  For="@(() => _ProductService.addProduct.Price)"></CustomLabel>(تومان)
                            <ValidationMessage For="@(() => _ProductService.addProduct.Price)" class="validate" />
                            <InputNumber id="product-price" @bind-Value="_ProductService.addProduct.Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel  For="@(() => _ProductService.addProduct.Discount)"></CustomLabel>(تومان)
                            <ValidationMessage For="@(() => _ProductService.addProduct.Discount)" class="validate" />
                            <InputNumber id="product-discount" @bind-Value="_ProductService.addProduct.Discount" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel  For="@(() => _ProductService.addProduct.Count)"></CustomLabel>
                            <ValidationMessage For="@(() => _ProductService.addProduct.Count)" class="validate" />
                            <InputNumber id="product-stock" @bind-Value="_ProductService.addProduct.Count" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel  For="@(() => _ProductService.addProduct.SkuCode)"></CustomLabel>
                            <ValidationMessage For="@(() => _ProductService.addProduct.SkuCode)" class="validate" />
                            <InputText id="product-sku" @bind-Value="_ProductService.addProduct.SkuCode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div class="mb-4">
                            <CustomLabel  For="@(() => _ProductService.addProduct.ProductExistStatus)"></CustomLabel>

                            <InputRadioGroup @bind-Value="_ProductService.addProduct.ProductExistStatus" Name="stock-status">
                                <div class="flex flex-row items-center space-x-6">

                                    <div class="flex items-center">
                                        <InputRadio Value="@Dto.Enum.EnumConstant.ProductExistStatus.Existent"
                                                    id="in-stock"
                                                    class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                        <label for="in-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">موجود</label>
                                    </div>

                                    <div class="flex items-center">
                                        <InputRadio Value="@Dto.Enum.EnumConstant.ProductExistStatus.Nonexistent"
                                                    id="out-of-stock"
                                                    class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                        <label for="out-of-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">ناموجود</label>
                                    </div>

                                </div>
                            </InputRadioGroup>

                            <ValidationMessage For="@(() => _ProductService.addProduct.ProductExistStatus)" class="validate" />
                        </div>

                        <div class="mb-4">
                            <CustomLabel ForId="Visible-stock" For="@(() => _ProductService.addProduct.Visible)"></CustomLabel>
                            <InputRadioGroup @bind-Value="_ProductService.addProduct.Visible" Name="status">
                                <InsertUpdateVisible />
                            </InputRadioGroup>
                            <ValidationMessage For="@(() => _ProductService.addProduct.Visible)" class="validate" />
                        </div>
                    </div>

                   
                </div>

                <SaveButton Disabled="@isSubmitting" />
            </div>

            <!-- Right column - Publish and attributes -->
            <div class="space-y-6">

                <!-- Attributes card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 p-6 border border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-6 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary-600 after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary-600 after:rounded-lg">ویژگی‌های محصول</h3>
                    <div class="space-y-4">
                        
                        @if (_ProductFeatureService.AddProductFeatureValues.Count > 0)
                        {
                            int i = -1;
                            @foreach (var item in _ProductFeatureService.AddProductFeatureValues)
                            {
                                i++;
                                int k = i;
                                <div>
                                    <label for="product-weight" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">@_ProductFeatureService.AddProductFeatureValues[k].ResultProductFeature.Title</label>

                                    <ValidationMessage For="@(() => _ProductFeatureService.AddProductFeatureValues[k].Value)" class="validate" />
                                    <InputText id="product-sku" @bind-Value="_ProductFeatureService.AddProductFeatureValues[k].Value" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                                </div>
                            }
                        }
                    </div>

                </div>

            </div>
        </div>
    </EditForm>
</main>
@code {
    private bool isSubmitting = false;
    protected override async Task OnInitializedAsync()
    {
        await _CategoryService.GetAllDataAsync();
        if (_CategoryService.ResultCategorys1.Count > 0)
        {
            _CategoryService.addCategory.ParentID1 = _CategoryService.ResultCategorys1[0].ID;
            _CategoryService.GetCategoryParent2InAdd();
            if (_CategoryService.ResultCategorys2.Count > 0)
            {
                _CategoryService.addCategory.ParentID2 = _ProductFeatureService.CategoryID = _CategoryService.ResultCategorys2[0].ID;

                _CategoryService.GetCategoryParent3InAdd();
                if (_CategoryService.ResultCategorys3.Count > 0)
                {
                    _ProductService.addProduct.CategoryID = _CategoryService.ResultCategorys3[0].ID;
                }
                else
                {
                    _ProductService.CategoryID = null;
                }
            }
            else
            {
                _CategoryService.addCategory.ParentID2 = null;
            }
        }
        else
        {
            _CategoryService.addCategory.ParentID1 = null;
        }

        _ProductService.AddProductFeatureValues= await _ProductFeatureService.GetAllDataAsync();

    }
    
    private async Task GetCategoryParent2InAdd()
    {
        _CategoryService.GetCategoryParent2InAdd();
        if (_CategoryService.ResultCategorys2.Count > 0)
        {
            _CategoryService.addCategory.ParentID2 = _ProductFeatureService.CategoryID = _CategoryService.ResultCategorys2[0].ID;

        }
        else
        {
            _CategoryService.addCategory.ParentID2 = _ProductFeatureService.CategoryID = null;
        }
        GetCategoryParent3InAdd2();
        _ProductService.AddProductFeatureValues = await _ProductFeatureService.GetAllDataAsync();


    }
    private async Task GetCategoryParent3InAdd()
    {
        _ProductFeatureService.CategoryID = _CategoryService.addCategory.ParentID2;
        _ProductService.AddProductFeatureValues = await _ProductFeatureService.GetAllDataAsync();

        GetCategoryParent3InAdd2();


    }
    private async Task GetCategoryParent3InAdd2()
    {
        _CategoryService.GetCategoryParent3InAdd();
        if (_CategoryService.ResultCategorys3.Count > 0)
        {
            _ProductService.CategoryID = _CategoryService.ResultCategorys3[0].ID;
        }
        else
        {
            _ProductService.CategoryID = null;
        }
        await _ProductService.GetDataAsync();
    }
    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
           

            await _ProductService.AddAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

