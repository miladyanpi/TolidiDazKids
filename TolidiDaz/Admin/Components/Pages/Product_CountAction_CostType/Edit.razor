@code {
    private UpdateProduct_CountAction_CostType? updateProduct_CountAction_CostType { get; set; } = new() { Visible = true };
    [SupplyParameterFromQuery]
    public int ID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await GetData();
    }

    private async Task Update()
    {
        var resdata = await RootApiUpdateProduct_CountAction_CostType.RunMethodApi("Product_CountAction_CostTypes", updateProduct_CountAction_CostType, method: Method.Patch);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateProduct_CountAction_CostType.RunMethodApi($"Product_CountAction_CostTypes/{ID}", null, method: Method.Get);
        updateProduct_CountAction_CostType = resdataEdit.Entity;
        Console.WriteLine(updateProduct_CountAction_CostType.ProductID);


    }
    private void GoBack()
    {
        var parameter = new Dictionary<string, object>
        {
            {"PositionID", updateProduct_CountAction_CostType.PositionID.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Product_CountAction_CostType", parameter!), forceLoad: true);
    }

}

