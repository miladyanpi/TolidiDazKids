@* @page "/InsertProduct_CountAction_CostType"
@using Admin.Services.Category
@using Dto.Models.DtoProduct_CountAction_CostType
@using static Dto.Enum.EnumConstant

@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<AddProduct_CountAction_CostType>> RootApiAddProduct_CountAction_CostType
@inject CategoryService _CategoryService


@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن هزینه براساس محصول جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات هزینه براساس محصول جدید را وارد نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add Product_CountAction_CostType form -->
    <EditForm Model="addProduct_CountAction_CostType" OnValidSubmit="Add" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات هزینه براساس محصول
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Product_CountAction_CostType Info -->
                <div class="space-y-4">
            
                    <div>
                        <CustomLabel ForId="ProductFeature-category1" For="@(() => _CategoryService.addCategory.ParentID1)"></CustomLabel>
                        <InputSelect @bind-Value="_CategoryService.addCategory.ParentID1" @bind-Value:after="@( async ()=>await  _CategoryService.GetCategoryParent1(_CategoryService.addCategory.ParentID1))" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _CategoryService.ResultCategorys1)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="ProductFeature-category2" For="@(() => _CategoryService.addCategory.ParentID2)"></CustomLabel>
                        <InputSelect @bind-Value="_CategoryService.addCategory.ParentID2" @bind-Value:after="@( async ()=>await  _CategoryService.GetCategoryParent2(_CategoryService.addCategory.ParentID2))" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _CategoryService.ResultCategorys2)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="ProductFeature-category3" For="@(() => _CategoryService.CategoryID)"></CustomLabel>
                        <InputSelect @bind-Value="_CategoryService.CategoryID" @bind-Value:after="@(async ()=>await  _CategoryService.GetProducts())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _CategoryService.ResultCategorys3)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="Product_CountAction_CostType-ProductID" For="@(() => addProduct_CountAction_CostType.ProductID)"></CustomLabel>
                        <ValidationMessage For="@(() => addProduct_CountAction_CostType.ProductID)" class="validate" />
                        <InputSelect @bind-Value="addProduct_CountAction_CostType.ProductID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _CategoryService.ResultProducts)
                            {
                                <option value="@item.ID">@item.Title (item.ProductCode)</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="Product_CountAction_CostType-Amount" For="@(() => addProduct_CountAction_CostType.CountAction)"></CustomLabel>
                        <ValidationMessage For="@(() => addProduct_CountAction_CostType.CountAction)" class="validate" />
                        <InputNumber @bind-Value="addProduct_CountAction_CostType.CountAction" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Product_CountAction_CostType-Price" For="@(() => addProduct_CountAction_CostType.Price)"></CustomLabel>
                        <ValidationMessage For="@(() => addProduct_CountAction_CostType.Price)" class="validate" />
                        <InputNumber  @bind-Value="addProduct_CountAction_CostType.Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                   
                </div>
                <!-- Settings -->
                <div class="space-y-4">
          
                    <div>
                        <CustomLabel ForId="Product_CountAction_CostType-Description" For="@(() => addProduct_CountAction_CostType.Description)"></CustomLabel>
                        <ValidationMessage For="@(() => addProduct_CountAction_CostType.Description)" class="validate" />
                        <InputTextArea @bind-Value="addProduct_CountAction_CostType.Description" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div> 
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {
    private AddProduct_CountAction_CostType? addProduct_CountAction_CostType { get; set; } = new() { Visible = true};
    [SupplyParameterFromQuery]
    public int PositionID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await _CategoryService.GetInitialData();
        addProduct_CountAction_CostType.ProductID = _CategoryService.ResultProducts.Count > 0 ? _CategoryService.ResultProducts[0].ID : null;
    }
    private async Task Add()
    {
        addProduct_CountAction_CostType.PositionID = PositionID;
        var resdata = await RootApiAddProduct_CountAction_CostType.RunMethodApi("Product_CountAction_CostTypes", addProduct_CountAction_CostType, method: Method.Post);
        if (resdata.Status == ResultMessageApi.Success)
        {

            await JS.CallAlertToast(resdata.Message);
            addProduct_CountAction_CostType = new AddProduct_CountAction_CostType
            {
                Visible=true
            };
           
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }
    }
    private void GoBack()
    {
        var parameter = new Dictionary<string, object>
        {
            {"PositionID", PositionID.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Product_CountAction_CostType", parameter!), forceLoad: true);
    }
}

 *@