@page "/UpdateTicket"
@using Dto.Models.DtoAccount
@using Dto.Models.DtoTicket
@using Dto.Models.DtoDepartment
@using Dto.Models.DtoLable
@using Dto.Models.DtoUploadFile
@using System.Net.Http.Headers
@using Newtonsoft.Json
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<UpdateTicket>> RootApiUpdateTicket
@inject IRootApi<ResponseApiEntities<ResultDepartment>> RootApiResultDepartments
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش اطلاعات بلاگ</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات بلاگ را ویرایش نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add category form -->
    <EditForm Model="updateTicket" OnValidSubmit="Update" FormName="UpdateForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم بلاگ
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Ticket Info -->
                <div class="space-y-4">

                    <div>
                        <CustomLabel ForId="category-parent" For="@(() => updateTicket.DepartmentID)"></CustomLabel>
                        <ValidationMessage For="@(() => updateTicket.DepartmentID)" class="validate" />
                        <InputSelect @bind-Value="updateTicket.DepartmentID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in ResultDepartments)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>

                    </div>
                    
                    <div>
                        <CustomLabel ForId="Ticket-Title" For="@(() => updateTicket.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => updateTicket.Title)" class="validate" />
                        <InputText id="Ticket-Title" @bind-Value="updateTicket.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    
                   

                </div>


                <!-- Settings -->
                <div class="space-y-4">

                    <div>
                        <CustomLabel ForId="Ticket-description" For="@(() => updateTicket.Description)"></CustomLabel>
                        @* <InputTextArea @bind-Value="updateTicket.Description" rows="10" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" /> *@
                        <TextEditor @bind-Value="updateTicket.Description" />
                    </div>
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => updateTicket.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="updateTicket.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => updateTicket.Visible)" class="validate" />
                    </div>

                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {

    private UpdateTicket? updateTicket { get; set; } = new() { Visible = true };
    private List<ResultDepartment>? ResultDepartments { get; set; } = new List<ResultDepartment>();

    [SupplyParameterFromQuery]
    public int ID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await GetData();

    }
    private async Task Update()
    {
        var resdata = await RootApiUpdateTicket.RunMethodApi("Tickets", updateTicket, method: Method.Patch);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateTicket.RunMethodApi($"Tickets/{ID}", null, method: Method.Get);
        if (resdataEdit != null && resdataEdit.Status==ResultMessageApi.Success)
        {
            updateTicket = resdataEdit.Entity;

        }

        var resdata = await RootApiResultDepartments.RunMethodApi($"Departments/All", null, method: Method.Get);
        if (resdata != null && resdata.Status==ResultMessageApi.Success)
        {
            ResultDepartments = resdata.Entities.ToList();
            if (updateTicket.DepartmentID == null)
                updateTicket.DepartmentID = ResultDepartments.Count > 0 ? ResultDepartments[0].ID : null;
        }


    }
    private void GoBack()
    {
        NavManager.NavigateTo("/Ticket");
    }
  
}

