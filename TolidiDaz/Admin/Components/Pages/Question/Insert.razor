@page "/InsertQuestion"
@using Dto.Models.DtoQuestion
@using Dto.Models.DtoGroupQuestion
@using Dto.Models.DtoLable

@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<AddQuestion>> RootApiAddQuestion
@inject IRootApi<ResponseApiEntities<ResultGroupQuestion>> RootApiResultGroupQuestions

@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن بلاگ جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات بلاگ جدید را وارد نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>
    <!-- Add category form -->
    <EditForm Model="addQuestion" OnValidSubmit="Add" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات بلاگ
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="category-parent" For="@(() => addQuestion.GroupQuestionID)"></CustomLabel>
                        <ValidationMessage For="@(() => addQuestion.GroupQuestionID)" class="validate" />
                        <InputSelect @bind-Value="addQuestion.GroupQuestionID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in ResultGroupQuestions)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>

                    </div>
                    
                    <div>
                        <CustomLabel ForId="Question-Title" For="@(() => addQuestion.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => addQuestion.Title)" class="validate" />
                        <InputText id="Question-Title" @bind-Value="addQuestion.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Question-StudyDuration" For="@(() => addQuestion.SubTitle)"></CustomLabel>
                        <ValidationMessage For="@(() => addQuestion.SubTitle)" class="validate" />
                        <InputText @bind-Value="addQuestion.SubTitle" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    
      
                </div>


                <!-- Settings -->
                <div class="space-y-4">

                    <div>
                        <CustomLabel ForId="Question-description" For="@(() => addQuestion.Description)"></CustomLabel>
                        <TextEditor @bind-Value="addQuestion.Description" />
                    </div>
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => addQuestion.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="addQuestion.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => addQuestion.Visible)" class="validate" />
                    </div>

                </div>

            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {
    private AddQuestion? addQuestion { get; set; } = new() { Visible = true };
    private List<ResultGroupQuestion>? ResultGroupQuestions { get; set; } = new List<ResultGroupQuestion>();
    protected async override Task OnInitializedAsync()
    {
        var resdata = await RootApiResultGroupQuestions.RunMethodApi($"GroupQuestions/All", null, method: Method.Get);
        if (resdata!=null && resdata.Status==ResultMessageApi.Success)
        {
            ResultGroupQuestions = resdata.Entities.ToList();
            addQuestion.GroupQuestionID = ResultGroupQuestions.Count > 0 ? ResultGroupQuestions[0].ID : null;
        }
        
    }
    private async Task Add()
    {
        
        var resdata = await RootApiAddQuestion.RunMethodApi("Questions", addQuestion, method: Method.Post);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);
            
            addQuestion = new AddQuestion
            {
                Visible = true
            };
           
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    private void GoBack()
    {
        NavManager.NavigateTo("/Question");
    }
    
}

