@page "/ShowProductComment/{guid}"
@using Dto.Models.DtoProductComment
@using Dto.Models.DtoLable
@using Newtonsoft.Json
@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<ResultProductComment>> RootApiresultProductComment
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">نمایش نظر کاربر(@resultProductComment.AuthorName)/محصول</h2>
            <p class="text-gray-600 dark:text-gray-400">نظر کاربر</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>


    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 border-b border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                فرم بلاگ
            </h3>
        </div>

        <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- ProductComment Info -->
            <div class="space-y-4">

                <div>
                    <CustomLabel For="@(() => resultProductComment.AuthorName)"></CustomLabel>
                    <InputText readonly @bind-Value="resultProductComment.AuthorName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div>
                    <CustomLabel For="@(() => resultProductComment.Rating)"></CustomLabel>
                    <InputNumber readonly @bind-Value="resultProductComment.Rating" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div>
                    <CustomLabel For="@(() => resultProductComment.IsVerifiedBuyer)"></CustomLabel>
                    <span>@((MarkupString)resultProductComment.IsVerifiedBuyer)</span>
                </div>
                

            </div>
            <!-- Settings -->
            <div class="space-y-4">
                <div>
                    <CustomLabel For="@(() => resultProductComment.LikeCount)"></CustomLabel>
                    <InputNumber readonly @bind-Value="resultProductComment.LikeCount" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>

                <div>
                    <CustomLabel For="@(() => resultProductComment.DislikeCount)"></CustomLabel>
                    <InputNumber readonly @bind-Value="resultProductComment.DislikeCount" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div>
                    <CustomLabel For="@(() => resultProductComment.Body)"></CustomLabel>
                    <InputTextArea rows="10" @bind-Value="resultProductComment.Body" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white outline-0" />
                </div>

            </div>
        </div>

    </div>

</main>
@code {

    private ResultProductComment? resultProductComment { get; set; } = new();
    [Parameter]
    public string? guid { get; set; }
    protected async override Task OnInitializedAsync()
    {
        bool isValid = Guid.TryParse(guid, out Guid gid);
        if (isValid)
        {
            await GetData(gid);
        }

    }

    public async Task GetData(Guid gid)
    {
        var resdataEdit = await RootApiresultProductComment.RunMethodApi($"ProductComments/ByGuid/{gid}", null, method: Method.Get);
        if (resdataEdit != null && resdataEdit.Status == ResultMessageApi.Success)
        {
            resultProductComment = resdataEdit.Entity;

        }
    }
    private void GoBack()
    {
        NavManager.NavigateTo("/ProductComment");
    }

}

