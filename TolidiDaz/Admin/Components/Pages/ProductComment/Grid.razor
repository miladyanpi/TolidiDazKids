@page "/ProductComment"
@using Dto.Models.DtoProductComment
@using Dto.Models.DtoProduct
@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<ResultProduct>> RootApiGetResultProduct
@inject IRootApi<ResponseApiEntities<ResultProductComment>> RootApiGet
@inject IRootApi<ResponseApiEntities<ResultProduct>> RootApiResultProducts
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت نظرات کاربران/محصولات</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست نظرات کاربران برای محصول <span class="text-danger bold">@resultProduct.Title</span></p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Users list -->
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 pb-2 border-b border-gray-200 flex-wrap dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                لیست نظرات کاربران
            </h3>
            <Search OnClickcallBack="@GetData" PlaceHolder="جستجو..." />
        </div>

        <!-- Users table -->
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">#</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.AuthorName)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.ResultProduct)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.Rating)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.IsVerifiedBuyer)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.Status)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.LikeCount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.DislikeCount)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.RegisterDate)"></CustomLabel></th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><CustomLabel For="@(() => resultProductComment.RegisterTime)"></CustomLabel></th>

                        <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">عملیات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    <!-- User 1 -->
                    @{
                        decimal i = (pagingModel.Page - 1) * pagingModel.Take;

                    }
                    @foreach (var item in ResultProductComments)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@k</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.AuthorName</td>

                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@item.ResultProduct.Title</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Rating</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@((MarkupString)item.IsVerifiedBuyer)</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                @((MarkupString)item.Status)
                                @if (item.Status2 == EnumConstant.CommentStatus.Pending)
                                {
                                    <button @onclick="@(() => SetStatusMessage(item.ID, EnumConstant.CommentStatus.Approved))"
                                            title="تایید پیام"
                                            class="text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>
                                    <button @onclick="@(() => SetStatusMessage(item.ID, EnumConstant.CommentStatus.Rejected))"
                                            title="رد پیام"
                                            class="text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.5"
                                             stroke="currentColor"
                                             class="size-6">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M9.75 9.75 14.25 14.25M14.25 9.75 9.75 14.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>

                                }
                                else if (item.Status2 == EnumConstant.CommentStatus.Approved)
                                {

                                    <button @onclick="@(() => SetStatusMessage(item.ID, EnumConstant.CommentStatus.Rejected))"
                                            title="رد پیام"
                                            class="text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.5"
                                             stroke="currentColor"
                                             class="size-6">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M9.75 9.75 14.25 14.25M14.25 9.75 9.75 14.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>

                                }

                                else if (item.Status2 == EnumConstant.CommentStatus.Rejected)
                                {
                                    <button @onclick="@(() => SetStatusMessage(item.ID, EnumConstant.CommentStatus.Approved))"
                                            title="تایید پیام"
                                            class="text-green-600 hover:text-green-700 dark:text-green-400 dark:hover:text-green-300 ml-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                    </button>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.LikeCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.DislikeCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.RegisterDate</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.RegisterTime</td>

                         
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">

                               
                                <button @onclick="@(() => GoToShowProductComment(item.IdentityCode))" title="نمایش پیام" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 ml-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954 5.485a2.25 2.25 0 0 0 2.292 0L22.5 12" />
                                    </svg>
                                </button>
                                <button @onclick="@(async () => await Delete(item.ID))" title="حذف" class="text-secondary-600 hover:text-secondary-900 dark:text-secondary-50 dark:hover:text-secondary-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                </button>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <Pagination pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />
    </div>
</main>

@code {
    private EnumComponentName.ComponentNameType ComponentNameType { get; set; } = EnumComponentName.ComponentNameType.Insert;
    private PagingModel pagingModel { get; set; } = new();
    private ResultProductComment resultProductComment { get; set; } = new();
    private ResultProduct? resultProduct { get; set; } = new();
    private List<ResultProductComment>? ResultProductComments { get; set; } = new List<ResultProductComment>();
    private List<ResultProduct>? ResultProducts { get; set; } = new List<ResultProduct>();

    [SupplyParameterFromQuery]
    public int ProductID { get; set; }

    protected async override Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = BaseCode.GetCountShowRecord();
        var resdata = await RootApiGetResultProduct.RunMethodApi($"Products/{ProductID}", null, method: Method.Get);
        if (resdata != null && resdata.Status == ResultMessageApi.Success)
        {
            resultProduct = resdata.Entity;
        }
        await GetData();
    }

    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;

        await GetData();
    }

    private async Task GetData(string? SearchText = "")
    {
        var Search = BaseCode.GetSearchText(SearchText);
        var resdata = await RootApiGet.RunMethodApi($"ProductComments?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&ProductID={ProductID}", null, method: Method.Get);
        decimal Count = resdata.CountAllRecordTable;
        ResultProductComments = resdata.Entities.ToList();
        pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
        pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
    }

    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {
            var resdata = await RootApiGet.RunMethodApi($"ProductComments/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {

                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }
    private async Task SetStatusMessage(int ID, EnumConstant.CommentStatus commentStatus)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "پیام ارسالی کاربر مورد تایید است؟",
            Text = "درصورت تایید شما، پیام کاربر دربخش بلاگ های صفحه عمومی نمایش داده خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {
            var resdata = await RootApiGet.RunMethodApi($"ProductComments/SetStatus?Id={ID}&commentStatus={commentStatus}", null, method: Method.Get);
            if (resdata.Status == ResultMessageApi.Success)
            {

                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }


    private void GoBack()
    {
        NavManager.NavigateTo("/Product");
    }

    private void GoToShowProductComment(Guid? guid)
    {

        NavManager.NavigateTo($"/ShowProductComment/{guid}");
    }


}