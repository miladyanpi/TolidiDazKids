@page "/InsertProductVariant"
@using Admin.Services.ProductVariant
@inject ProductVariantService _ProductVariantService
<AccessAdminRoles />
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن مقادیر ویژگی جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات مقادیر ویژگی جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="ProductVariant" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_ProductVariantService.addProductVariant" OnValidSubmit="HandleSubmitAsync" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات مقادیر ویژگی
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                     <div>
                        <CustomLabel ForId="category-parent" For="@(() => _ProductVariantService.addProductVariant.ProductID)"></CustomLabel>
                        <ValidationMessage For="@(() =>_ProductVariantService.addProductVariant.ProductID)" class="validate" />
                        <InputSelect @bind-Value=" _ProductVariantService.addProductVariant.ProductID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in _ProductVariantService.ResultProductVariants)
                            {
                                <option value="@item.ID">@item.SkuCode</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="ProductVariant-Title" For="@(() => _ProductVariantService.addProductVariant.Count)"></CustomLabel>
                        <ValidationMessage For="@(() => _ProductVariantService.addProductVariant.Count)" class="validate" />
                        <InputNumber id="ProductVariant-Title" @bind-Value="_ProductVariantService.addProductVariant.Count" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                     <div>
                        <CustomLabel ForId="ProductVariant-Title" For="@(() => _ProductVariantService.addProductVariant.Price)"></CustomLabel>
                        <ValidationMessage For="@(() => _ProductVariantService.addProductVariant.Price)" class="validate" />
                        <InputNumber id="ProductVariant-Title" @bind-Value="_ProductVariantService.addProductVariant.Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div>
                <!-- Settings -->
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _ProductVariantService.addProductVariant.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_ProductVariantService.addProductVariant.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _ProductVariantService.addProductVariant.Visible)" class="validate" />
                    </div>
                </div>
            </div>
            <SaveButton Disabled="@isSubmitting"/>
    </EditForm>
</main>
@code {
    private bool isSubmitting = false;

    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
           

            await _ProductVariantService.AddAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}



