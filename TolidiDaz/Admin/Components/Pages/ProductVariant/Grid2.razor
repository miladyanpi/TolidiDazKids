@code {
    [Parameter] public string? ProductGuid { get; set; }

    private List<ResultProductVariant>? ResultProductVariants;
    private ResultProduct? _model;
    private List<VariantRowDto> _rows = new();
    private List<ExistingVariantDto> _toArchive = new();
    private long _defaultPrice;
    private int _defaultStock;
    private bool isSubmitting;
    private string? _error;
    private string _toast = "";
    private string _toastClass = "";
    private int i;
    private void Edit()
    {
        NavManager.NavigateTo($"/Products/Edit/{_model.ID}");
    }
    protected override async Task OnInitializedAsync()
    {
        await _TraitService.GetAllDataAsync();
        ResultProductVariants = await _ProductVariantService.GetAllDataAsync(ProductGuid);
         _model=  await _ProductService.GetUpdateDataAsync(ProductGuid);
        if (_model is null) { _error = "محصول یافت نشد."; return; }
        if (_model.PricingType2 != PricingType.VariantBase) return;
        if (_model.CategoryID is null) { _error = "ابتدا دسته محصول را تعیین کنید."; return; }

        // مقادیری که واریانت فعالِ موجود دارند → از قبل تیک بخورند
        var activeValueIds = ResultProductVariants
            .Where(v => !v.IsArchived)
          //  .SelectMany(v => v.TraitValueIds)
            .ToHashSet();

        foreach (var trait in _model.Traits)
            foreach (var val in trait.Values)
                val.Checked = activeValueIds.Contains(val.ID);

        RebuildRows();
    }

    // ───────── ساخت ترکیب‌های کارتزینی ─────────
    private void RebuildRows()
    {
        var previous = _rows.ToDictionary(r => r.Signature, r => r);
        var existingBySig = _model!.ExistingVariants.ToDictionary(v => v.Signature, v => v);

        var groups = _model.Traits
            .OrderBy(t => t.ID)
            .Select(t => t.Values.Where(v => v.Checked).ToList())
            .Where(g => g.Count > 0)
            .ToList();

        var combos = new List<List<TraitValueSelect>>();
        if (groups.Count > 0)
        {
            IEnumerable<List<TraitValueSelect>> acc =
                groups[0].Select(v => new List<TraitValueSelect> { v });
            for (var gi = 1; gi < groups.Count; gi++)
            {
                var g = groups[gi];
                acc = acc.SelectMany(prefix => g.Select(v =>
                {
                    var l = new List<TraitValueSelect>(prefix) { v };
                    return l;
                }));
            }
            combos = acc.ToList();
        }

        var rows = new List<VariantRowDto>();
        foreach (var combo in combos)
        {
            var sig = BuildSignature(combo);
            if (previous.TryGetValue(sig, out var old))
            {
                rows.Add(old);                       // ویرایش‌های ادمین حفظ می‌شود
                continue;
            }

            if (existingBySig.TryGetValue(sig, out var ex))
            {
                rows.Add(new VariantRowDto           // رکورد موجود — SKU ثبت‌شده ملاک است
                {
                    Signature = sig, VariantId = ex.Id, DbSku = ex.SkuCode,
                    ExistsInDb = true, WasArchived = ex.IsArchived,
                    Chips = combo, SkuPreview = ex.SkuCode,
                    Price = ex.Price, Stock = ex.Stock
                });
            }
            else
            {
                rows.Add(new VariantRowDto           // ترکیب تازه
                {
                    Signature = sig, Chips = combo,
                    SkuPreview = BuildSkuPreview(combo),
                    Price = _defaultPrice, Stock = _defaultStock
                });
            }
        }
        _rows = rows;

        // چه واریانت‌های فعالی آرشیو خواهند شد؟
        var keepSigs = rows.Select(r => r.Signature).ToHashSet();
        _toArchive = _model.ExistingVariants
            .Where(v => !v.IsArchived && !keepSigs.Contains(v.Signature))
            .ToList();
    }

    private string BuildSignature(List<TraitValueSelect> combo) =>
        string.Join("|", combo.OrderBy(v => v.TraitID).Select(v => v.ID));

    private string? BuildSkuPreview(List<TraitValueSelect> combo)
    {
        if (string.IsNullOrWhiteSpace(_model!.ProductCode)) return null;
        var codes = combo.OrderBy(v => v.TraitID).Select(v => v.Code).ToList();
        if (codes.Any(string.IsNullOrWhiteSpace)) return null;
        return $"{_model.ProductCode.ToUpperInvariant()}-{string.Join("-", codes)}";
    }

    // ───────── اکشن‌های UI ─────────
    private void ToggleAllValues(ResultTrait trait, bool state)
    {
        trait.ResultTraitValues.ForEach(v => v.Checked = state);
        RebuildRows();
    }

    private void ExcludeCombo(string signature)
    {
        // حذف فقط یک ترکیب: مقادیرش را از حالت «تنها انتخاب» درمی‌آوریم
        var row = _rows.First(r => r.Signature == signature);
        foreach (var chip in row.Chips)
        {
            var trait = _model!.Traits.First(t => t.ID == chip.TraitID);
            var others = trait.Values.Count(v => v.Checked && v.ID != chip.ID);
            if (others == 0) chip.Checked = false;   // تنها عضو گروه بود → بردار
        }
        RebuildRows();
    }

    private void ApplyDefaultsToAll()
    {
        foreach (var r in _rows.Where(r => !r.ExistsInDb))
        {
            r.Price = _defaultPrice; r.PriceTouched = true;
            r.Stock  = _defaultStock; r.StockTouched = true;
        }
    }

    private bool _modelExists(VariantRowDto r) => r.ExistsInDb;

    private string RowClass(VariantRowDto r) => r.Status switch
    {
        "جدید"    => "row-new",
        "بازفعال" => "row-restored",
        _         => ""
    };

    private string StatusBadge(string s) => s switch
    {
        "جدید"    => "bg-success",
        "بازفعال" => "bg-info text-dark",
        _         => "bg-secondary"
    };

    // ───────── ذخیره ─────────
    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        var invalid = _rows.Where(r => r.SkuPreview is null).ToList();
        if (invalid.Any())
        {
            ShowToast("⚠ برخی ترکیب‌ها Code ندارند؛ ابتدا TraitValueها را کامل کنید.", "toast-error");
            return;
        }
        if (_rows.Any(r => r.Price <= 0))
        {
            ShowToast("⚠ قیمت همه ردیف‌ها باید بزرگ‌تر از صفر باشد.", "toast-error");
            return;
        }

        try
        {
            isSubmitting = true;
            var (added, restored, archived) =
                await _MatrixService.SaveMatrixAsync(ProductId, _rows);

            ShowToast($"✅ ذخیره شد — جدید: {added} | بازفعال: {restored} | آرشیو: {archived}", "toast-success");
            _model = await _MatrixService.LoadAsync(ProductId);   // بازخوانی برای حالت تازه
            OnInitializedSync();
        }
        catch (DomainException ex)
        {
            ShowToast($"⛔ {ex.Message}", "toast-error");
        }
        finally { isSubmitting = false; }
    }

    private void OnInitializedSync() { /* بازتیک مقادیر فعال مثل OnInitializedAsync */ }

    private async Task ShowToast(string msg, string cls)
    {
        _toast = msg; _toastClass = cls + " show";
        StateHasChanged();
        await Task.Delay(4000);
        _toastClass = "";
        StateHasChanged();
    }
} *@