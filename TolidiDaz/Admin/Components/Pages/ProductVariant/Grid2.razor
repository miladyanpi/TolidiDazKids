                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    @{
                        decimal i = (_ProductVariantService.pagingModel.Page - 1) * _ProductVariantService.pagingModel.Take;
                    }
                    @foreach (var item in _ProductVariantService.ResultProductVariants)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@k</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Price</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.ResultProduct.Title</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">@item.Stock</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <Visible Value="@item.Visible" />
                            </td>
