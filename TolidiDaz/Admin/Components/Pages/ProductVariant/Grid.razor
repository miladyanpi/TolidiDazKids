@page "/ProductVariant/{ProductGuid}"
@using Admin.Services.Product
@using Admin.Services.ProductVariant
@using Admin.Services.Trait
@using Dto.Models.DtoProduct
@using Dto.Models.DtoProductVariant
@using Dto.Models.DtoTrait
@using Dto.Models.DtoTraitValue
@using static Dto.Enum.EnumConstant

@inject ProductVariantService _ProductVariantService
@inject ProductService _ProductService
@inject TraitService _TraitService
@inject NavigationManager NavManager

<div class="container pb-5" style="overflow:scroll">

    @* ═══════════════ هدر ═══════════════ *@
    <header class="mb-4">
        <div class="header-title">
            <h2>
                <span class="icon-box"><i class="fa-solid fa-layer-group"></i></span>
                ماتریس تولید واریانت‌ها
            </h2>
            @if (_model is not null)
            {
                <p class="mt-2">
                    <strong>@_model.Title</strong>
                    @if (_model.ResultCategory is not null)
                    {
                        <span class="badge bg-secondary me-1">@_model.ResultCategory.Title</span>
                    }
                    <span class="badge bg-info text-dark">کد: @(_model.ProductCode ?? "— تعیین نشده —")</span>
                </p>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger shadow-sm">@_error</div>
    }
    else if (_model is not null && _model.PricingType != (int)PricingType.VariantBase)
    {
        <div class="alert alert-warning shadow-sm">
            این محصول «ساده» است. برای استفاده از ماتریس واریانت، ابتدا نوع قیمت‌گذاری را در ویرایش محصول روی VariantBased قرار دهید.
        </div>
    }
    else if (_model is not null)
    {
        @* هشدار ProductCode — پیش‌نیاز SKU *@
        @if (string.IsNullOrWhiteSpace(_model.ProductCode))
        {
            <div class="alert alert-warning shadow-sm">
                ⚠ این محصول <strong>ProductCode</strong> ندارد؛ تولید SKU خودکار متوقف می‌شود. ابتدا کد محصول را در فرم ویرایش محصول تکمیل فرمایید.
            </div>
        }

        @* ═══════════════ گام ۱: انتخاب مقادیر ویژگی‌ها ═══════════════ *@
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <strong><i class="fa-solid fa-tags text-primary"></i> گام ۱ — انتخاب مقادیر ویژگی‌ها</strong>
                <span class="text-muted" style="font-size:12px">
                    منبع: ویژگی‌های متصل به محصول
                </span>
            </div>
            <div class="card-body">
                @if (ResultTraits is null || ResultTraits.Count == 0)
                {
                    <div class="text-muted text-center py-3">هیچ ویژگی‌ای (Trait) برای این محصول یا دسته‌بندی یافت نشد.</div>
                }
                else
                {
                    @foreach (var trait in ResultTraits)
                    {
                        <div class="trait-row mb-3 p-3 bg-light rounded">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-dark">@trait.Title</strong>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary btn-xs"
                                            @onclick="() => ToggleAllValues(trait, true)">
                                        انتخاب همه
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-xs"
                                            @onclick="() => ToggleAllValues(trait, false)">
                                        پاک کردن
                                    </button>
                                </div>
                            </div>

                            <div class="chip-wrap d-flex flex-wrap gap-2">
                                @foreach (var val in trait.ResultTraitValues)
                                {
                                    var v = val; // Capture for lambda
                                    <label class="chip d-inline-flex align-items-center gap-1 p-2 border rounded cursor-pointer @(v.Checked ? "bg-primary text-white" : "bg-white")">
                                        <input type="checkbox" @bind="v.Checked" @bind:after="RebuildRows" class="form-check-input me-1" />
                                        @if (trait.DisplayType2 == (int)TraitDisplayType.Color && !string.IsNullOrEmpty(v.DisplayColorHex))
                                        {
                                            <span class="color-dot rounded-circle d-inline-block border" style="background:@v.DisplayColorHex; width:14px; height:14px;"></span>
                                        }
                                        <span>@v.Value</span>
                                        @if (string.IsNullOrWhiteSpace(v.Code))
                                        {
                                            <span class="text-warning fw-bold" title="این مقدار Code ندارد و در SKU نمی‌نشیند">⚠</span>
                                        }
                                        else
                                        {
                                            <code class="chip-code @(v.Checked ? "text-white-50" : "text-muted")">@v.Code</code>
                                        }
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ═══════════════ گام ۲: پیش‌فرض‌ها ═══════════════ *@
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white py-3"><strong><i class="fa-solid fa-sliders text-primary"></i> گام ۲ — مقادیر پیش‌فرض</strong></div>
            <div class="card-body d-flex gap-3 align-items-end flex-wrap">
                <div>
                    <label class="form-label font-monospace">قیمت پیش‌فرض (تومان)</label>
                    <input type="number" class="form-control" @bind="_defaultPrice" />
                </div>
                <div>
                    <label class="form-label font-monospace">موجودی پیش‌فرض</label>
                    <input type="number" class="form-control" @bind="_defaultStock" />
                </div>
                <button type="button" class="btn btn-outline-primary"
                        @onclick="ApplyDefaultsToAll" disabled="@(!_rows.Any(r => !r.ExistsInDb))">
                    اعمال بر ردیف‌های جدید
                </button>
            </div>
        </div>

        @* ═══════════════ گام ۳: ماتریس ترکیب‌ها ═══════════════ *@
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                <strong><i class="fa-solid fa-table-cells text-primary"></i> گام ۳ — ماتریس تنوع‌ها</strong>
                <div>
                    <span class="badge bg-primary">@_rows.Count ترکیب</span>
                    <span class="badge bg-success">@_rows.Count(r => r.Status == "جدید") جدید</span>
                    <span class="badge bg-info text-dark">@_rows.Count(r => r.Status == "بازفعال") بازفعال</span>
                    <span class="badge bg-danger">@_toArchive.Count آرشیو می‌شود</span>
                </div>
            </div>

            @if (_rows.Count == 0)
            {
                <div class="card-body text-center text-muted py-5">
                    از گام ۱ حداقل یک مقدار از هر ویژگی را تیک بزنید تا ترکیب‌های کارتزینی ساخته شوند.
                </div>
            }
            else
            {
                <div class="table-responsive" >
                    <table class="table table-hover align-middle mb-0" id="variantMatrix">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px">ردیف</th>
                                <th>ترکیب</th>
                                <th>SKU</th>
                                <th style="width:170px">قیمت (تومان)</th>
                                <th style="width:130px">موجودی</th>
                                <th style="width:110px">وضعیت</th>
                                <th style="width:60px">حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowCounter = 1;
                            }
                            @foreach (var row in _rows)
                            {
                                var r = row;
                                <tr @key="r.Signature" class="@RowClass(r)">
                                    <td>@(rowCounter++)</td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @foreach (var chip in r.Chips)
                                            {
                                                <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                                    @if (!string.IsNullOrEmpty(chip.DisplayColorHex))
                                                    {
                                                        <span class="color-dot rounded-circle border" style="background:@chip.DisplayColorHex; width:10px; height:10px;"></span>
                                                    }
                                                    @chip.Value
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (r.SkuPreview is null)
                                        {
                                            <span class="text-danger fw-bold">⚠ Code ناقص</span>
                                        }
                                        else
                                        {
                                            <code>@r.SkuPreview</code>
                                        }
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm @(!r.ExistsInDb ? "" : "border-primary")"
                                               @bind="r.Price" @bind:after="() => r.PriceTouched = true" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="r.Stock" @bind:after="() => r.StockTouched = true" />
                                    </td>
                                    <td>
                                        <span class="badge @StatusBadge(r.Status)">@r.Status</span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف این ترکیب از ماتریس"
                                                @onclick="() => ExcludeCombo(r.Signature)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* پیش‌نمایش آرشیوها — شفافیت قبل از ذخیره *@
        @if (_toArchive.Any())
        {
            <div class="alert alert-warning shadow-sm">
                <strong><i class="fa-solid fa-triangle-exclamation"></i> با این ذخیره، واریانت‌های زیر آرشیو می‌شوند</strong> (SKU و تاریخچه‌شان در پایگاه داده حفظ می‌شود):
                <ul class="mb-0 mt-2">
                    @foreach (var s in _toArchive)
                    {
                        <li><code>@s.SkuCode</code> (قیمت: @s.Price.ToString("N0") تومان)</li>
                    }
                </ul>
            </div>
        }

        @* ═══════════════ ذخیره ═══════════════ *@
        <div class="d-flex justify-content-end gap-2 mb-4">
            <button type="button" class="btn btn-secondary px-4" @onclick="BackToEdit">
                انصراف
            </button>
            <button type="button" class="btn btn-primary px-5 shadow-sm" @onclick="HandleSubmit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>در حال ذخیره...</span>
                }
                else
                {
                    <span><i class="fa-solid fa-floppy-disk me-1"></i> ذخیره نهایی ماتریس</span>
                }
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div class="toast show align-items-center text-white @_toastBg border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @_toast
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ProductGuid { get; set; }

    private UpdateProduct? _model;
    private List<ResultProductVariant?> _existingDbVariants = new();
    private List<VariantRowDto> _rows = new();
    private List<ExistingVariantDto> _toArchive = new();
    private List<ResultTrait>? ResultTraits = new List<ResultTrait>();


    private long _defaultPrice = 0;
    private int _defaultStock = 0;
    private bool isSubmitting = false;
    private string? _error;
    private string _toast = "";
    private string _toastBg = "bg-success";

    private void BackToEdit()
    {
        if (_model is not null)
            NavManager.NavigateTo($"/Products/Edit/{_model.ID}");
        else
            NavManager.NavigateTo("/Products");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ProductGuid))
            {
                _error = "شناسه محصول نامعتبر است.";
                return;
            }

            // واکشی داده‌های محصول
            _model = await _ProductService.GetUpdateDataAsync(ProductGuid);
            if (_model is null) { _error = "محصول یافت نشد."; return; }
            if (_model.PricingType != (int)PricingType.VariantBase) return;
            if (_model.CategoryID is null) { _error = "ابتدا دسته‌بندی محصول را تعیین کنید."; return; }

            // واکشی واریانت‌های ذخیره‌شده از دیتابیس
            var variants = await _ProductVariantService.GetAllDataAsync(ProductGuid);
            _existingDbVariants = variants ?? new List<ResultProductVariant>();
            ResultTraits = await _TraitService.GetAllDataAsync();
            // همگام‌سازی ExistingVariants در مدل بر اساس داده‌های واکشی‌شده
            // if (_model.ExistingVariants is null || _model.ExistingVariants.Count == 0)
            // {
            //     _model.ExistingVariants = _existingDbVariants.Select(v => new ExistingVariantDto
            //     {
            //         Id = v.ID,
            //         Signature = v.Signature,
            //         SkuCode = v.SkuCode,
            //         Price = v.Price,
            //         Stock = v.Stock,
            //         IsArchived = v.IsArchived
            //     }).ToList();
            // }

            // پیش‌تیک زدن TraitValueها بر اساس واریانت‌های فعال در دیتابیس
            PrecheckActiveValues();

            // ساخت اولیه سطرهای ماتریس
            RebuildRows();
        }
        catch (Exception ex)
        {
            _error = $"خطا در بارگذاری اولیه: {ex.Message}";
        }
    }

    private void PrecheckActiveValues()
    {
        if (ResultTraits is null || _existingDbVariants is null) return;

        var activeSigs = _existingDbVariants
            .Where(v => !v.IsArchived && !string.IsNullOrWhiteSpace(v.Signature))
            .Select(v => v.Signature!)
            .ToList();

        if (!activeSigs.Any()) return;

        var activeValueIds = new HashSet<int>();
        foreach (var sig in activeSigs)
        {
            var parts = sig.Split('|', StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in parts)
            {
                if (int.TryParse(part, out var id))
                    activeValueIds.Add(id);
            }
        }

        foreach (var trait in ResultTraits)
        {
            foreach (var val in trait.ResultTraitValues)
            {
                val.Checked = activeValueIds.Contains(val.ID);
            }
        }
    }

    // ───────── ساخت ترکیب‌های کارتزینی ─────────
    private void RebuildRows()
    {
        if (ResultTraits is null) return;

        var previous = _rows.ToDictionary(r => r.Signature, r => r);
        var existingBySig = (_existingDbVariants ?? new())
            .Where(v => !string.IsNullOrEmpty(v.Signature))
            .ToDictionary(v => v.Signature!, v => v);

        // واکشی گروه‌های مقادیر تیک‌خورده
        var groups = ResultTraits
            .OrderBy(t => t.ID)
            .Select(t => t.ResultTraitValues.Where(v => v.Checked).ToList())
            .Where(g => g.Count > 0)
            .ToList();

        var combos = new List<List<ResultTraitValue>>();
        if (groups.Count > 0 && groups.Count == ResultTraits.Count(t => t.ResultTraitValues.Any(v => v.Checked)))
        {
            IEnumerable<List<ResultTraitValue>> acc = groups[0].Select(v => new List<ResultTraitValue> { v });
            for (var gi = 1; gi < groups.Count; gi++)
            {
                var g = groups[gi];
                acc = acc.SelectMany(prefix => g.Select(v => new List<ResultTraitValue>(prefix) { v }));
            }
            combos = acc.ToList();
        }

        var rows = new List<VariantRowDto>();
        foreach (var combo in combos)
        {
            var sig = BuildSignature(combo);
            if (previous.TryGetValue(sig, out var old))
            {
                rows.Add(old); // حفظ مقادیر ویرایش‌شده کاربر
                continue;
            }

            if (existingBySig.TryGetValue(sig, out var ex))
            {
                rows.Add(new VariantRowDto
                {
                    Signature = sig,
                    VariantId = ex.ID,
                    DbSku = ex.SkuCode,
                    ExistsInDb = true,
                    WasArchived = ex.IsArchived,
                    Status = ex.IsArchived ? "بازفعال" : "موجود",
                    Chips = combo,
                    SkuPreview = ex.SkuCode,
                    Price = ex.Price,
                    Stock = ex.Stock
                });
            }
            else
            {
                rows.Add(new VariantRowDto
                {
                    Signature = sig,
                    Chips = combo,
                    ExistsInDb = false,
                    WasArchived = false,
                    Status = "جدید",
                    SkuPreview = BuildSkuPreview(combo),
                    Price = _defaultPrice,
                    Stock = _defaultStock
                });
            }
        }
        _rows = rows;

        // واریانت‌هایی که تیک ترکیب آن‌ها برداشته شده و باید آرشیو شوند
        var keepSigs = rows.Select(r => r.Signature).ToHashSet();
        var _toArchive2 = (_existingDbVariants ?? new())
            .Where(v => !v.IsArchived && !keepSigs.Contains(v.Signature ?? ""))
            .ToList();
        foreach (var item in _toArchive2)
        {
            _toArchive.Add(new ExistingVariantDto
                {
                    Id = item.ID,
                    IsArchived = item.IsArchived,
                    Price = item.Price,
                    Signature = item.Signature,
                    SkuCode = item.SkuCode,
                    Stock = item.Stock,
                });
        }
    }

    private string BuildSignature(List<ResultTraitValue> combo) =>
        string.Join("|", combo.OrderBy(v => v.TraitID).Select(v => v.ID));

    private string? BuildSkuPreview(List<ResultTraitValue> combo)
    {
        if (string.IsNullOrWhiteSpace(_model?.ProductCode)) return null;
        var codes = combo.OrderBy(v => v.TraitID).Select(v => v.Code).ToList();
        if (codes.Any(string.IsNullOrWhiteSpace)) return null;
        return $"{_model.ProductCode.Trim().ToUpperInvariant()}-{string.Join("-", codes.Select(c => c.Trim()))}";
    }

    // ───────── اکشن‌های UI ─────────
    private void ToggleAllValues(ResultTrait trait, bool state)
    {
        foreach (var val in trait.ResultTraitValues)
        {
            val.Checked = state;
        }
        RebuildRows();
    }

    private void ExcludeCombo(string signature)
    {
        var row = _rows.FirstOrDefault(r => r.Signature == signature);
        if (row is null || ResultTraits is null) return;

        foreach (var chip in row.Chips)
        {
            var trait = ResultTraits.FirstOrDefault(t => t.ID == chip.TraitID);
            if (trait is null) continue;
            var others = trait.ResultTraitValues.Count(v => v.Checked && v.ID != chip.ID);
            if (others == 0) chip.Checked = false;
        }
        RebuildRows();
    }

    private void ApplyDefaultsToAll()
    {
        foreach (var r in _rows.Where(r => !r.ExistsInDb))
        {
            r.Price = _defaultPrice;
            r.PriceTouched = true;
            r.Stock = _defaultStock;
            r.StockTouched = true;
        }
    }

    private string RowClass(VariantRowDto r) => r.Status switch
    {
        "جدید" => "table-success bg-opacity-25",
        "بازفعال" => "table-info bg-opacity-25",
        _ => ""
    };

    private string StatusBadge(string s) => s switch
    {
        "جدید" => "bg-success",
        "بازفعال" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    // ───────── ذخیره و همگام‌سازی با API ─────────
    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        var invalid = _rows.Where(r => r.SkuPreview is null).ToList();
        if (invalid.Any())
        {
            await ShowToast("⚠ برخی ترکیب‌ها Code معتبر ندارند؛ ابتدا مقادیر ویژگی را کامل کنید.", "bg-danger");
            return;
        }
        if (_rows.Any(r => r.Price <= 0))
        {
            await ShowToast("⚠ قیمت تمام ردیف‌ها باید بزرگ‌تر از صفر باشد.", "bg-warning text-dark");
            return;
        }

        try
        {
            isSubmitting = true;

            int addedCount = 0;
            int updatedCount = 0;
            int archivedCount = 0;

            // ۱) آرشیو کردن واریانت‌های حذف‌شده از ترکیب
            foreach (var arch in _toArchive)
            {
                _ProductVariantService.updateProductVariant = new UpdateProductVariant
                {
                    ID = arch.Id,
                    IsArchived = true,
                    Price = arch.Price,
                    Stock = arch.Stock
                };
                await _ProductVariantService.UpdateAsync();
                archivedCount++;
            }

            // ۲) ایجاد واریانت‌های جدید
            foreach (var r in _rows.Where(r => !r.ExistsInDb))
            {
                _ProductVariantService.addProductVariant = new AddProductVariant
                {
                    ProductID = _model!.ID,
                    Signature = r.Signature,
                    SkuCode = r.SkuPreview!,
                    Price = r.Price,
                    Stock = r.Stock,
                    IsArchived = false
                };
                await _ProductVariantService.AddAsync();
                addedCount++;
            }

            // ۳) به‌روزرسانی واریانت‌های موجود (بازفعال‌سازی یا تغییر قیمت/موجودی)
            foreach (var r in _rows.Where(r => r.ExistsInDb))
            {
                if (r.WasArchived || r.PriceTouched || r.StockTouched)
                {
                    _ProductVariantService.updateProductVariant = new UpdateProductVariant
                    {
                        ID = r.VariantId!.Value,
                        IsArchived = false,
                        Price = r.Price,
                        Stock = r.Stock
                    };
                    await _ProductVariantService.UpdateAsync();
                    updatedCount++;
                }
            }

            await ShowToast($"✅ ذخیره موفق — جدید: {addedCount} | به‌روزرسانی: {updatedCount} | آرشیو: {archivedCount}", "bg-success");

            // بازخوانی کامل داده‌ها بعد از ذخیره
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            await ShowToast($"⛔ خطا در ذخیره ماتریس: {ex.Message}", "bg-danger");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ShowToast(string msg, string bgClass)
    {
        _toast = msg;
        _toastBg = bgClass;
        StateHasChanged();
        await Task.Delay(4000);
        _toast = "";
        StateHasChanged();
    }

    // ───────── کلاس‌های کمکی درون‌کامپوننتی ─────────
    public class VariantRowDto
    {
        public string Signature { get; set; } = "";
        public int? VariantId { get; set; }
        public string? DbSku { get; set; }
        public bool ExistsInDb { get; set; }
        public bool WasArchived { get; set; }
        public string Status { get; set; } = "موجود";
        public List<ResultTraitValue> Chips { get; set; } = new();
        public string? SkuPreview { get; set; }
