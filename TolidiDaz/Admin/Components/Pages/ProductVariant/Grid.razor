@page "/ProductVariant/{ProductGuid}"
@using Admin.Services.Product
@using Admin.Services.ProductVariant
@using Admin.Services.Trait
@using Dto.Models.DtoProduct
@using Dto.Models.DtoProductVariant
@using Dto.Models.DtoTrait
@using Dto.Models.DtoTraitValue
@using static Dto.Enum.EnumConstant
@inject SweetAlertService Swal
@inject ProductVariantService _ProductVariantService
@inject ProductService _ProductService
@inject TraitService _TraitService
@inject NavigationManager NavManager


<div class="vp-page">

    @* ═══════════════ هدر ═══════════════ *@
    <header class="vp-header">
        <div>
            <h2>
                <span class="vp-icon-box"><i class="fa-solid fa-layer-group"></i></span>
                ماتریس تولید واریانت‌ها
            </h2>
            @if (_model is not null)
            {
                <p class="vp-subtitle">
                    <strong>@_model.Title</strong>
                    @if (_model.ResultCategory is not null)
                    {
                        <span class="vp-badge vp-badge-secondary">@_model.ResultCategory.Title</span>
                    }
                    <span class="vp-badge vp-badge-info">کد: @(_model.ProductCode ?? "— تعیین نشده —")</span>
                </p>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="vp-alert vp-alert-danger">@_error</div>
    }
    else if (_model is not null && _model.PricingType != (int)PricingType.VariantBase)
    {
        <div class="vp-alert vp-alert-warning">
            این محصول «ساده» است. برای استفاده از ماتریس واریانت، ابتدا نوع قیمت‌گذاری را در ویرایش محصول روی VariantBased قرار دهید.
        </div>
    }
    else if (_model is not null)
    {
        @* هشدار ProductCode — پیش‌نیاز SKU *@
        @if (string.IsNullOrWhiteSpace(_model.ProductCode))
        {
            <div class="vp-alert vp-alert-warning">
                ⚠ این محصول <strong>ProductCode</strong> ندارد؛ تولید SKU خودکار متوقف می‌شود. ابتدا کد محصول را در فرم ویرایش محصول تکمیل فرمایید.
            </div>
        }

        @* ═══════════════ گام ۱: انتخاب مقادیر ویژگی‌ها ═══════════════ *@
        <div class="vp-card">
            <div class="vp-card-header">
                <strong><i class="fa-solid fa-tags"></i> گام ۱ — انتخاب مقادیر ویژگی‌ها</strong>
                <span class="vp-card-note">منبع: ویژگی‌های متصل به محصول</span>
            </div>
            <div class="vp-card-body">
                @if (ResultTraits is null || ResultTraits.Count == 0)
                {
                    <div class="vp-card-empty">هیچ ویژگی‌ای (Trait) برای این محصول یا دسته‌بندی یافت نشد.</div>
                }
                else
                {
                    @foreach (var trait in ResultTraits)
                    {
                        <div class="vp-trait-row">
                            <div class="vp-trait-head">
                                <strong class="vp-trait-title">@trait.Title</strong>
                                <div class="vp-btn-group">
                                    <button type="button" class="vp-btn vp-btn-outline-primary vp-btn-xs"
                                            @onclick="() => ToggleAllValues(trait, true)">
                                        انتخاب همه
                                    </button>
                                    <button type="button" class="vp-btn vp-btn-outline-secondary vp-btn-xs"
                                            @onclick="() => ToggleAllValues(trait, false)">
                                        پاک کردن
                                    </button>
                                </div>
                            </div>

                            <div class="vp-chip-wrap">
                                @foreach (var val in trait.ResultTraitValues)
                                {
                                    var v = val; // Capture for lambda
                                    <label class="vp-chip @(v.Checked ? "vp-chip--selected" : "")">
                                        <input type="checkbox" @bind="v.Checked" @bind:after="RebuildRows" />
                                        @if (trait.DisplayType2 == (int)TraitDisplayType.Color && !string.IsNullOrEmpty(v.DisplayColorHex))
                                        {
                                            <span class="color-dot" style="background:@v.DisplayColorHex;"></span>
                                        }
                                        <span>@v.Value</span>
                                        @if (string.IsNullOrWhiteSpace(v.Code))
                                        {
                                            <span class="vp-chip-warn" title="این مقدار Code ندارد و در SKU نمی‌نشیند">⚠</span>
                                        }
                                        else
                                        {
                                            <code class="vp-chip-code">@v.Code</code>
                                        }
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ═══════════════ گام ۲: پیش‌فرض‌ها ═══════════════ *@
        <div class="vp-card">
            <div class="vp-card-header"><strong><i class="fa-solid fa-sliders"></i> گام ۲ — مقادیر پیش‌فرض</strong></div>
            <div class="vp-card-body vp-form-row">
                <div class="vp-field">
                    <label>قیمت پیش‌فرض (تومان)</label>
                    <input type="number" class="vp-input" @bind="_defaultPrice" />
                </div>
                <div class="vp-field">
                    <label>موجودی پیش‌فرض</label>
                    <input type="number" class="vp-input" @bind="_defaultStock" />
                </div>
                <button type="button" class="vp-btn vp-btn-outline-primary"
                        @onclick="ApplyDefaultsToAll" disabled="@(!_rows.Any(r => !r.ExistsInDb))">
                    اعمال بر ردیف‌های جدید
                </button>
            </div>
        </div>

        @* ═══════════════ گام ۳: ماتریس ترکیب‌ها ═══════════════ *@
        <div class="vp-card">
            <div class="vp-card-header">
                <strong><i class="fa-solid fa-table-cells"></i> گام ۳ — ماتریس تنوع‌ها</strong>
                <div class="vp-badge-row">
                    <span class="vp-badge vp-badge-primary">@_rows.Count ترکیب</span>
                    <span class="vp-badge vp-badge-success">@_rows.Count(r => r.Status == "جدید") جدید</span>
                    <span class="vp-badge vp-badge-info">@_rows.Count(r => r.Status == "بازفعال") بازفعال</span>
                    <span class="vp-badge vp-badge-danger">@_toArchive.Count آرشیو می‌شود</span>
                </div>
            </div>

            @if (_rows.Count == 0)
            {
                <div class="vp-card-empty">
                    از گام ۱ حداقل یک مقدار از هر ویژگی را تیک بزنید تا ترکیب‌های کارتزینی ساخته شوند.
                </div>
            }
            else
            {
                <div class="vp-table-wrap">
                    <table class="vp-table" id="variantMatrix">
                        <thead>
                            <tr>
                                <th class="vp-col-index">#</th>
                                <th>ترکیب</th>
                                <th>SKU</th>
                                <th class="vp-col-price">قیمت (تومان)</th>
                                <th class="vp-col-stock">موجودی</th>
                                <th class="vp-col-status">وضعیت</th>
                                <th class="vp-col-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowCounter = 1;
                            }
                            @foreach (var row in _rows)
                            {
                                var r = row;
                                <tr @key="r.Signature" class="@GetRowBgClass(r.Status)">
                                    <td class="vp-col-index">
                                        @(rowCounter++)
                                    </td>
                                    <td>
                                        <div class="vp-combo">
                                            @foreach (var chip in r.Chips)
                                            {
                                                <span class="vp-combo-chip">
                                                    @if (!string.IsNullOrEmpty(chip.DisplayColorHex))
                                                    {
                                                        <span class="vp-combo-dot" style="background:@chip.DisplayColorHex;"></span>
                                                    }
                                                    @chip.Value
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (r.SkuPreview is null)
                                        {
                                            <span class="vp-sku-missing">
                                                ⚠ Code ناقص
                                            </span>
                                        }
                                        else
                                        {
                                            <code class="vp-sku">
                                                @r.SkuPreview
                                            </code>
                                        }
                                    </td>
                                    <td>
                                        <input type="number"
                                               class="vp-cell-input @(!r.ExistsInDb ? "" : "vp-cell-input--existing")"
                                               @bind="r.Price"
                                               @bind:after="() => r.PriceTouched = true" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               class="vp-cell-input"
                                               @bind="r.Stock"
                                               @bind:after="() => r.StockTouched = true" />
                                    </td>
                                    <td class="vp-col-status">
                                        <span class="vp-status @GetStatusBadgeClass(r.Status)">
                                            @r.Status
                                        </span>
                                    </td>
                                    <td class="vp-col-actions">
                                        <button type="button"
                                                @onclick="@(async () => await UpdateSetIsArchive(r))"
                                                title="تغییر وضعیت"
                                                class="btn-archive">
                                            <span class="vp-status @GetStatusBadgeClass(r.Status)">
                                                تغییر
                                            </span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* پیش‌نمایش آرشیوها — شفافیت قبل از ذخیره *@
        @if (_toArchive.Any())
        {
            <div class="vp-alert vp-alert-warning">
                <strong><i class="fa-solid fa-triangle-exclamation"></i> با این ذخیره، واریانت‌های زیر آرشیو می‌شوند</strong> (SKU و تاریخچه‌شان در پایگاه داده حفظ می‌شود):
                <ul>
                    @foreach (var s in _toArchive)
                    {
                        <li><code>@s.SkuCode</code> (قیمت: @s.Price.ToString("N0") تومان)</li>
                    }
                </ul>
            </div>
        }

        @* ═══════════════ ذخیره ═══════════════ *@
        <div class="vp-actions">
            <!-- دکمه ذخیره -->
            <button type="button"
                    disabled="@isSubmitting"
                    @onclick="HandleSubmit"
                    class="vp-btn-save">
                @if (isSubmitting)
                {
                    <svg class="vp-spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    <span>در حال ذخیره...</span>
                }
                else
                {
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>ذخیره نهایی ماتریس</span>
                }
            </button>
            <!-- دکمه بازگشت -->
            <button type="button"
                    @onclick="BackToBack"
                    class="vp-btn-back">
                بازگشت
            </button>
        </div>

    }
</div>

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="vp-toast-host">
        <div class="vp-toast @_toastBg" role="alert" aria-live="assertive" aria-atomic="true">
            @_toast
        </div>
    </div>
}

@code {
    [Parameter] public string? ProductGuid { get; set; }

    private UpdateProduct? _model;
    private List<UpdateProductVariant?> _existingDbVariants = new();
    private List<AddProductVariantRow> _rows = new();
    // private List<VariantRowDto> _rows = new();
    // private List<ExistingVariantDto> _toArchive = new();
    private List<UpdateProductVariant> _toArchive = new();
    private List<ResultTrait>? ResultTraits = new List<ResultTrait>();


    private long _defaultPrice = 0;
    private int _defaultStock = 0;
    private bool isSubmitting = false;
    private string? _error;
    private string _toast = "";
    private string _toastBg = "vp-toast-success";
    private HashSet<string> _excludedSignatures = new();

    private void BackToBack()
    {
        NavManager.NavigateTo("/Product");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bool isValid = Guid.TryParse(ProductGuid, out _);
            if (!isValid && string.IsNullOrWhiteSpace(ProductGuid))
            {
                _error = "شناسه محصول نامعتبر است.";
                return;
            }
            // واکشی داده‌های محصول
            _model = await _ProductService.GetUpdateDataAsync(ProductGuid);
            if (_model is null) { _error = "محصول یافت نشد."; return; }
            if (_model.PricingType != (int)PricingType.VariantBase) return;
            if (_model.CategoryID is null) { _error = "ابتدا دسته‌بندی محصول را تعیین کنید."; return; }

            // واکشی واریانت‌های ذخیره‌شده از دیتابیس
            _existingDbVariants = await _ProductVariantService.GetAllDataAsync(ProductGuid);
            ResultTraits = await _TraitService.GetAllDataAsync();

            // پیش‌تیک زدن TraitValueها بر اساس واریانت‌های فعال در دیتابیس
            PrecheckActiveValues();
            // ساخت اولیه سطرهای ماتریس
            RebuildRows();
        }
        catch (Exception ex)
        {
            _error = $"خطا در بارگذاری اولیه: {ex.Message}";
        }
    }

    private void PrecheckActiveValues()
    {
        if (ResultTraits is null || _existingDbVariants is null) return;

        var activeSigs = _existingDbVariants
            .Where(v => !v.IsArchived && !string.IsNullOrWhiteSpace(v.Signature))
            .Select(v => v.Signature!)
            .ToList();

        if (!activeSigs.Any()) return;

        var activeValueIds = new HashSet<int>();
        foreach (var sig in activeSigs)
        {
            var parts = sig.Split('|', StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in parts)
            {
                if (int.TryParse(part, out var id))
                    activeValueIds.Add(id);
            }
        }

        foreach (var trait in ResultTraits)
        {
            foreach (var val in trait.ResultTraitValues)
            {
                val.Checked = activeValueIds.Contains(val.ID);
            }
        }
    }
    // ───────── ساخت ترکیب‌های کارتزینی ─────────
    private void RebuildRows()
    {
        if (ResultTraits is null) return;

        var previous = _rows.ToDictionary(r => r.Signature, r => r);
        var existingBySig = (_existingDbVariants ?? new())
            .Where(v => !string.IsNullOrEmpty(v.Signature))
            .ToDictionary(v => v.Signature!, v => v);

        // واکشی گروه‌های مقادیر تیک‌خورده
        var groups = ResultTraits
            .OrderBy(t => t.ID)
            .Select(t => t.ResultTraitValues.Where(v => v.Checked).ToList())
            .Where(g => g.Count > 0)
            .ToList();

        var combos = new List<List<ResultTraitValue>>();
        if (groups.Count > 0 && groups.Count == ResultTraits.Count(t => t.ResultTraitValues.Any(v => v.Checked)))
        {
            IEnumerable<List<ResultTraitValue>> acc = groups[0].Select(v => new List<ResultTraitValue> { v });
            for (var gi = 1; gi < groups.Count; gi++)
            {
                var g = groups[gi];
                acc = acc.SelectMany(prefix => g.Select(v => new List<ResultTraitValue>(prefix) { v }));
            }
            combos = acc.ToList();
        }

        var rows = new List<AddProductVariantRow>();
        foreach (var combo in combos)
        {
            var sig = BuildSignature(combo);
            if (previous.TryGetValue(sig, out var old))
            {
                rows.Add(old); // حفظ مقادیر ویرایش‌شده کاربر
                continue;
            }

            if (existingBySig.TryGetValue(sig, out var ex))
            {
                rows.Add(new AddProductVariantRow
                {
                    ID = ex.ID,
                    ProductID = ex.ProductID,
                    Signature = sig,
                    VariantId = ex.ID,
                    SkuCode = ex.SkuCode,
                    IsArchived = ex.IsArchived,
                    ExistsInDb = true,
                    WasArchived = ex.IsArchived,
                    Status = ex.IsArchived ? "بازفعال" : "موجود",
                    Chips = combo,
                    SkuPreview = ex.SkuCode,
                    Price = ex.Price,
                    Stock = ex.Stock
                });
            }
            else
            {
                rows.Add(new AddProductVariantRow
                {
                    ProductID = _model.ID,
                    Signature = sig,
                    Chips = combo,
                    ExistsInDb = false,
                    WasArchived = false,
                    IsArchived = false,
                    Status = "جدید",
                    SkuPreview = BuildSkuPreview(combo),
                    Price = _defaultPrice,
                    Stock = _defaultStock,

                });
            }
        }
        _rows = rows;

        // واریانت‌هایی که تیک ترکیب آن‌ها برداشته شده و باید آرشیو شوند
        var keepSigs = rows.Select(r => r.Signature).ToHashSet();

        _toArchive = (_existingDbVariants ?? new())
           .Where(v => !v.IsArchived && !keepSigs.Contains(v.Signature ?? ""))
           .ToList();

    }

    private string BuildSignature(List<ResultTraitValue> combo) =>
        string.Join("|", combo.OrderBy(v => v.TraitID).Select(v => v.ID));

    private string? BuildSkuPreview(List<ResultTraitValue> combo)
    {
        if (string.IsNullOrWhiteSpace(_model?.ProductCode)) return null;
        var codes = combo.OrderBy(v => v.TraitID).Select(v => v.Code).ToList();
        if (codes.Any(string.IsNullOrWhiteSpace)) return null;
        return $"{_model.ProductCode.Trim().ToUpperInvariant()}-{string.Join("-", codes.Select(c => c.Trim()))}";
    }

    // ───────── اکشن‌های UI ─────────
    private void ToggleAllValues(ResultTrait trait, bool state)
    {
        foreach (var val in trait.ResultTraitValues)
        {
            val.Checked = state;
        }
        RebuildRows();
    }
    private async Task UpdateSetIsArchive(AddProductVariantRow row)
    {

        // ۱. اگر تو دیتابیس نیست، فقط از لیست حافظه حذف کن
        if (!row.ExistsInDb)
        {
            _rows.Remove(row);
        }
        // ۲. اگر تو دیتابیس هست، اول آرشیو کن
        else
        {
            await _ProductVariantService.UpdateSetIsArchive(!row.IsArchived, row.ID);

            // نکته: اینجا ردیف رو از لیست _rows حذف کن تا رندرِ بعدیِ بلازور دیگه نشونش نده
            _rows.Remove(row);
            _existingDbVariants = await _ProductVariantService.GetAllDataAsync(ProductGuid);
            //   ResultTraits = await _TraitService.GetAllDataAsync();
            // نکته طلایی: اگر لازم بود لیست به دیتابیس سینک بشه، RebuildRows رو بزن
            // اما حواست باشه که RebuildRows ممکنه دوباره همون رکورد رو از DB لود کنه!
            // پس مطمئن شو _existingDbVariants هم آپدیت شده باشه.
        }

        // StateHasChanged رو بزن که UI بلافاصله رفرش شه
        RebuildRows();
        StateHasChanged();
    }
    private void ApplyDefaultsToAll()
    {
        foreach (var r in _rows.Where(r => !r.ExistsInDb))
        {
            r.Price = _defaultPrice;
            r.PriceTouched = true;
            r.Stock = _defaultStock;
            r.StockTouched = true;
        }
    }

    private string GetRowBgClass(string status) => status switch
    {
        "جدید" => "vp-row-new",
        "بازفعال" => "vp-row-reactive",
        _ => ""
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "جدید" => "badgNew",
        "بازفعال" => "badgReActive",
        _ => "badgExists"
    };


    // ───────── ذخیره و همگام‌سازی با API ─────────
    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        var invalid = _rows.Where(r => r.SkuPreview is null).ToList();
        if (invalid.Any())
        {
            await ShowToast("⚠ برخی ترکیب‌ها Code معتبر ندارند؛ ابتدا مقادیر ویژگی را کامل کنید.", "vp-toast-danger");
            return;
        }
        if (_rows.Any(r => r.Price <= 0))
        {
            await ShowToast("⚠ قیمت تمام ردیف‌ها باید بزرگ‌تر از صفر باشد.", "vp-toast-warning");
            return;
        }

        try
        {
            isSubmitting = true;

            int addedCount = 0;
            int updatedCount = 0;
            int archivedCount = 0;



            // ۱) آرشیو دسته‌جمعی واریانت‌های حذف‌شده از ماتریس
            if (_toArchive.Any())
            {
                foreach (var item in _toArchive)
                {
                    item.IsArchived = true;
                }
                await _ProductVariantService.UpdateRangeAsync(_toArchive);
                archivedCount = _toArchive.Count;
            }


            // ۲) ایجاد واریانت‌های جدید
            var rows = _rows.Where(r => !r.ExistsInDb).ToList();
            if (rows.Count > 0)
            {
                foreach (var item in rows)
                {
                    item.SkuCode = item.SkuPreview;
                    item.ProductID = _model!.ID;
                    item.IsArchived = false;
                }
                await _ProductVariantService.AddRangeAsync(rows);
                addedCount = rows.Count;
            }



            // ۳) به‌روزرسانی واریانت‌های موجود (بازفعال‌سازی یا تغییر قیمت/موجودی)
            var updateProductVariantRows = _rows.Where(r => r.ExistsInDb).ToList();
            foreach (var r in updateProductVariantRows)
            {
                if (r.WasArchived || r.PriceTouched || r.StockTouched)
                {
                    r.ID = r.VariantId!.Value;
                    r.IsArchived = false;
                }
            }
            await _ProductVariantService.UpdateRangeAsync2(updateProductVariantRows);
            updatedCount = updateProductVariantRows.Count;
            await ShowToast($"✅ ذخیره موفق — جدید: {addedCount} | به‌روزرسانی: {updatedCount} | آرشیو: {archivedCount}", "vp-toast-success");

            // بازخوانی کامل داده‌ها بعد از ذخیره
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            await ShowToast($"⛔ خطا در ذخیره ماتریس: {ex.Message}", "vp-toast-danger");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ShowToast(string msg, string bgClass)
    {
        _toast = msg;
        _toastBg = bgClass;
        StateHasChanged();
        await Task.Delay(4000);
        _toast = "";
        StateHasChanged();
    }



    public class ExistingVariantDto
    {
        public int Id { get; set; }
        public string? Signature { get; set; }
        public string? SkuCode { get; set; }
        public long Price { get; set; }
        public int Stock { get; set; }
        public bool IsArchived { get; set; }
    }


}