@page "/ShowContactUs"
@using Dto.Models.DtoAccount
@using Dto.Models.DtoContactUs
@using Dto.Models.DtoUploadFile
@using System.Net.Http.Headers
@using Newtonsoft.Json
@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<UpdateContactUs>> RootApiUpdateContactUs

@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">نمایش اطلاعات ارتباط با ما</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات ارتباط با ما</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <EditForm Model="updateContactUs"  FormName="UpdateForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم ارتباط با ما
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- ContactUs Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.FullName)"></CustomLabel>
                        <InputText readonly  @bind-Value="updateContactUs.FullName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.Mobile)"></CustomLabel>
                        <InputText readonly @bind-Value="updateContactUs.Mobile" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.Email)"></CustomLabel>
                        <InputText readonly @bind-Value="updateContactUs.Email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.IpAddress)"></CustomLabel>
                        <InputText readonly @bind-Value="updateContactUs.IpAddress" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.Subject)"></CustomLabel>
                        <InputText readonly @bind-Value="updateContactUs.Subject" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="ContactUs-name" For="@(() => updateContactUs.Message)"></CustomLabel>
                        <InputTextArea readonly rows="10" @bind-Value="updateContactUs.Message" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div>
               
            </div>
        </div>
    </EditForm>

</main>
@code {
    private UpdateContactUs? updateContactUs { get; set; } = new() { Visible = true };
    [SupplyParameterFromQuery]
    public int ID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await GetData();

    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateContactUs.RunMethodApi($"ContactUss/{ID}", null, method: Method.Get);
        updateContactUs = resdataEdit.Entity;
        if (updateContactUs.IsRead == false)
        {
            updateContactUs.IsRead = true;
            var resdata = await RootApiUpdateContactUs.RunMethodApi("ContactUss", updateContactUs, method: Method.Patch);
            if (resdata.Status == ResultMessageApi.Success)
            {
                await JS.CallAlertToast(resdata.Message);
            }
            else
            {
                var result2 = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }

    }
    private void GoBack()
    {
        NavManager.NavigateTo("/ContactUs");
    }
  
}

