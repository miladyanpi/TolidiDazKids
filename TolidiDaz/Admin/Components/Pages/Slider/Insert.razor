@page "/InsertSlider"
@using Admin.Services.Slider
@inject SliderService _SliderService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن اسلایدر جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات اسلایدر جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="Slider" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_SliderService.addSlider" OnValidSubmit="_SliderService.AddAsync" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات تیم فروشگاه
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="Slider-name" For="@(() => _SliderService.addSlider.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => _SliderService.addSlider.Title)" class="validate" />
                        <InputText id="Slider-name" @bind-Value="_SliderService.addSlider.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Slider-name" For="@(() => _SliderService.addSlider.Url)"></CustomLabel>
                        <ValidationMessage For="@(() => _SliderService.addSlider.Url)" class="validate" />
                        <InputText id="Slider-name" @bind-Value="_SliderService.addSlider.Url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                </div>
                <!-- Settings -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="Slider-name" For="@(() => _SliderService.addSlider.Description)"></CustomLabel>
                        <ValidationMessage For="@(() => _SliderService.addSlider.Description)" class="validate" />
                        <TextEditor @bind-Value="_SliderService.addSlider.Description" />
                    </div>
                    <div class="mb-4">
                        <CustomLabel For="@(() => _SliderService.addSlider.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_SliderService.addSlider.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _SliderService.addSlider.Visible)" class="validate" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>
            </div>
        </div>
    </EditForm>
</main>


