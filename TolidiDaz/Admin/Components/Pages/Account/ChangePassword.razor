@page "/ChangePassword"
@using Dto.Models.DtoAccount
@using Microsoft.AspNetCore.Components.Authorization
@inject SweetAlertService Swal
@inject ILocalStorageService localStorageService
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<ChangePasswordAccount>> RootApiChangePasswordAccount
@attribute [Authorize]


<EditForm Model="ChangePasswordAccount" OnValidSubmit="Update" FormName="EditForm">
    <DataAnnotationsValidator />
    <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="px-6 border-b border-gray-200 dark:border-gray-700">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                تغییر کلمه عبور
            </h3>
        </div>
        <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Category Info -->
            <div class="space-y-4">
                <div>
                    <CustomLabel For="@(() => ChangePasswordAccount.Name)"></CustomLabel>
                    <ValidationMessage For="@(() => ChangePasswordAccount.Name)" class="validate" />
                    <InputText @bind-Value="ChangePasswordAccount.Name" readonly class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div>
                    <CustomLabel For="@(() => ChangePasswordAccount.UserName)"></CustomLabel>
                    <ValidationMessage For="@(() => ChangePasswordAccount.UserName)" class="validate" />
                    <InputText @bind-Value="ChangePasswordAccount.UserName" readonly class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div>
                    <CustomLabel For="@(() => ChangePasswordAccount.OldPassword)"></CustomLabel>
                    <ValidationMessage For="@(() => ChangePasswordAccount.OldPassword)" class="validate" />
                    <InputText type="password" @bind-Value="ChangePasswordAccount.OldPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white"  />
                </div>
                <div>
                    <CustomLabel For="@(() => ChangePasswordAccount.NewPassword)"></CustomLabel>
                    <ValidationMessage For="@(() => ChangePasswordAccount.NewPassword)" class="validate" />
                    <InputText type="password" @bind-Value="ChangePasswordAccount.NewPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white"  />
                </div>
                <div>
                    <CustomLabel For="@(() => ChangePasswordAccount.ConfirmNewPassword)"></CustomLabel>
                    <ValidationMessage For="@(() => ChangePasswordAccount.ConfirmNewPassword)" class="validate" />
                    <InputText type="password" @bind-Value="ChangePasswordAccount.ConfirmNewPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white"  />
                </div>
                <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                    <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                        ذخیره
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    protected Task<AuthenticationState> AuthStat { get; set; }
    private ChangePasswordAccount? ChangePasswordAccount { get; set; } = new();
    protected async override Task OnInitializedAsync()
    {
        var user = (await AuthStat).User;
        var userClaimName = user.Claims.Where(s => s.Type == System.Security.Claims.ClaimTypes.Name).FirstOrDefault();
        ChangePasswordAccount.Name = userClaimName.Value;
        var userClaimUserName = user.Claims.Where(s => s.Type == System.Security.Claims.ClaimTypes.UserData).FirstOrDefault();
        ChangePasswordAccount.UserName = userClaimUserName.Value;
    }
    private async Task Update()
    {
        var changePassword = await RootApiChangePasswordAccount.RunMethodApi($"Accounts/ChangePasswordAccount", ChangePasswordAccount, method: Method.Post);
        if (changePassword != null && changePassword.Status == ResultMessageApi.Success)
        {
            ChangePasswordAccount.OldPassword = string.Empty;
            ChangePasswordAccount.NewPassword = string.Empty;
            ChangePasswordAccount.ConfirmNewPassword = string.Empty;
            await JS.CallAlertToast(changePassword.Message);
        }
        else
        {
            _ = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = changePassword.Message,
                Icon = changePassword.Status,
                ShowConfirmButton = true,
            });
        }
    }
}