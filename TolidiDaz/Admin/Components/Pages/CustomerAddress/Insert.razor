@page "/InsertCustomerAddress"
@using Dto.Models.DtoCity
@using Dto.Models.DtoCustomerAddress
@using Dto.Models.DtoProvince

@inject SweetAlertService Swal

@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<AddCustomerAddress>> RootApiAddCustomerAddress
@inject IRootApi<ResponseApiEntities<ResultProvince>> RootApiResultProvinces
@inject IRootApi<ResponseApiEntities<ResultCity>> RootApiResultCitys
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن آدرس جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات آدرس جدید را وارد نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add category form -->
    <EditForm Model="addCustomerAddress" OnValidSubmit="Add" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات آدرس
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="City-parent" For="@(() => addCustomerAddress.ProvinceID)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.ProvinceID)" class="validate" />
                        <InputSelect @bind-Value="addCustomerAddress.ProvinceID" @bind-Value:after="@(async ()=>await GetCity())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in ResultProvinces)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <CustomLabel ForId="City-parent" For="@(() => addCustomerAddress.CityID)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.CityID)" class="validate" />
                        <InputSelect @bind-Value="addCustomerAddress.CityID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            @foreach (var item in ResultCitys)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <CustomLabel ForId="CustomerAddress-Address" For="@(() => addCustomerAddress.Address)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.Address)" class="validate" />
                        <InputTextArea @bind-Value="addCustomerAddress.Address" id="addCustomerAddress-description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="CustomerAddress-Plaque" For="@(() => addCustomerAddress.Plaque)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.Plaque)" class="validate" />
                        <InputText id="CustomerAddress-Plaque" @bind-Value="addCustomerAddress.Plaque" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="CustomerAddress-BuildingUnit" For="@(() => addCustomerAddress.BuildingUnit)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.BuildingUnit)" class="validate" />
                        <InputText id="CustomerAddress-BuildingUnit" @bind-Value="addCustomerAddress.BuildingUnit" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="CustomerAddress-PostalCode" For="@(() => addCustomerAddress.PostalCode)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.PostalCode)" class="validate" />
                        <InputText id="CustomerAddress-PostalCode" @bind-Value="addCustomerAddress.PostalCode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="CustomerAddress-Description" For="@(() => addCustomerAddress.Description)"></CustomLabel>
                        <ValidationMessage For="@(() => addCustomerAddress.Description)" class="validate" />
                        <InputTextArea @bind-Value="addCustomerAddress.Description" id="addCustomerAddress-Description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />

                    </div>

                </div>


                <!-- Settings -->
                <div class="space-y-4">
                   
                  
                    <div class="mb-4">
                        <CustomLabel For="@(() => addCustomerAddress.Visible)"></CustomLabel>

                        <InputRadioGroup @bind-Value="addCustomerAddress.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => addCustomerAddress.Visible)" class="validate" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">پیش فرض*</label>
                        <InputRadioGroup @bind-Value="addCustomerAddress.Default" Name="Default">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => addCustomerAddress.Default)" class="validate" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {
    private AddCustomerAddress? addCustomerAddress { get; set; } = new() { Visible = true,Default=true};
    private List<ResultProvince>? ResultProvinces { get; set; } = new();
    private List<ResultCity>? ResultCitys { get; set; } = new();
    [SupplyParameterFromQuery]
    public int? CustomerID { get; set; } = null;
    protected async override Task OnInitializedAsync()
    {
        var resdata = await RootApiResultProvinces.RunMethodApi($"Provinces/Public/All", null, method: Method.Get);
        ResultProvinces = resdata.Entities.ToList();
        if (ResultProvinces.Count > 0)
            addCustomerAddress.ProvinceID = ResultProvinces[0].ID;
        await GetCity();
    }

    private async Task GetCity()
    {
        addCustomerAddress.CustomerID = CustomerID;
        var resdata = await RootApiResultCitys.RunMethodApi($"Citys/All?ProvinceID={addCustomerAddress.ProvinceID}", null, method: Method.Get);
        ResultCitys = resdata.Entities.ToList();
        if (ResultCitys.Count > 0)
            addCustomerAddress.CityID = ResultCitys[0].ID;
    }
    private async Task Add()
    {

        var resdata = await RootApiAddCustomerAddress.RunMethodApi("CustomerAddresss", addCustomerAddress, method: Method.Post);

        if (resdata.Status == ResultMessageApi.Success)
        {

            var ProvinceID = addCustomerAddress.ProvinceID;
            var CityID = addCustomerAddress.CityID;
            addCustomerAddress = new AddCustomerAddress
            {
                Visible=true,
                Default=true,
                ProvinceID = ProvinceID,
                CityID = CityID,
            };
            await JS.CallAlertToast(resdata.Message);
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    private void GoBack()
    {
        var parameter = new Dictionary<string, object>
        {
            {"CustomerID", CustomerID.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/CustomerAddress", parameter!));
    }
}

