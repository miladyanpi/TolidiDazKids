@page "/UpdateTraitValue/{guid}"
@using Admin.Services.TraitValue

@inject TraitValueService _TraitValueService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش اطلاعات مقادیر ویژگی ویژه</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات مقادیر ویژگی را ویرایش نمایید</p>
        </div>
        <BackButton UrlPage="TraitValue" />
    </div>
    @if (isLoading)
    {
        <FetchingData/>

    }
    else if (_TraitValueService.updateTraitValue == null)
    {
        <DataNotFound/>
    }
    else
    {
        <!-- Add category form -->
        <EditForm Model="_TraitValueService.updateTraitValue" OnValidSubmit="HandleSubmitAsync" FormName="UpdateForm">
            <DataAnnotationsValidator />
            <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
                <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                        فرم مقادیر ویژگی
                    </h3>
                </div>

                <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- TraitValue Info -->
                    <div class="space-y-4">
                        <div>
                            <CustomLabel ForId="category-parent" For="@(() => _TraitValueService.updateTraitValue.TraitID)"></CustomLabel>
                            <ValidationMessage For="@(() => _TraitValueService.updateTraitValue.TraitID)" class="validate" />
                            <InputSelect @bind-Value=" _TraitValueService.updateTraitValue.TraitID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _TraitValueService.ResultTraitValues)
                                {
                                    <option value="@item.ID">@item.Value</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <CustomLabel ForId="TraitValue-Title" For="@(() => _TraitValueService.updateTraitValue.Value)"></CustomLabel>
                            <ValidationMessage For="@(() => _TraitValueService.updateTraitValue.Value)" class="validate" />
                            <InputText id="TraitValue-Title" @bind-Value="_TraitValueService.updateTraitValue.Value" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel ForId="TraitValue-Title" For="@(() => _TraitValueService.updateTraitValue.DisplayColorHex)"></CustomLabel>
                            <ValidationMessage For="@(() => _TraitValueService.updateTraitValue.DisplayColorHex)" class="validate" />
                            <InputText id="TraitValue-Title" @bind-Value="_TraitValueService.updateTraitValue.DisplayColorHex" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                    </div>
                    <!-- Settings -->
                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _TraitValueService.updateTraitValue.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_TraitValueService.updateTraitValue.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _TraitValueService.updateTraitValue.Visible)" class="validate" />
                    </div>
                </div>
            </div>
            <SaveButton Disabled="@isSubmitting" />
        </EditForm>
    }
</main>

@code {
    [Parameter]
    public string? guid { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;
    protected override async Task OnParametersSetAsync()
    {
        bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            isLoading = true;
            await _TraitValueService.GetUpdateDataAsync(guid);
            isLoading = false;
        }
        else
        {

            NavManager.NavigateTo("/TraitValue");
        }
    }
    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;
        try
        {
            isSubmitting = true;
            await _TraitValueService.UpdateAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}