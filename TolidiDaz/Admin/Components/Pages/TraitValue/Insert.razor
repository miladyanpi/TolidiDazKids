@page "/InsertTraitValue/{guid}"
@using Admin.Services.Trait
@using Admin.Services.TraitValue
@using static Dto.Enum.EnumConstant
@inject TraitValueService _TraitValueService
@inject TraitService _TraitService
<AccessAdminRoles />
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن مقادیر ویژگی جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات مقادیر ویژگی جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="@BackUrl" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_TraitValueService.addTraitValue" OnValidSubmit="HandleSubmitAsync" FormName="AddForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات مقادیر ویژگی
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                  
                    <div>
                        <CustomLabel ForId="TraitValue-Title" For="@(() => _TraitValueService.addTraitValue.Value)"></CustomLabel>
                        <ValidationMessage For="@(() => _TraitValueService.addTraitValue.Value)" class="validate" />
                        <InputText @bind-Value="_TraitValueService.addTraitValue.Value" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <!-- اگر ویژگی انتخاب‌شده از نوع رنگ بود، فیلد رنگ رو نشون بده -->
                    @if (_TraitService.updateTrait.DisplayType == (int)TraitDisplayType.Color)
                    {
                        <div>
                            <CustomLabel ForId="TraitValue-Title" For="@(() => _TraitValueService.addTraitValue.DisplayColorHex)"></CustomLabel>
                            <ValidationMessage For="@(() => _TraitValueService.addTraitValue.DisplayColorHex)" class="validate" />
                            <input type="color" @bind="_TraitValueService.addTraitValue.DisplayColorHex" class="h-9 w-12 rounded cursor-pointer border border-gray-300" />
                            <InputText @bind-Value="_TraitValueService.addTraitValue.DisplayColorHex" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />

                        </div>
                    }

                   
                </div>
                <!-- Settings -->
                <div class="mb-4">
                    <CustomLabel ForId="Visible-stock" For="@(() => _TraitValueService.addTraitValue.Visible)"></CustomLabel>
                    <InputRadioGroup @bind-Value="_TraitValueService.addTraitValue.Visible" Name="status">
                        <InsertUpdateVisible />
                    </InputRadioGroup>
                    <ValidationMessage For="@(() => _TraitValueService.addTraitValue.Visible)" class="validate" />
                </div>
            </div>
        </div>
        <SaveButton Disabled="@isSubmitting" />
    </EditForm>
</main>

@code {
    [Parameter]
    public string? guid { get; set; }
    public string? BackUrl { get; set; }
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        BackUrl = $"TraitValue/{guid}";
        bool isValid = Guid.TryParse(guid, out _);
        if (isValid)
        {
            await _TraitService.GetUpdateDataAsync(guid);
            _TraitValueService.addTraitValue.TraitID = _TraitService.updateTrait.ID;

        }

       
    }
    private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;
        try
        {
            isSubmitting = true;
            await _TraitValueService.AddAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

