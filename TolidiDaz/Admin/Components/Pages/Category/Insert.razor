@page "/InsertCategory"
@using Admin.Services.Category
@using Dto.Models.DtoCategory
@using Dto.Models.DtoUploadFile
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<AddCategory>> RootApiAddCategory
@inject IRootApi<ResponseApiEntities<ResultCategory>> RootApiResultCategorys
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFile
@inject CategoryService _CategoryService
@attribute [Authorize(Roles = ConstantRoles.AdminName + "," + ConstantRoles.SuperAdminName)]

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن دسته‌بندی جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات دسته‌بندی جدید را وارد نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add category form -->
    <EditForm Model="addCategory" OnValidSubmit="AddAsync" FormName="AddForm">
        <DataAnnotationsValidator />

        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات دسته‌بندی
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="category-name" For="@(() => addCategory.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => addCategory.Title)" class="validate" />
                        <InputText id="category-name" @bind-Value="addCategory.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>

                    <div>
                        <CustomLabel ForId="category-slug" For="@(() => addCategory.Slug)"></CustomLabel>
                        <ValidationMessage For="@(() => addCategory.Slug)" class="validate" />
                        <InputText id="category-slug" @bind-Value="addCategory.Slug" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>

                    <div>

                        <CustomLabel ForId="category-parent" For="@(() => addCategory.ParentID1)"></CustomLabel>
                        <ValidationMessage For="@(() => addCategory.ParentID1)" class="validate" />
                        <InputSelect @bind-Value="addCategory.ParentID1" @bind-Value:after="@(async () => await GetCategoryParent2Async())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            <option value="0">بدون والد (دسته اصلی)</option>
                            @foreach (var item in ResultCategorys1)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>

                    </div>
                    @if (addCategory.ParentID1 > 0)
                    {
                        <div>

                            <CustomLabel ForId="category-parent" For="@(() => addCategory.ParentID2)"></CustomLabel>
                            <ValidationMessage For="@(() => addCategory.ParentID2)" class="validate" />
                            <InputSelect @bind-Value="addCategory.ParentID2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                <option value="0">بدون والد (دسته اصلی)</option>
                                @foreach (var item in ResultCategorys2)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>

                        </div>
                    }
                    else
                    {
                        <div></div>
                    }
                </div>


                <!-- Settings -->
                <div class="space-y-4">
                    <div >

                        <CustomLabel ForId="category-description" For="@(() => addCategory.Description)"></CustomLabel>
                        <InputTextArea @bind-Value="addCategory.Description" id="category-description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                   
                    </div>

                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => addCategory.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="addCategory.Visible" Name="status">
                           <InsertUpdateVisible/>
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => addCategory.Visible)" class="validate" />
                    </div>

                </div>
            </div>

          
            <!-- Form Actions -->
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
              @*   <button type="reset" class="px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                    انصراف
                </button> *@
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره دسته‌بندی
                </button>
            </div>
        </div>
    </EditForm>
</main>
@code {
    private AddCategory? addCategory { get; set; } = new() { Visible=true};
    public List<ResultCategory>? ResultCategorys1 { get; set; } = new List<ResultCategory>();
    public List<ResultCategory>? ResultCategorys2 { get; set; } = new List<ResultCategory>();
    public List<ResultUploadFile> ResultUploadImages { get; set; } = new List<ResultUploadFile>();

    MultipartFormDataContent content;

    protected async override Task OnInitializedAsync()
    {
        var resdata = await RootApiResultCategorys.RunMethodApi($"Categorys/ParentID", null, method: Method.Get);
        ResultCategorys1 = resdata.Entities.ToList();
    }

    private async Task GetCategoryParent2Async()
    {
        var resdata = await RootApiResultCategorys.RunMethodApi($"Categorys/ParentID?ParentID={addCategory.ParentID1}", null, method: Method.Get);
        ResultCategorys2 = resdata.Entities.ToList();
    }
    private async Task AddAsync()
    {


        var resdata = await RootApiAddCategory.RunMethodApi("Categorys", addCategory, method: Method.Post);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);

            addCategory = new AddCategory
            {
                Visible=true
            };
            
            }
            else
            {
                var result2 = await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "پیام",
                        Text = resdata.Message,
                        Icon = resdata.Status,
                        ShowConfirmButton = true,
                    });
            }
        

    }
    private void GoBack()
    {
        NavManager.NavigateTo("/Category");
    }
}

