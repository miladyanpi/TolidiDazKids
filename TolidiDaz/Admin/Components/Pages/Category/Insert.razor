@page "/InsertCategory"
@using Admin.Services.Category
@inject CategoryService _CategoryService
<AccessAdminRoles />

<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">افزودن دسته‌بندی جدید</h2>
            <p class="text-gray-600 dark:text-gray-400">اطلاعات دسته‌بندی جدید را وارد نمایید</p>
        </div>
        <BackButton UrlPage="Category" />
    </div>

    <!-- Add category form -->
    <EditForm Model="_CategoryService.addCategory" OnValidSubmit="HandleSubmitAsync" FormName="AddForm">
        <DataAnnotationsValidator />

        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم اطلاعات دسته‌بندی
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Info -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="category-name" For="@(() => _CategoryService.addCategory.Title)"></CustomLabel>
                        <ValidationMessage For="@(() => _CategoryService.addCategory.Title)" class="validate" />
                        <InputText id="category-name" @bind-Value="_CategoryService.addCategory.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>

                    <div>
                        <CustomLabel ForId="category-slug" For="@(() => _CategoryService.addCategory.Slug)"></CustomLabel>
                        <ValidationMessage For="@(() => _CategoryService.addCategory.Slug)" class="validate" />
                        <InputText id="category-slug" @bind-Value="_CategoryService.addCategory.Slug" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>

                    <div>

                        <CustomLabel ForId="category-parent" For="@(() => _CategoryService.addCategory.ParentID1)"></CustomLabel>
                        <ValidationMessage For="@(() => _CategoryService.addCategory.ParentID1)" class="validate" />
                        <InputSelect @bind-Value="_CategoryService.addCategory.ParentID1" @bind-Value:after="@( () => _CategoryService.GetCategoryParent2InAdd())" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            <option value="0">بدون والد (دسته اصلی)</option>
                            @foreach (var item in _CategoryService.ResultCategorys1)
                            {
                                <option value="@item.ID">@item.Title</option>
                            }
                        </InputSelect>

                    </div>
                    @if (_CategoryService.addCategory.ParentID1 > 0)
                    {
                        <div>

                            <CustomLabel ForId="category-parent" For="@(() => _CategoryService.addCategory.ParentID2)"></CustomLabel>
                            <ValidationMessage For="@(() => _CategoryService.addCategory.ParentID2)" class="validate" />
                            <InputSelect @bind-Value="_CategoryService.addCategory.ParentID2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                <option value="0">بدون والد (دسته اصلی)</option>
                                @foreach (var item in _CategoryService.ResultCategorys2)
                                {
                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>

                        </div>
                    }
                    else
                    {
                        <div></div>
                    }
                </div>


                <!-- Settings -->
                <div class="space-y-4">
                    <div >

                        <CustomLabel ForId="category-description" For="@(() => _CategoryService.addCategory.Description)"></CustomLabel>
                        <InputTextArea @bind-Value="_CategoryService.addCategory.Description" id="category-description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                   
                    </div>

                    <div class="mb-4">
                        <CustomLabel ForId="Visible-stock" For="@(() => _CategoryService.addCategory.Visible)"></CustomLabel>
                        <InputRadioGroup @bind-Value="_CategoryService.addCategory.Visible" Name="status">
                           <InsertUpdateVisible/>
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => _CategoryService.addCategory.Visible)" class="validate" />
                    </div>

                </div>
            </div>

          
             <SaveButton Disabled="@isSubmitting" />
        </div>
    </EditForm>
</main>
@code{
        private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await _CategoryService.GetAllDataAsync();
    }
     private async Task HandleSubmitAsync()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
           

            await _CategoryService.AddAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}