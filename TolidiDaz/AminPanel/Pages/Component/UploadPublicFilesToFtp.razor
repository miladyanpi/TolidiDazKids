@using System.Net.Http.Headers
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFile
@inject SweetAlertService Swal
<label>@Title</label>
@if (Uploading)
{
    <div class="text-center my-3">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">در حال آپلود...</span>
        </div>
        <p class="mt-2">لطفاً منتظر بمانید، در حال آپلود فایل...</p>
    </div>
}


else
{
    <div class="form-group " style="margin:20px">
    <label class="block">
        <span class="sr-only">انتخاب تصویر</span>
            <InputFile type="file" id="category-image" accept="@StaticFileAccept" OnChange="UploadFile" Class="block w-full text-sm text-gray-500
                              file:mr-4 file:py-2 file:px-4
                              file:rounded-lg file:border-0
                              file:text-sm file:font-semibold
                              file:bg-primary-50 file:text-primary-700
                              hover:file:bg-primary-100
                              dark:file:bg-primary-900 dark:file:text-primary-300
                              dark:hover:file:bg-primary-800" />
    </label>
</div>
@* 
    <div class="form-group ">
        <CustomLabel For="@(() => resultUploadFile.Title)"></CustomLabel>
        <label style="color:red">@Message</label>
        <InputText @bind-Value="resultUploadFile.Title" class="form-control" />
    </div>
    <div class="form-group ">
        <label>انتخاب فایل</label>
        <InputFile type="file" OnChange="UploadFile" accept="@StaticFileAccept" />
    </div>
    <hr /> *@
}

@code {
    public string? Message { get; set; } = string.Empty;
    public ResultUploadFile resultUploadFile { get; set; } = new();
    public List<ResultUploadFile> ResultUploadFiles { get; set; } = new List<ResultUploadFile>();
    [Parameter]
    public EventCallback<List<ResultUploadFile>> OnChangeUpload { get; set; }
    [Parameter]
    public string? StaticFileAccept { get; set; }
    [Parameter]
    public string? Title { get; set; }
    private long maxFileSize = 1024 * 1024 * 1024;
    bool Uploading = false;
    public async Task UploadFile(InputFileChangeEventArgs e)
    {
      
        Uploading = true;
        var files = e.GetMultipleFiles();
        foreach (var file in files)
        {
            if (file != null)
            {
                var fileContent =
                           new StreamContent(file.OpenReadStream(maxFileSize));

                var content = new MultipartFormDataContent();
                content.Headers.ContentDisposition = new ContentDispositionHeaderValue("form-data");
                content.Add(fileContent, file.ContentType, file.Name);

                var resdataUploadFile = await RootApiResultUploadFile.UploadImage($"Ftp/UploadFiles/OtherAllFiles", content, method: Method.Post);
                await JS.CallAlertToast(resdataUploadFile.Message);
                var data = resdataUploadFile.Entities.First();
                data.Title = resultUploadFile.Title;
                ResultUploadFiles.Add(data);
                if (resdataUploadFile.Status == ResultMessageApi.Success)
                {
                    await OnChangeUpload.InvokeAsync(ResultUploadFiles);
                }
                else
                {
                   _ = await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "پیام",
                        Text = resdataUploadFile.Message,
                        Icon = resdataUploadFile.Status,
                        ShowConfirmButton = true,
                    });
                }
            }
        }
        Uploading = false;
        StateHasChanged();


        ResultUploadFiles.Clear();

    }
}



