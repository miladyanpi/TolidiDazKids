@code {
    public UpdateCategory? updateCategory { get; set; } = new();
    private PagingModel pagingModel { get; set; } = new();
    private ResultCategory resultCategory { get; set; } = new();
    private List<ResultCategory>? ResultCategorys { get; set; } = new List<ResultCategory>();
    private List<int> expandedRows { get; set; } = new List<int>();
    private List<int> expandedRowsLevel3 { get; set; } = new List<int>();
    public int ID { get; set; } = 0;

    protected async override Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = Base.GetCountShowRecord();
        await GetData();
    }

    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();
    }
    private async Task GetData(string? SearchText = "")
    {
        var Search = Base.GetSearchText(SearchText);
        var resdata = await RootApiGet.RunMethodApi($"Categorys?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&ParentID={null}", null, method: Method.Get);
        decimal Count = resdata.CountAllRecordTable;
        ResultCategorys = resdata.Entities.ToList();
        pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
        pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
    }
    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {
            DeleteUploadFile deleteUploadFile = new DeleteUploadFile();
            var dataTemp = ResultCategorys.Where(s => s.ID == ID).FirstOrDefault();

            var resultUploadFiles = dataTemp!=null&& dataTemp.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(dataTemp.JsonPicture) : new List<ResultUploadFile>();
            deleteUploadFile.ResultUploadFiles = resultUploadFiles;
            deleteUploadFile.ID = ID;

            var resdata = await RootApiDelete.RunMethodApi($"Categorys/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {
                _ = await RootApiResultUploadFiles.RunMethodApi($"DeleteFile/MultiFiles", deleteUploadFile, method: Method.Post);

                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }

    private async Task ListFiles(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID", id.ToString()},


        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/CategoryFiles", parameter!));
    }
    private void GoToInsert()
    {
        NavManager.NavigateTo("/InsertCategory", forceLoad: true);
    }
    private void GoToUpdate(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID", id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/UpdateCategory", parameter!));
    }
    private void ToggleSubTable(int id)
    {
        if (expandedRows.Contains(id))
        {
            expandedRows.Remove(id);
            // Optionally clear third-level expanded rows when collapsing second-level
            expandedRowsLevel3.Clear();
        }
        else
        {
            expandedRows.Add(id);
        }
    }

    private void ToggleSubTableLevel3(int id)
    {
        if (expandedRowsLevel3.Contains(id))
        {
            expandedRowsLevel3.Remove(id);
        }
        else
        {
            expandedRowsLevel3.Add(id);
        }
    }
}