

@page "/Category"
@using AdminPanel.Services
@using Dto.Models
@using Dto.Models.DtoCategory
@using Dto.Models.DtoUploadFile
@using Newtonsoft.Json
@inject SweetAlertService Swal
@inject NavigationManager NavManager
