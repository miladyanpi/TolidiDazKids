@code {
    int ProductCounAll = 0;
    int ProductCounAllToday = 0;
    int CustomerCount = 0;
    int OrderCount = 0;
    int OrdorderCountDelivereder = 0;
    int percentOrdorderCountDelivereder = 0;
    string? OrdorderCountDeliverederTitle = string.Empty;
    Int64 OrderSumFinalPriceToday = 0;
    Int64 OrderSumFinalPriceYesterday = 0;
    Int64 OrderSumFinalPricePercent = 0;
    string OrderSumFinalPricePercentTitle = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        var resdata = await RootApiGetResultReportDashboard.RunMethodApi($"Report/Count", null, method: Method.Get);
        ProductCounAll = resdata.Entity.ProductCounAll;
        ProductCounAllToday = resdata.Entity.ProductCounAllToday;
        CustomerCount = resdata.Entity.CustomerCount;
        OrderCount = resdata.Entity.OrderCount;
        OrderSumFinalPriceToday = resdata.Entity.OrderSumFinalPriceToday;
        OrderSumFinalPriceYesterday = resdata.Entity.OrderSumFinalPriceYesterday;
        OrderSumFinalPricePercent = OrderSumFinalPriceYesterday==0?0:((OrderSumFinalPriceToday - OrderSumFinalPriceYesterday) / OrderSumFinalPriceYesterday) * 100;
        if (OrderSumFinalPricePercent > 0)
        {
            OrderSumFinalPricePercentTitle = "افزایش";
        }
        else if (OrderSumFinalPricePercent < 0)
        {
            OrderSumFinalPricePercentTitle = "کاهش";
        }
        else
        {
            OrderSumFinalPricePercentTitle = "بدون تغییر";
        }

        OrdorderCountDelivereder = resdata.Entity.OrdorderCountDelivereder;
        percentOrdorderCountDelivereder = OrderCount==0?0:(OrdorderCountDelivereder / OrderCount) * 100;
        if (percentOrdorderCountDelivereder <= 25)
        {
            string? OrdorderCountDeliverederTitle = "سطح ضعیف";
        }
        else if (percentOrdorderCountDelivereder > 25 && percentOrdorderCountDelivereder <= 50)
        {
            string? OrdorderCountDeliverederTitle = "سطح متوسط";
        }
        else if (percentOrdorderCountDelivereder > 50 && percentOrdorderCountDelivereder <= 75)
        {
            string? OrdorderCountDeliverederTitle = "سطح خوب";
        }
        else if (percentOrdorderCountDelivereder > 75 && percentOrdorderCountDelivereder <= 100)
        {
            string? OrdorderCountDeliverederTitle = "سطح عالی";
        }

    }
}
