@page "/UpdateCustomer"
@using Dto.Models.DtoAccount
@using Dto.Models.DtoCustomer
@using Dto.Models.DtoCustomer
@using Dto.Models.DtoUploadFile
@using System.Net.Http.Headers
@using Newtonsoft.Json
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntity<UpdateCustomer>> RootApiUpdateCustomer
@inject IRootApi<ResponseApiEntities<ResultRole>> RootApiResultRole
@inject IRootApi<ResponseApiEntities<ResultCustomer>> RootApiResultCustomers
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFile
@inject IRootApi<ResponseApiEntities<ResultCustomer>> RootApiResultCustomers
@inject IRootApi<ResponseApiEntity<AddUser>> RootApiAddUser


<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">ویرایش مشخصات کاربر</h2>
            <p class="text-gray-600 dark:text-gray-400">مشخصات کاربر را ویرایش نمایید</p>
        </div>
        <div class="mt-4 md:mt-0">
            <button @onclick="GoBack" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 shadow-sm dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                بازگشت
            </button>
        </div>
    </div>

    <!-- Add category form -->
    <EditForm Model="updateCustomer" OnValidSubmit="Update" FormName="UpdateForm">
        <DataAnnotationsValidator />
        <div class="bg-white py-6 space-y-4 dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
            <div class="px-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                    فرم مشخصات کاربر
                </h3>
            </div>

            <div class="px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Customer Info -->
                <div class="space-y-4">


                    <div>
                        <CustomLabel ForId="Customer-name" For="@(() => updateCustomer.Name)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.Name)" class="validate" />
                        <InputText id="Customer-name" @bind-Value="updateCustomer.Name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Customer-LastName" For="@(() => updateCustomer.LastName)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.LastName)" class="validate" />
                        <InputText id="Customer-LastName" @bind-Value="updateCustomer.LastName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div class="form-group ">
                        <CustomLabel For="@(() => updateCustomer.BirthDate)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.BirthDate)" class="validate" />
                        <InputPersianDatePicker @bind-Value="updateCustomer.BirthDate"
                                                MinDateSetOnToday="false"
                                                Placeholder="تاریخ تولد"
                                                CssClass="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Customer-Mobile" For="@(() => updateCustomer.Mobile)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.Mobile)" class="validate" />
                        <InputText id="Customer-Mobile" @bind-Value="updateCustomer.Mobile" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                   
                    <div class="mb-4">
                        <CustomLabel ForId="Customer-stock" For="@(() => updateCustomer.Gender)"></CustomLabel>

                        <InputRadioGroup @bind-Value="updateCustomer.Gender" Name="stock-status">
                            <div class="flex flex-row items-center space-x-6">

                                <div class="flex items-center">
                                    <InputRadio o Value="@Dto.Enum.EnumConstant.Gender.Man"
                                                id="in-stock"
                                                class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                    <label for="in-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">مرد</label>
                                </div>

                                <div class="flex items-center">
                                    <InputRadio Value="@Dto.Enum.EnumConstant.Gender.Woman"
                                                id="out-of-stock"
                                                class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                    <label for="out-of-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">زن</label>
                                </div>

                            </div>
                        </InputRadioGroup>

                        <ValidationMessage For="@(() => updateCustomer.Gender)" class="validate" />
                    </div>

                </div>


                <!-- Settings -->
                <div class="space-y-4">
                    <div>
                        <CustomLabel ForId="Customer-UserName" For="@(() => updateCustomer.UserName)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.UserName)" class="validate" />
                        <InputText id="Customer-UserName" @bind-Value="updateCustomer.UserName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Customer-Email" For="@(() => updateCustomer.Email)"></CustomLabel>
                        <ValidationMessage For="@(() => updateCustomer.Email)" class="validate" />
                        <InputText id="Customer-Email" @bind-Value="updateCustomer.Email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div>
                        <CustomLabel ForId="Customer-description" For="@(() => updateCustomer.Description)"></CustomLabel>
                        <InputTextArea @bind-Value="updateCustomer.Description" id="Customer-description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">وضعیت*</label>
                        <InputRadioGroup @bind-Value="updateCustomer.Visible" Name="status">
                            <InsertUpdateVisible />
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => updateCustomer.Visible)" class="validate" />
                    </div>

                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                    ذخیره
                </button>

            </div>
        </div>

    </EditForm>
</main>
@code {
    private UpdateCustomer? updateCustomer { get; set; } = new() { Visible = true, Gender = EnumConstant.Gender.NotDefine };
    private List<ResultRole> ResultRoles = new List<ResultRole>();
    public List<ResultUploadFile> ResultUploadImages { get; set; } = new List<ResultUploadFile>();
    [SupplyParameterFromQuery]
    public int ID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await GetData();

    }
    private async Task Update()
    {
        var resdata = await RootApiUpdateCustomer.RunMethodApi("Customers", updateCustomer, method: Method.Patch);
        if (resdata.Status == ResultMessageApi.Success)
        {
            await JS.CallAlertToast(resdata.Message);
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }


    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateCustomer.RunMethodApi($"Customers/{ID}", null, method: Method.Get);
        updateCustomer = resdataEdit.Entity;


    }
    private void GoBack()
    {
        NavManager.NavigateTo("/Customer");
    }
  
}

