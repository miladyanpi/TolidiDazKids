@page "/Order"
@using Dto.Models.DtoOrder
@using Dto.Models.DtoProvince
@using Newtonsoft.Json
@using System.ComponentModel
@using static Dto.Enum.EnumConstant
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject IToastMessage JS
@inject IRootApi<ResponseApiEntities<ResultOrder>> RootApiGet
@inject IRootApi<ResponseApiEntity<ResultOrder>> RootApiDelete
@inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFiles

@attribute [Authorize()]

<!-- page content -->
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-gray-900">
    <!-- header page -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">مدیریت سفارشات</h2>
            <p class="text-gray-600 dark:text-gray-400">لیست تمام سفارشات ثبت شده در سیستم</p>
        </div>
        <div class="mt-4 md:mt-0">
            <div class="relative">
                <input type="text" placeholder="جستجوی سفارش..." class="w-full md:w-64 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-3 top-2.5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Orders table -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 overflow-hidden border border-gray-200 dark:border-gray-700">
        <!-- Filters -->
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center space-x-4">
                <div>
            

                    <CustomLabel For="@(() => OrderStatusID)"></CustomLabel>
                    <InputSelect @bind-Value="OrderStatusID" @bind-Value:after="@(async ()=>await GetData())" class="w-full md:w-40 px-3 py-1.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white text-sm">
                        @foreach (var item in OrderStatuses)
                        {
                            <option value="@item.ID">@item.Title</option>
                        }
                    </InputSelect>
                </div>
            
            </div>
            <button class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
                </svg>
                فیلترها
            </button>
        </div>

        <!-- Orders list -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                           ردیف
                        </th>
                        <th scope="col" class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.OrderCode)"></CustomLabel>
                        </th>

                        <th scope="col" class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.ResultCustomer.Name)"></CustomLabel>
                        </th>

                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.RegisterDate)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.TotalAmount)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.Discount)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.FinalAmount)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.OrderStatus)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            <CustomLabel For="@(() => resultOrder.PaymentStatus)"></CustomLabel>
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            روش پرداخت
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            اقدامات
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    @{
                        decimal i = (pagingModel.Page - 1) * pagingModel.Take;

                    }
                    @foreach(var item in ResultOrders)
                    {
                        i++;
                        decimal k = i;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@k</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.OrderCode</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        <img class="h-10 w-10 rounded-full" src="assets/images/user/user.jpg" alt="">
                                    </div>
                                    <div class="mr-4">
                                        <div class="text-sm font-medium text-gray-900 dark:text-white">@item.ResultCustomer.Name @item.ResultCustomer.LastName</div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">@item.ResultCustomer.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900 dark:text-white">@item.RegisterDate</div>
                                <div class="text-sm text-gray-500 dark:text-gray-400">@item.RegisterTime</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.TotalAmount.ToString("N0") تومان</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.Discount.ToString("N0") </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 dark:text-white">@item.FinalAmount.ToString("N0") تومان</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @GetStatusClass(item.OrderStatus2)" >
                                        @item.OrderStatus
                                    </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                    @item.PaymentStatus
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900 dark:text-white">آنلاین</div>
                                <div class="text-sm text-gray-500 dark:text-gray-400">موفق</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex space-x-2">
                                    <button @onclick="() => GoToOrderDetails(item.ID)" class="text-primary-600 hover:text-primary-900 dark:text-primary-400 dark:hover:text-primary-300">مشاهده</button>
                                    <a href="/Factor?ID=@item.ID" target="_blank" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300">چاپ فاکتور</a>
                                    @* <a href="#" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300">پیگیری</a> *@
                                </div>
                            </td>
                        </tr>
                    }
                 

                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <Pagination pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />
    </div>
</main>


@code {
    public EnumComponentName.ComponentNameType ComponentNameType { get; set; } = EnumComponentName.ComponentNameType.Insert;

    private PagingModel pagingModel { get; set; } = new();
    private ResultOrder resultOrder { get; set; } = new();
    private List<ResultOrder>? ResultOrders { get; set; } = new List<ResultOrder>();
    public List<(string Title, OrderStatus ID)> OrderStatuses = new List<(string, OrderStatus)>();
    [DisplayName("وضعیت سفارش")]
    public OrderStatus? OrderStatusID { get; set; }
    protected async override Task OnInitializedAsync()
    {
        var item0 = ("همه", EnumConstant.OrderStatus.All);
        var item1 = ("درحال بررسی", EnumConstant.OrderStatus.pending);
        var item2 = ("ارسال شده", EnumConstant.OrderStatus.shipped);
        var item3 = ("تحویل داده شده", EnumConstant.OrderStatus.delivered);
        var item4 = ("لغو شده", EnumConstant.OrderStatus.canceled);
        OrderStatuses.Add(item0);
        OrderStatuses.Add(item1);
        OrderStatuses.Add(item2);
        OrderStatuses.Add(item3);
        OrderStatuses.Add(item4);
        OrderStatusID =EnumConstant.OrderStatus.All;
        pagingModel.Page = 1;
        pagingModel.Take = Base.GetCountShowRecord();
        await GetData();
    }

    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();
    }

    private async Task GetData(string? SearchText = "")
    {
        var Search = Base.GetSearchText(SearchText);
        var resdata = await RootApiGet.RunMethodApi($"Orders?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&OrderStatus={OrderStatusID}", null, method: Method.Get);
        decimal Count = resdata.CountAllRecordTable;
        ResultOrders = resdata.Entities.ToList();
        pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
        pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
    }

    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {

            var resdata = await RootApiDelete.RunMethodApi($"Orders/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {
                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }


    
    private void GoToInsert()
    {
        NavManager.NavigateTo("/InsertOrder", forceLoad: true);
    }
    private void GoToUpdate(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID", id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/UpdateOrder", parameter!));
    }
  
    private void GoToOrderDetails(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID",id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/OrderDetails", parameter!));
    }
    private void GoToFactor(int id)
    {
        var parameter = new Dictionary<string, object>
        {
            {"ID",id.ToString()},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Factor", parameter!));
    }
    string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.pending => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200",
        OrderStatus.shipped => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200",
        OrderStatus.delivered => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
        OrderStatus.canceled => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200",
        _ => "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
    };
}