                            <InputNumber id="product-price" @bind-Value="updateProduct.Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel ForId="product-discount" For="@(() => updateProduct.Discount)"></CustomLabel>(تومان)
                            <ValidationMessage For="@(() => updateProduct.Discount)" class="validate" />
                            <InputNumber id="product-discount" @bind-Value="updateProduct.Discount" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel ForId="product-stock" For="@(() => updateProduct.Count)"></CustomLabel>
                            <ValidationMessage For="@(() => updateProduct.Count)" class="validate" />
                            <InputNumber id="product-stock" @bind-Value="updateProduct.Count" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <CustomLabel ForId="product-sku" For="@(() => updateProduct.SkuCode)"></CustomLabel>
                            <ValidationMessage For="@(() => updateProduct.SkuCode)" class="validate" />
                            <InputText id="product-sku" @bind-Value="updateProduct.SkuCode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">وضعیت موجودی*</label>

                            <InputRadioGroup @bind-Value="updateProduct.ProductExistStatus" Name="stock-status">
                                <div class="flex flex-row items-center space-x-6">

                                    <div class="flex items-center">
                                        <InputRadio o Value="@Dto.Enum.EnumConstant.ProductExistStatus.Existent"
                                                    id="in-stock"
                                                    class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                        <label for="in-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">موجود</label>
                                    </div>

                                    <div class="flex items-center">
                                        <InputRadio Value="@Dto.Enum.EnumConstant.ProductExistStatus.Nonexistent"
                                                    id="out-of-stock"
                                                    class="h-4 w-4 text-primary focus:ring-primary border-gray-300 dark:bg-gray-700 dark:border-gray-600" />
                                        <label for="out-of-stock" class="ml-3 block text-sm text-gray-700 dark:text-gray-300 ms-1">ناموجود</label>
                                    </div>

                                </div>
                            </InputRadioGroup>

                            <ValidationMessage For="@(() => updateProduct.ProductExistStatus)" class="validate" />
                        </div>

                        <div class="mb-4">
                            <CustomLabel ForId="Visible-stock" For="@(() => updateProduct.Visible)"></CustomLabel>
                            <InputRadioGroup @bind-Value="updateProduct.Visible" Name="status">
                                <InsertUpdateVisible />
                            </InputRadioGroup>
                            <ValidationMessage For="@(() => updateProduct.Visible)" class="validate" />
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-4">
                    <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-500 shadow-sm dark:bg-primary-500 dark:hover:bg-primary-600">
                        ذخیره دسته‌بندی
                    </button>
                </div>
            </div>

            <!-- Right column - Publish and attributes -->
            <div class="space-y-6">
                <!-- Publish card -->
                @*   <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-700 p-6 border border-gray-200 dark:border-gray-700">
                    <h3 class="font-bold text-lg mb-6 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary-600 after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary-600 after:rounded-lg">انتشار</h3>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">وضعیت انتشار</label>
                            <select class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white">
