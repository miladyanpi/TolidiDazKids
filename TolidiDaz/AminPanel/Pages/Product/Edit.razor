@code {
    @inject CategoryService _CategoryService
    @inject SweetAlertService Swal
    @inject NavigationManager NavManager
    @inject IToastMessage JS
    @inject IRootApi<ResponseApiEntity<UpdateProduct>> RootApiUpdateProduct
    @inject IRootApi<ResponseApiEntity<UpdateCategory>> RootApiUpdateCategory
    @inject IRootApi<ResponseApiEntities<ResultProduct>> RootApiResultProducts
    @inject IRootApi<ResponseApiEntities<ResultProductFeature>> RootApiResultProductFeature
    @inject IRootApi<ResponseApiEntities<AddProductFeatureValue>> RootApiAddProductFeatureValue
    @inject IRootApi<ResponseApiEntities<UpdateProductFeatureValue>> RootApiUpdateProductFeatureValue
    @inject IRootApi<ResponseApiEntities<ResultUploadFile>> RootApiResultUploadFile
    @inject IRootApi<ResponseApiEntities<ResultCategory>> RootApiResultCategorys
    private AddCategory? addCategory { get; set; } = new() { Visible = true };
    private UpdateProduct? updateProduct { get; set; } = new() { Visible = true, ProductExistStatus = Dto.Enum.EnumConstant.ProductExistStatus.Existent };
    public List<ResultUploadFile> ResultUploadImages { get; set; } = new List<ResultUploadFile>();
    public List<AddProductFeatureValue> AddProductFeatureValues { get; set; } = new List<AddProductFeatureValue>();
    public List<UpdateProductFeatureValue> UpdateProductFeatureValues { get; set; } = new List<UpdateProductFeatureValue>();

    [SupplyParameterFromQuery]
    public int ID { get; set; }
   
    protected async override Task OnInitializedAsync()
    {
        await _CategoryService.GetInitialData();
        await GetData();

    }
    private async Task Update()
    {
        updateProduct.CategoryID = _CategoryService.CategoryID;
        if (updateProduct.CategoryID == null)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "دسته بندی سطح 3 را انتخاب کنید",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;
        }
        if (updateProduct.Discount > updateProduct.Price)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "تخفیف نمیتونه بیشتر از قیمت اصلی باشه",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;
        }
        if (updateProduct.Price == 0)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "قیمت اصلی نمیتونه صفر باشه",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;

        }
        if (updateProduct.Count <= 0)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "تعداد نمیتونه صفر باشه",
                Icon = ResultMessageApi.Error,
                ShowConfirmButton = true,
            });
            return;

        }
        var resdata = await RootApiUpdateProduct.RunMethodApi("Products", updateProduct, method: Method.Patch);
        if (resdata.Status == ResultMessageApi.Success)
        {
            if (AddProductFeatureValues.Count > 0)
            {
                var resdataProductFeatureValues = await RootApiAddProductFeatureValue.RunMethodApi("ProductFeatureValues/List", AddProductFeatureValues, method: Method.Post);
                AddProductFeatureValues.Clear();
            }
            if (UpdateProductFeatureValues.Count > 0)
            {
                var resdataProductFeatureValues = await RootApiUpdateProductFeatureValue.RunMethodApi("ProductFeatureValues/List", UpdateProductFeatureValues, method: Method.Patch);

            }
            await JS.CallAlertToast(resdata.Message);
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
            await GetData();

        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }
    }
    public async Task GetData()
    {
        var resdataEdit = await RootApiUpdateProduct.RunMethodApi($"Products/{ID}", null, method: Method.Get);
        updateProduct = resdataEdit.Entity;

        var resdataProductFeatureValue = await RootApiUpdateProductFeatureValue.RunMethodApi($"ProductFeatureValues/All/{updateProduct.ID}", null, method: Method.Get);
        UpdateProductFeatureValues = resdataProductFeatureValue.Entities.ToList();
        var resdataProductFeature = await RootApiResultProductFeature.RunMethodApi($"ProductFeatures/All/{updateProduct.CategoryID}", null, method: Method.Get);
        var ResultProductFeatures = resdataProductFeature.Entities.ToList();
        if (UpdateProductFeatureValues.Count == 0)
        {
            foreach (var item in ResultProductFeatures)
            {
                AddProductFeatureValues.Add(new AddProductFeatureValue
                {
                    ResultProductFeature = item,
                    Value = null,
                    ProductID = updateProduct.ID,
                    ProductFeatureID = item.ID,
                });
            }
        }
        else if (UpdateProductFeatureValues.Count != ResultProductFeatures.Count)
        {
            foreach (var item in ResultProductFeatures)
            {
                if (UpdateProductFeatureValues.Where(s => s.ProductFeatureID == item.ID).FirstOrDefault() == null)
                {
                    AddProductFeatureValues.Add(new AddProductFeatureValue
                    {
                        ResultProductFeature = item,
                        Value = null,
                        ProductID = updateProduct.ID,
                        ProductFeatureID = item.ID,
                    });
                }

            }
        }


    }
    private void GoBack()
    {
        NavManager.NavigateTo("/Product");
    }
}

