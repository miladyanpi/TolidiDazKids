                                    <option value="@item.ID">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div>

                            <CustomLabel ForId="ProductFeature-category3" For="@(() => _CategoryService.CategoryID)"></CustomLabel>
                            <InputSelect @bind-Value="_CategoryService.CategoryID" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary outline-0 focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                @foreach (var item in _CategoryService.ResultCategorys3)
