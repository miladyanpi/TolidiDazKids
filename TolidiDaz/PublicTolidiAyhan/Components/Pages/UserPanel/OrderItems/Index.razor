@page "/OrderItems"
@using Dto.Models

@using Dto.Models.DtoOrderItem
@attribute [Authorize(Roles = ConstantRoles.CustomerName + "," + ConstantRoles.BranchStoreName)]
@inject NavigationManager NavManager
<!-- main content -->
<div class="flex flex-col flex-1 overflow-hidden">
    <!-- page content -->
    <main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-background-dark">

        <!-- List of orders -->
        <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark overflow-hidden mb-6 border border-gray-100 dark:border-gray-700">
            <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">جزئیات سفارش</h3>
                <div class="flex items-center space-x-2 space-x-reverse">
                    <button class="px-3 py-1 text-xs font-medium rounded-lg bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-dark">همه</button>
                    <button class="px-3 py-1 text-xs font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">در حال پردازش</button>
                    <button class="px-3 py-1 text-xs font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">ارسال شده</button>
                    <a  href="/Order" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-red-200 text-red-700 hover:bg-red-300 shadow-sm dark:bg-red-700 dark:text-white dark:hover:bg-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                        </svg>
                        بازگشت
                    </a>

                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">ردیف</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.ResultProduct.Title)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.Quantity)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.PriceAtOrder)"></CustomLabel>(تومان)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.FinalAmount)"></CustomLabel>(تومان)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.RegisterDate)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrderItem.RegisterTime)"></CustomLabel></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-card-dark divide-y divide-gray-200 dark:divide-gray-700">
                        @{
                            decimal i = (pagingModel.Page - 1) * pagingModel.Take;
                        }
                        @foreach (var item in resultOrderItems)
                        {
                            i++;
                            decimal k = i;
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@k</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.ResultProduct.Title</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.Quantity</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.PriceAtOrder.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.FinalAmount.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.RegisterDate</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.RegisterTime</td>


                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        <TolidiAyhan.Pages.Shop.Pagination pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />

           @*  <div class="p-4 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <p class="text-sm text-gray-500 dark:text-gray-400">نمایش 1 تا 6 از 12 سفارش</p>
                <div class="flex space-x-2 space-x-2">
                    <button class="px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 disabled:opacity-50" disabled>
                        قبلی
                    </button>
                    <button class="px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 bg-primary text-white hover:bg-primary/90 dark:bg-primary-dark dark:hover:bg-primary/80">
                        1
                    </button>
                    <button class="px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                        2
                    </button>
                    <button class="px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                        بعدی
                    </button>
                </div>
            </div> *@
        </div>

        <!-- Order tracking -->
        <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 mb-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">پیگیری سفارش</h3>
            <div class="flex">
                <input type="text" class="flex-1 border rounded-r-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-white placeholder-gray-500" placeholder="شماره سفارش خود را وارد کنید">
                <button class="bg-primary text-white px-4 py-2 rounded-l-lg hover:bg-primary/90 dark:bg-primary-dark dark:hover:bg-primary/80 transition-colors">
                    پیگیری
                </button>
            </div>
        </div>

        <!-- Order status guide -->
        <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">راهنمای وضعیت سفارشات</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
                    <div class="flex items-center mb-2">
                        <span class="w-3 h-3 rounded-full bg-yellow-500 ml-2"></span>
                        <span class="text-sm font-bold text-dark dark:text-light">در انتظار پرداخت</span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">سفارش شما ثبت شده اما پرداخت انجام نشده است</p>
                </div>
                <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
                    <div class="flex items-center mb-2">
                        <span class="w-3 h-3 rounded-full bg-primary dark:bg-primary-dark ml-2"></span>
                        <span class="text-sm font-bold text-dark dark:text-light">در حال بررسی</span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">سفارش شما در حال آماده‌سازی است</p>
                </div>
                <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
                    <div class="flex items-center mb-2">
                        <span class="w-3 h-3 rounded-full bg-blue-500 ml-2"></span>
                        <span class="text-sm font-bold text-dark dark:text-light">در حال ارسال</span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">سفارش شما ارسال شده و در راه است</p>
                </div>
                <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
                    <div class="flex items-center mb-2">
                        <span class="w-3 h-3 rounded-full bg-green-500 ml-2"></span>
                        <span class="text-sm font-bold text-dark dark:text-light">تحویل شده</span>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">سفارش شما با موفقیت تحویل داده شده است</p>
                </div>
            </div>
        </div>
    </main>
</div>



@code {
    @inject IRootApi<ResponseApiEntities<ResultOrderItem>> RootApiGet
    private PagingModel pagingModel { get; set; } = new();
    List<ResultOrderItem> resultOrderItems = new();
    ResultOrderItem resultOrderItem = new();
    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = 15;
        await GetData();
    }
    private async Task GetData(string? SearchText = "")
    {
        var data2 = await RootApiGet.RunMethodApi($"OrderItems/Public/Paging?Page={pagingModel.Page}&Take={pagingModel.Take}&Code={Code}", null, method: Method.Get);
        if (data2!=null&&data2.Status == ResultMessageApi.Success)
        {
            resultOrderItems = data2.Entities.ToList();
            decimal Count = data2.CountAllRecordTable;
            pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
            pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
        }
    }
    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();

    }
  
}
