        <!-- List of orders -->
        <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark overflow-hidden mb-6 border border-gray-100 dark:border-gray-700">
            <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <h3 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">سفارشات اخیر</h3>
                <div class="flex items-center space-x-2 space-x-reverse">
                    <button class="px-3 py-1 text-xs font-medium rounded-lg bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-dark">همه</button>
                    <button class="px-3 py-1 text-xs font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">در حال پردازش</button>
                    <button class="px-3 py-1 text-xs font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">ارسال شده</button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">ردیف</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.OrderCode)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.TotalAmount)"></CustomLabel>(تومان)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.Discount)"></CustomLabel>(تومان)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.FinalAmount)"></CustomLabel>(تومان)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.RefId)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.CardPen)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.RegisterDate)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.RegisterTime)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">روش ارسال محصول</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.OrderStatus)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.PaymentStatus)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultOrder.StatusDescription)"></CustomLabel></th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-card-dark divide-y divide-gray-200 dark:divide-gray-700">
                        @{
                            decimal i = (pagingModel.Page - 1) * pagingModel.Take;
                        }

                        @foreach (var item in resultOrders)
                        {
                            i++;
                            decimal k = i;
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@k</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.OrderCode</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.TotalAmount.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.Discount.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.FinalAmount.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.RefId</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.CardPen</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.RegisterDate</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.RegisterTime</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@item.ResultSendProductMethod.Title</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 rounded-full @GetStatusClass(item.OrderStatus2)">
                                        @item.OrderStatus
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 rounded-full @GetPaymentStatusClass(item.PaymentStatus2)">
                                        @item.PaymentStatus
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 rounded-full bg-green-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-200">
                                        @item.StatusDescription
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                    <button @onclick="() => GotoOrderItems(item.IdentityCode.ToString())" class="text-primary hover:text-green-700/80 dark:text-primary-dark dark:hover:text-green-700/70 flex items-center">
                                        جزئیات
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }



                    </tbody>
                </table>
            </div>
            <PaginationType1 pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />

            @* <div class="p-4 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
