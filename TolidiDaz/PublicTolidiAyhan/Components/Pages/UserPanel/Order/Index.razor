@code {
    @inject IRootApi<ResponseApiEntities<ResultOrder>> RootApiGet
    List<ResultOrder> resultOrders = new();
    ResultOrder resultOrder = new();
    @inject NavigationManager NavManager
    private PagingModel pagingModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = 15;
        await GetData();

    }
    private async Task GetData()
    {
        var data2 = await RootApiGet.RunMethodApi($"Orders/Public?Page={pagingModel.Page}&Take={pagingModel.Take}", null, method: Method.Get);
        if (data2!=null && data2.Status == ResultMessageApi.Success)
        {
            resultOrders = data2.Entities.ToList();
            decimal Count = data2.CountAllRecordTable;
            pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
            pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
        }
    }
    private async Task GotoOrderItems(string Code)
    {
        var parameter = new Dictionary<string, object>
        {
            {"Code", Code},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/OrderItems", parameter!));
    }
    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();

    }
    string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.pending => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200",
        OrderStatus.shipped => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200",
        OrderStatus.delivered => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
        OrderStatus.canceled => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200",
        OrderStatus.PendingPayment => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200",

        _ => "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
    };
    string GetPaymentStatusClass(PaymentStatus status) => status switch
    {
        PaymentStatus.PendingPayment => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200",
        PaymentStatus.Refunded => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200",
        PaymentStatus.paid => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
        PaymentStatus.failed => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200",
        PaymentStatus.Expired => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200",

        _ => "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
    };
}
