    <!-- List of products -->
    <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 mb-6 bFavoritUserProduct bFavoritUserProduct-gray-100 dark:bFavoritUserProduct-gray-700">
