            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                    @*     <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            <label class="inline-flex items-center">
                                <input type="checkbox" class="form-checkbox h-5 w-5 text-primary dark:text-primary-dark rounded bFavoritUserProduct-gray-300 dark:bFavoritUserProduct-gray-600 focus:ring-primary dark:focus:ring-primary-dark"
                                       onchange="document.querySelectorAll('tbody input[type=checkbox]').forEach(cb => cb.checked = this.checked)">
                            </label>
                        </th> *@
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">ردیف</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultFavoritUserProduct.ResultProduct.Title)"></CustomLabel></th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><CustomLabel For="@(() => resultFavoritUserProduct.ResultProduct.Price)"></CustomLabel></th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">وضعیت</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">عملیات</th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-card-dark divide-y divide-gray-200 dark:divide-gray-700">
                    @{
                        decimal i = (pagingModel.Page - 1) * pagingModel.Take;

                    }

                    @foreach (var item in resultFavoritUserProducts)
                    {
                        i++;
                        decimal k = i;
                        resultCartItem = CartService.resultCartItems.Where(s => s.ProductID == item.ID).FirstOrDefault();
                        Price = _pricingRuleService.CalculatePrice(item.ResultProduct, resultCartItem == null ? 0 : resultCartItem.Quantity, Roles, ResulLoginStatus.IsLoggedIn);

                        NewPrice = item.ResultProduct.Discount > 0 ? (Price - item.ResultProduct.Discount) : Price;
                        percent = ((float)item.ResultProduct.Discount / (float)Price) * 100;
                        percent = (float)Math.Round(percent, 2);


                        string path = string.Empty;
                        @if (item.ResultProduct.ResultUploadFiles.Count > 0)
                        {
                            path = ApiLink.FullPath + item.ResultProduct.ResultUploadFiles[0].PathFileName;
      
                        }
                        <tr>
                           @*  <td class="px-6 py-4 whitespace-nowrap">
                                <label class="inline-flex items-center">
                                    <input type="checkbox" class="form-checkbox h-5 w-5 text-primary dark:text-primary-dark rounded bFavoritUserProduct-gray-300 dark:bFavoritUserProduct-gray-600 focus:ring-primary dark:focus:ring-primary-dark">
                                </label>
                            </td> *@
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark dark:text-light">@k</td>

                            <td class="px-6 py-4 whitespace-nowrap">

                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-16 w-16">
                                        <a href="#" @onclick="@(() => GotoProductDetails(item.ResultProduct.IdentityCode.ToString()))">
                                            <img class="h-16 w-16 rounded-md object-contain" src="@path" alt="@item.ResultProduct.Title">
                                        </a>
                                    </div>
                                    <div class="mr-4">
                                        <div class="text-sm font-medium text-dark dark:text-light">@item.ResultProduct.Title (@item.ResultProduct.ProductCode)</div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">ویژگی ها:</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                
                                <div class="text-sm text-dark dark:text-light">@NewPrice.ToString("N0") تومان</div>
                                @if(item.ResultProduct.Discount>0)
                                {
                                    <div class="text-xs text-danger dark:text-danger-dark line-through">@Price.ToString("N0") تومان</div>
                                }
                               
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if(item.ResultProduct.ProductExistStatus2==ProductExistStatus.Nonexistent)
                                {
                                    <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-600 dark:text-red-400">
                                        @item.ResultProduct.ProductExistStatus در انبار
                                    </span>

                                }
                                else
                                {
                                    <span class="px-2 py-1 text-xs rounded-full bg-success/10 text-success dark:text-success-dark">@item.ResultProduct.ProductExistStatus در انبار</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                <div class="flex space-x-3">
                                    @if (item.ResultProduct.ProductExistStatus2 == EnumConstant.ProductExistStatus.Existent && item.ResultProduct.Count > 0)
                                    {
                                        <button @onclick="@(async () => await AddToCart(item.ResultProduct.ID))" class="text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                        </button>
                                    }
                                    <button @onclick="@(async () => await AddFavoritUserProduct(item.ResultProduct.ID))" class="text-danger dark:text-danger-dark hover:text-danger/80 dark:hover:text-danger-dark/80">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-6 flex flex-col md:flex-row items-center justify-between">
        @*     <div class="mb-4 md:mb-0">
                <p class="text-sm text-gray-700 dark:text-gray-300">
                    نمایش
                    <span class="font-medium">1</span>
