                    <span class="font-medium">3</span>
                    از
                    <span class="font-medium">12</span>
                    محصول
                </p>
            </div> *@
            <PaginationType2 pagingModel="pagingModel" OnClickcallBack="@CallBackPaging" />
        </div>
    </div>

   

</main>

@code {
    long NewPrice = 0;
    long Price = 0;
    float percent = 0;

    List<ResultFavoritUserProduct> resultFavoritUserProducts = new();
    ResultFavoritUserProduct resultFavoritUserProduct = new();
    public ResultCartItem? resultCartItem { get; set; } = new();
    List<string> Roles = new();
    (bool IsLoggedIn, string Name, string UserName, string Role) ResulLoginStatus;
    private PagingModel pagingModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = 15;
        await GetData();

        ResulLoginStatus = await _LoginStatusCheckService.GetLoginStatusCheck();
        Roles.Add(ResulLoginStatus.Role);

    }
    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();


    }
    private async Task AddFavoritUserProduct(int? ProductID)
    {

        var resdata = await RootApiAddFavoritUserProduct.RunMethodApi($"FavoritUserProducts?ProductID={ProductID}", null, method: Method.Post);
      
        await GetData();
    }
    private async Task GetData()
    {
        var data2 = await RootApiGet.RunMethodApi($"FavoritUserProducts/Public?Page={pagingModel.Page}&Take={pagingModel.Take}", null, method: Method.Get);
        if (data2 != null && data2.Status == ResultMessageApi.Success)
        {
            resultFavoritUserProducts = data2.Entities.ToList();
            decimal Count = data2.CountAllRecordTable;
            pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
            pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);

        }
    }
    private async Task AddToCart(int productID)
    {
        var Result = await CartService.AddToCart(productID);
        if (Result.Status == ResultMessageApi.Success)
        {
            _ = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = Result.Message,
                Icon = Result.Status,
                ShowConfirmButton = true,
            });

        }
      


    }
    private async Task GotoProductDetails(string UniqCode)
    {
        var parameter = new Dictionary<string, object>
        {
            {"UniqCode", UniqCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/ProductDetails", parameter!));
    }

}
