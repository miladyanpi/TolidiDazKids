                                     aria-label="خرید آسان و سریع">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3.75 9h16.5m-8.25-6h-6a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3h-6" />
