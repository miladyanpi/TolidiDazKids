<!-- ================= end Product section ================= -->
@code {
    #region ListResultModels
    private List<ResultSlider>? ResultSliders { get; set; } = new List<ResultSlider>();
    private List<ResultProduct>? ResultProductDiscounts { get; set; } = new List<ResultProduct>();
    private List<ResultCategory>? ResultMostVisitedCategories { get; set; } = new List<ResultCategory>();
    private List<ResultAdvertisement>? ResultAdvertisements { get; set; } = new List<ResultAdvertisement>();
    private List<ResultProduct>? ResultNewProducts { get; set; } = new List<ResultProduct>();
    private List<ResultProduct>? ResultLatestMostViewedProductsOfWeeks { get; set; } = new List<ResultProduct>();
    public List<ResultProduct>? ResultNewProducts2 { get; set; } = new List<ResultProduct>();
    public List<ResultAdvertisementSingle>? ResultAdvertisementSingles { get; set; } = new List<ResultAdvertisementSingle>();
    public List<ResultProduct>? ResultProducts { get; set; } = new List<ResultProduct>();
    private List<ResultStory>? ResultStorys { get; set; } = new List<ResultStory>();
    private List<ResultUploadFile> ResultUploadImages { get; set; } = new List<ResultUploadFile>();
    private List<ResultUploadFile> ResultUploadVideo { get; set; } = new List<ResultUploadFile>();
    private List<StoryItem> stories = new List<StoryItem>();
    #endregion
    private bool isScriptsLoaded = false;
    private double LatestMostViewedProductsOfWeekRowCounts = 0;
    protected override async Task OnInitializedAsync()
    {
        var tastSlider = GetSliders();
        var tastProductDiscount = GetDataProductDiscount();
        var tastMostVisitedCategory = GetMostVisitedCategory();
        var tastAdvertisement = GetAdvertisement();
        var tastNewProduct = GetDataMostVisitedProduct();
        var tastLatestMostViewedProductsOfWeek = GetLatestMostViewedProductsOfWeek();
        var tastDataNewProduct2 = GetDataNewProduct2();
        var tastAdvertisementSingle = GetAdvertisementSingle();
        var tastProduct = GetProducts();

        await Task.WhenAll(tastSlider, tastProductDiscount, tastMostVisitedCategory, tastAdvertisement, tastNewProduct, tastLatestMostViewedProductsOfWeek, tastDataNewProduct2, tastAdvertisementSingle, tastProduct);
        _PublicSettingService.OnChange += StateHasChanged;
    }


    #region GetData
    private async Task GetSliders()
    {
        var data = await RootApiGetResultSliders.RunMethodApi($"Sliders/Public/All", null, method: Method.Get);
        if (data != null)
            ResultSliders = data.Entities.ToList();
    }
    private async Task GetDataProductDiscount()
    {
        var data = await RootApiGetResultProduct.RunMethodApi($"Products/Discount", null, method: Method.Get);
        if (data != null)
            ResultProductDiscounts = data.Entities.ToList();
    }
    private async Task GetMostVisitedCategory()
    {
        await _CategoryService.GetListDate();
        _CategoryService.OnChange += StateHasChanged;

        ResultMostVisitedCategories = _CategoryService.ResultCategorys;
    }
    private async Task GetAdvertisement()
    {
        await _AdvertisementService.GetListDate();
        _AdvertisementService.OnChange += StateHasChanged;

        ResultAdvertisements = _AdvertisementService.ResultAdvertisements;
    }
    private async Task GetDataMostVisitedProduct()
    {
        var data = await RootApiGetResultProduct.RunMethodApi($"Products/MostVisitedProduct", null, method: Method.Get);
        if (data != null)
            ResultNewProducts = data.Entities.ToList();
    }
    private async Task GetLatestMostViewedProductsOfWeek()
    {
        var resdata = await RootApiGetResultProduct.RunMethodApi($"Products/LatestMostViewedProductsOfWeeks", null, method: Method.Get);
        if (resdata != null)
        {
            ResultLatestMostViewedProductsOfWeeks = resdata.Entities.ToList();
            LatestMostViewedProductsOfWeekRowCounts = Math.Ceiling((float)resdata.CountAllRecordTable / 3);
        }
        else
        {
            ResultLatestMostViewedProductsOfWeeks = new();
        }


    }
    private async Task GetDataNewProduct2()
    {
        var data = await RootApiGetResultProduct.RunMethodApi($"Products/NewProduct", null, method: Method.Get);
        if (data != null)
            ResultNewProducts2 = data.Entities.ToList();
    }
    private async Task GetAdvertisementSingle()
    {
        await _AdvertisementSingleService.GetListDate();
        _AdvertisementSingleService.OnChange += StateHasChanged;

        ResultAdvertisementSingles = _AdvertisementSingleService.ResultAdvertisementSingles;
    }
    private async Task GetProducts()
    {
        var data = await RootApiResultProduct.RunMethodApi($"Products/Public/All", null, method: Method.Get);
        if (data != null)
            ResultProducts = data.Entities.ToList();
    }
    public void Dispose()
    {
        _PublicSettingService.OnChange -= StateHasChanged;
        _CategoryService.OnChange -= StateHasChanged;
        _AdvertisementService.OnChange -= StateHasChanged;
        _AdvertisementSingleService.OnChange -= StateHasChanged;
    }
    #endregion
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetDataStorys();
            await Task.Delay(50);
            await LoadScriptsAsync();
            await InvokeAsync(async () =>
            {
                await LoadStoriesAsync();
            });
        }

    }

    private async Task LoadScriptsAsync()
    {

        try
        {
            await JS.InvokeVoidAsync("loadScript", "/assets/js/plugin/story-player/story-player.js");
        }
        catch (JSDisconnectedException)
        {
            return; // کاربر صفحه را ترک کرده
        }
    }

    private async Task GetDataStorys(string? SearchText = "")
    {
        var data = await RootApiGet.RunMethodApi($"Storys/Public/All", null, method: Method.Get);
        if (data != null)
            ResultStorys = data.Entities.ToList();

    }
    private async Task LoadStoriesAsync()
    {
        stories = await GetStoriesAsync();
        try
        {
            await JS.InvokeVoidAsync("initStories", stories);
        }
        catch (JSDisconnectedException)
        {
            NavManager.NavigateTo("/login");
        }
    }

    private async Task<List<StoryItem>> GetStoriesAsync()
    {
        int i = 0;
        List<StoryItem> StoryItems = new List<StoryItem>();
        foreach (var item in ResultStorys)
        {
            i++;
            ResultUploadImages = item.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonPicture) : new List<ResultUploadFile>();
            ResultUploadVideo = item.JsonVideo != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonVideo) : new List<ResultUploadFile>();
            if (ResultUploadImages.Count > 0)
                StoryItems.Add(new StoryItem
                {
                    Type = "image",
                    User = item.Title,//$"استوری {i}",
                    Avatar = ApiLink.FullPath + ResultUploadImages[0].PathFileName,
                    Url = ApiLink.FullPath + ResultUploadImages[0].PathFileName,
                    Duration = 5000,
                    Link = item.Url
                });

            if (ResultUploadVideo.Count > 0)
            {
                // var ffProbe = new FFProbe();
                i++;
                StoryItems.Add(new StoryItem
                {
                    Type = "video",
                    User = item.Title, //$"استوری {i}",
                    Avatar = ResultUploadImages.Count > 0 ? ApiLink.FullPath + ResultUploadImages[0].PathFileName : string.Empty,
                    Url = ApiLink.FullPath + ResultUploadVideo[0].PathFileName,
                    Duration = 10000,
                    Link = item.Url
                });
            }


        }
        return StoryItems;

    }

}


