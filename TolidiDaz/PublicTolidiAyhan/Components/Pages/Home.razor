                            <div class="size-10 flex items-center justify-center rounded-lg bg-gray-200 text-gray-600 dark:bg-gray-700 dark:text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
