                                </svg>
                            </div>
                            <div class="space-y-1 text-center mt-4">
                                <h3 class="text-sm text-gray-600 font-bold dark:text-white">ارسال به سراسر کشور</h3>
                                <span class="text-xs text-gray-500 dark:text-gray-400">با پست پیشتاز</span>
