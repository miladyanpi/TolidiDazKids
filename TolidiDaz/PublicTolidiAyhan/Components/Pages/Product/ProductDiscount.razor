@using Dto.Models.DtoProduct
@inject NavigationManager NavManager

@inject SweetAlertService Swal
@inject CartPublicService CartService
<section class="py-5" itemscope itemtype="http://schema.org/ItemList">
    <h2 class="sr-only" itemprop="name">محصولات شگفت انگیز</h2>
    <div class="container">
        <div class="mb-10">
            <header class="grid place-items-center grid-cols-6 gap-y-10" itemscope
                    itemtype="https://schema.org/CollectionPage">
                <div class="ps-15 section-heading sm:col-span-4 w-full col-span-6 relative space-y-3">
                    <h2 class="font-black text-2xl">
                        <span itemprop="name" class="dark:text-white"> محصولات تخفیفی</span>
                        <span class="text-green-600 font-bold">فروشگاه</span>
                    </h2>
                    <p class="text-neutral-600 dark:text-white" itemprop="description">محصولات تخفیفی</p>
                </div>
                <div class="w-full sm:col-span-2 col-span-6">
                    <div class="sm:text-end text-start">
                        <a href="/Shop"
                           class="btn bg-transparent border-secondary border-2 hover:bg-secondary hover:text-white dark:text-white dark:border-white"
                           title="مشاهده تمامی دسته‌بندی‌ها" itemprop="url">
                            مشاهده همه
                        </a>
                    </div>
                </div>
          
            </header>
        </div>
        <div class="bg-green-500 bg-contain bg-[url(../images/slider/patterns.png)] p-5 rounded-lg">
            <div class="swiper amazing-carousel">
                <div class="swiper-wrapper items-center" style="padding-bottom: 0 !important;">
                    <div class="swiper-slide !ml-0 !w-40 p-1">
                        <article class="flex flex-col space-y-3 items-center justify-center">
                            <img class="size-35" src="assets/images/slider/Amazing.svg" alt="آیکن محصولات شگفت انگیز"
                                 loading="lazy">
                            <a class="flex text-white items-center" href="/Shop" aria-label="مشاهده همه محصولات">
                                مشاهده همه
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.5" stroke="currentColor" class="size-4 ms-1" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15.75 19.5 8.25 12l7.5-7.5" />
                                </svg>
                            </a>
                        </article>
                    </div>
                    @foreach (var item in ResultProducts)
                    {
                        <div class="swiper-slide !w-auto p-1">
                            <PublicTolidiAyhan.Components.Pages.Component.Product item="item" />
                        </div>
                    }


                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public List<ResultProduct>? ResultProducts { get; set; } = new List<ResultProduct>();
    private async Task GotoProductDetails(string UniqCode)
    {
        var parameter = new Dictionary<string, object>
        {
            {"UniqCode", UniqCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/ProductDetails", parameter!));
    }
    private async Task AddToCart(int productID)
    {
        var Result = await CartService.AddToCart(productID);
        _ = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "پیام",
            Text = Result.Message,
            Icon = Result.Status,
            ShowConfirmButton = true,
        });
    }
}