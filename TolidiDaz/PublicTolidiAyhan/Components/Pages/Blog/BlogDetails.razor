@page "/BlogDetails"
@using Dto.Models.DtoBlog
@using Newtonsoft.Json
@using Dto.Models.DtoUploadFile
@inject IRootApi<ResponseApiEntity<ResultBlog>> RootApiResultBlog
@inject IRootApi<ResponseApiEntities<ResultBlog>> RootApiResultBlogs
@inject NavigationManager NavManager
@inject IJSRuntime JS

<section class="py-5" id="BlogTitleId">
    <div class="container">
        <!--Original content-->
        <main class="container !px-0 my-10">
            <div class="flex flex-col xl:flex-row gap-4">
                <!-- Articles -->
                <div class="xl:w-3/4 bg-white rounded-xl shadow-md overflow-hidden">
                    <!--The main image of the article-->
                    <img src="assets/images/blog/cover.jpg" alt="کاربر" class="w-full h-64 md:h-96 object-cover">

                    <!--Header of the article-->
                    <div class="p-6 md:p-8 dark:bg-gray-800">
                        <div class="flex flex-wrap items-center justify-between mb-6">
                            <div class="flex items-center space-x-2">
                                @if (resultBlog.ResultGroupBlog != null)
                                {
                                    <span class="bg-primary-100 text-primary-800 text-xs font-medium px-2.5 py-0.5 rounded">
                                        @resultBlog.ResultGroupBlog.Title
                                    </span>
                                }
                               
                                <span class="text-sm text-gray-500">@resultBlog.RegisterDate  </span>
                                <span class="text-sm text-gray-500">•</span>
                                <span class="text-sm text-gray-500">@resultBlog.StudyDuration دقیقه مطالعه</span>
                            </div>
                            <div class="flex items-center space-x-2 mt-2 md:mt-0">
                                <button class="text-gray-400 hover:text-red-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                    </svg>
                                </button>
                                <button class="text-gray-400 hover:text-blue-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6 dark:text-white">@resultBlog.Title</h1>

                        <!--Author information-->
                        <div class="flex items-center mb-8 pb-6 border-b border-gray-200">
                            <img src="assets/images/user/user.jpg" alt="نویسنده" class="w-12 h-12 rounded-full object-cover">
                            <div class="mr-4">
                                <h4 class="font-medium text-gray-800 dark:text-gray-300">@resultBlog.ResultTeam.Name</h4>
                                <p class="text-sm text-gray-500">@resultBlog.ResultTeam.Title</p>
                            </div>
                        </div>

                        <!--Content of the article-->
                        <div class="article-content text-gray-700 dark:text-gray-300 ">
                            @((MarkupString)resultBlog.Description)
                        </div>

                        <!--Article tags-->
                        <div class="mt-8 pt-6 border-t border-gray-200">
                            <div class="flex flex-wrap gap-2">
                                @if (resultBlog.ResultJsonLables != null)
                                {
                                    foreach (var item in resultBlog.ResultJsonLables)
                                    {
                                        <a href="#" class="bg-gray-100 dark:bg-primary-dark dark:hover:bg-primary-dark/70 dark:text-white hover:bg-gray-200 text-gray-800 px-3 py-1 rounded-full text-sm transition duration-300">@item.Text</a>
                                    }
                                }
                            </div>
                        </div>

                        <!--Sharing-->
                        <div class="mt-8 dark:bg-gray-900 bg-gray-50 p-4 rounded-lg">
                            <h3 class="text-lg font-medium text-gray-800 mb-3 dark:text-white">این مقاله را با دوستان خود به اشتراک بگذارید</h3>
                            <div class="flex space-x-3">
                                <a href="#" class="bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                                    </svg>
                                </a>
                                <a href="#" class="bg-blue-400 hover:bg-blue-500 text-white p-2 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                                    </svg>
                                </a>
                                <a href="#" class="bg-red-600 hover:bg-red-700 text-white p-2 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                    </svg>
                                </a>
                                <a href="#" class="bg-gray-800 hover:bg-gray-900 text-white p-2 rounded-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <!-- the author -->
                        <div class="mt-8 bg-gray-50 dark:bg-gray-900 p-6 rounded-lg">
                            <div class="flex items-center">
                                <img src="assets/images/user/user.jpg" alt="نویسنده" class="w-16 h-16 rounded-full object-cover">
                                <div class="mr-4">
                                    <h4 class="text-lg font-bold text-gray-800 dark:text-gray-300">@resultBlog.ResultTeam.Name</h4>
                                    <p class="text-gray-600 mb-2 dark:text-gray-400">@resultBlog.ResultTeam.Title</p>
                                    <div class="flex space-x-3">
                                        <a href="#" class="text-gray-500 dark:text-gray-300 hover:text-blue-500">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                                            </svg>
                                        </a>
                                        <a href="#" class="text-gray-500 dark:text-gray-300 hover:text-blue-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                                            </svg>
                                        </a>
                                        <a href="#" class="text-gray-500 dark:text-gray-300 hover:text-gray-500">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <p class="mt-4 text-gray-700 dark:text-gray-400">@resultBlog.ResultTeam.Description</p>
                        </div>

                        <!--Related articles-->
                        <div class="mt-12">
                            <h3 class="text-xl font-bold text-gray-800 mb-6 pb-2 border-b border-gray-200 dark:text-gray-300">مقالات مرتبط</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                @foreach (var item in resultRelatedBlogs)
                                {
                                    var ResultUploadFile = item.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonPicture) : new List<ResultUploadFile>();
                                    var filepath = ResultUploadFile.Count > 0 ? ApiLink.FullPath + ResultUploadFile[0].PathFileName : ApiLink.FullPath + "images/No-Blog-Image.png"; ;

                                    <a @onclick="@(async () => { await GetData(item.IdentityCode.ToString()); await ScrollToTitle(); })" class="flex items-start space-x-3 group">
                                        <img src="@filepath" alt="@item.Title" class="w-20 h-20 object-cover rounded-lg flex-shrink-0">
                                        <div>
                                            <h4 class="font-medium text-gray-800 group-hover:text-primary-600 dark:text-gray-300">@item.Title</h4>
                                            <span class="text-xs text-gray-500 dark:text-gray-400">@item.RegisterDate - @item.StudyDuration دقیقه</span>
                                        </div>
                                    </a>
                                }

                            </div>
                        </div>

                        <!-- Comments -->
                       
                        <Comment BlogID="@resultBlog.ID" />
            
                    </div>
                </div>

                <!-- sidebar -->
                <aside class="xl:w-1/4 relative">
                    <div class="space-y-8 sticky top-0">
                        <!-- Categories -->
                        <GroupBlog GetDate="@GoToBlogs" />
                        <!--Popular articles-->
                        <BlogsTop10MostVisited GetDate="GetData" />
                        <!-- newsletter -->
                        <div class="bg-primary-50 dark:bg-primary-900/20 p-6 rounded-xl border border-primary-100 dark:border-primary-800 transition-colors duration-200">
                            <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-3">عضویت در خبرنامه</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">با عضویت در خبرنامه از آخرین مقالات و تخفیف‌های ویژه مطلع شوید.</p>
                            <form class="space-y-3">
                                <input type="email" placeholder="آدرس ایمیل شما" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-zinc-900 dark:text-white">
                                <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 text-white py-2 px-4 rounded-lg transition duration-300">عضویت</button>
                            </form>
                        </div>
                    </div>
                </aside>
            </div>
        </main>

    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Code { get; set; }
    public ResultBlog? resultBlog { get; set; } = new();
    public List<ResultBlog>? resultRelatedBlogs { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        await GetData();
    }
    private async Task GetData(string? IdentityCode="")
    {
        if (!string.IsNullOrEmpty(IdentityCode))
            Code = IdentityCode;

        var resdata = await RootApiResultBlog.RunMethodApi($"Blogs/Public/{Code}", null, method: Method.Get);
        if (resdata != null && resdata.Status == ResultMessageApi.Success)
        {
            resultBlog = resdata.Entity;
            var resdataRelatedBlogsCount = await RootApiResultBlogs.RunMethodApi($"Blogs/Public/RelatedBlogsCount/{resultBlog.GroupBlogID}", null, method: Method.Get);
            if (resdataRelatedBlogsCount != null && resdataRelatedBlogsCount.Status == ResultMessageApi.Success)
            {
                resultRelatedBlogs = resdataRelatedBlogsCount.Entities.ToList();
            }
        }
      
    }
    

    private void GoToBlogs(string identityCode)
    {
        var parameter = new Dictionary<string, object>
        {
            {"Code", identityCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Blogs", parameter!));
    }
    private async Task ScrollToTitle()
    {
        await JS.InvokeVoidAsync("scrollToElement", "BlogTitleId");
    }

}
