@page "/faq"
@using DNTCaptcha.Blazor
@using Dto.Models.DtoFaq
@inject IRootApi<ResponseApiEntity<AddFaq>> RootApiAddFaq
@inject IHttpContextAccessor HttpContextAccessor
@inject SweetAlertService Swal
@inject IJSRuntime JS
<!-- ================= start content section ================= -->
<section class="py-5">
    <div class="container">
        <!-- Specially designed header -->
        <header class="text-center mb-16 relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-xl dark:shadow-gray-800/10">
            <div class="absolute inset-0 pattern-dots text-gray-100 dark:text-gray-700/50"></div>
            <div class="relative z-10">
                <div class="inline-flex items-center justify-center mb-6">
                    <div class="w-16 h-16 rounded-full bg-primary-light/10 dark:bg-primary-dark/10 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-light dark:text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
                    <span class="gradient-text bg-gradient-to-r from-primary-light to-secondary-light dark:from-primary-dark dark:to-secondary-dark">سوالات متداول</span>
                </h1>
                <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
                    پاسخ به تمام سوالات شما در مورد خدمات و محصولات ما. اگر پاسخ خود را نیافتید، با پشتیبانی تماس بگیرید.
                </p>
            </div>
        </header>

        <!-- FAQ section with advanced design -->
        <div class="mx-auto space-y-6">
            <div class="grid grid-cols-6 gap-4">
                <!-- Grouping of questions -->
                <div class="lg:col-span-3 col-span-6">
                    <div class="rounded-2xl dark:bg-gray-800 shadow-lg overflow-hidden border border-gray-200/50 dark:border-gray-700/30 transition-all duration-500 hover:shadow-xl dark:hover:shadow-gray-800/20">
                        <div class="p-1 bg-gray-200 dark:bg-gray-700">
                            <h2 class="text-xl font-bold text-center py-2  dark:text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 inline-block ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                                سوالات عمومی
                            </h2>
                        </div>

                        <!-- Item 1 -->
                        <div class="border-b border-gray-200/50 dark:border-gray-700/30 last:border-0">
                            <button class="accordion-btn w-full flex justify-between items-center p-6 text-right focus:outline-none group">
                                <div class="flex items-start">
                                    <span class="w-8 h-8 rounded-full bg-primary-light/10 dark:bg-primary-dark/10 text-primary-light dark:text-primary-dark flex items-center justify-center ml-4 mt-0.5 flex-shrink-0 group-hover:bg-primary-light/20 dark:group-hover:bg-primary-dark/20 transition-colors">
                                        <span class="font-bold">۱</span>
                                    </span>
                                    <span class="text-lg  text-gray-800 dark:text-gray-200 group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors">
                                        چگونه می‌توانم حساب کاربری ایجاد کنم؟
                                        <span class="block text-sm font-normal text-gray-500 dark:text-gray-400 mt-1">راهنمای ثبت‌نام و احراز هویت</span>
                                    </span>
                                </div>
                                <svg class="w-6 h-6 transform transition-transform duration-300 text-secondary-light dark:text-secondary-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="accordion-content max-h-0 overflow-hidden">
                                <div class="px-6 pb-8 ml-14 text-gray-600 dark:text-gray-300 space-y-4">
                                    <p>برای ایجاد حساب کاربری در سامانه ما، مراحل زیر را دنبال کنید:</p>
                                    <ol class="list-decimal pr-5 space-y-2">
                                        <li>روی دکمه "ثبت‌نام" در گوشه بالا سمت چپ صفحه کلیک کنید</li>
                                        <li>در صفحه ورود به حساب کاربری تب ورود با پیامک را انتخاب کند</li>
                                        <li>شماره موبایل خود را وارد کرده و روی دکمه دریافت کد تایید بزنید</li>
                                        <li>در کادر کد تایید کد 6 رقمی ارسال شده را وارد کنید و برروی تایید ورود بزنید</li>
                                        <li>ثبت نام شما با موفقیت انجام شده و به صفحه اصلی هدایت خواهید شد </li>
                                        <li> درنهایت می توانید در پنل کاربری خود نسبت به تکمیل اطلاعات شخصی خود اقدام نمایید </li>
                                    </ol>
                                    <div class="bg-blue-50 dark:bg-blue-900/20 border-r-4 border-blue-500 dark:border-blue-400 px-4 py-3 rounded">
                                        <div class="flex items-start">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 dark:text-blue-400 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            <p class="text-blue-700 dark:text-blue-300">درصورت دریافت پیام اعتبار کد یکبارمصرف به اتمام رسیده است، دریافت کد تایید را مجددا بزنید</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="border-b border-gray-200/50 dark:border-gray-700/30 last:border-0">
                            <button class="accordion-btn w-full flex justify-between items-center p-6 text-right focus:outline-none group">
                                <div class="flex items-start">
                                    <span class="w-8 h-8 rounded-full bg-primary-light/10 dark:bg-primary-dark/10 text-primary-light dark:text-primary-dark flex items-center justify-center ml-4 mt-0.5 flex-shrink-0 group-hover:bg-primary-light/20 dark:group-hover:bg-primary-dark/20 transition-colors">
                                        <span class="font-bold">۲</span>
                                    </span>
                                    <span class="text-lg  text-gray-800 dark:text-gray-200 group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors">
                                        روش‌های پرداخت شما کدامند؟
                                        <span class="block text-sm font-normal text-gray-500 dark:text-gray-400 mt-1">امنیت و تنوع درگاه‌های پرداخت</span>
                                    </span>
                                </div>
                                <svg class="w-6 h-6 transform transition-transform duration-300 text-secondary-light dark:text-secondary-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="accordion-content max-h-0 overflow-hidden">
                                <div class="px-6 pb-8 ml-14 text-gray-600 dark:text-gray-300 space-y-4">
                                    <p>ما از چندین روش پرداخت مطمئن و پرکاربرد پشتیبانی می‌کنیم:</p>
                                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4">

                                        <div class="flex items-center p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
                                            <div class="h-8 w-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold">P</div>
                                            <span class="mr-2 font-medium">درگاه پرداخت سپ</span>
                                        </div>
                                        <div class="flex items-center p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
                                            <div class="h-8 w-8 rounded-full bg-green-600 text-white flex items-center justify-center font-bold">C</div>
                                            <span class="mr-2 font-medium">کارت به کارت</span>
                                        </div>
                                        <div class="flex items-center p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
                                            <div class="h-8 w-8 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold">Q</div>
                                            <span class="mr-2 font-medium">کیف پول</span>
                                        </div>
                                    </div>
                                    <div class="bg-yellow-50 dark:bg-yellow-900/20 border-r-4 border-yellow-500 dark:border-yellow-400 px-4 py-3 rounded mt-4">
                                        <div class="flex items-start">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-500 dark:text-yellow-400 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                            </svg>
                                            <p class="text-yellow-700 dark:text-yellow-300">برای امنیت بیشتر، هرگز اطلاعات کارت بانکی خود را از طریق تماس تلفنی یا پیامک با دیگران به اشتراک نگذارید.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Second grouping -->
                <div class="lg:col-span-3 col-span-6">
                    <div class="rounded-2xl dark:bg-gray-800 shadow-lg overflow-hidden border border-gray-200/50 dark:border-gray-700/30 transition-all duration-500 hover:shadow-xl dark:hover:shadow-gray-800/20">
                        <div class="p-1 bg-gray-200 dark:bg-gray-700">
                            <h2 class="text-xl font-bold text-center py-2  dark:text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 inline-block ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                                سوالات محصولات
                            </h2>
                        </div>

                        <!-- Item 3 -->
                        <div class="border-b border-gray-200/50 dark:border-gray-700/30 last:border-0">
                            <button class="accordion-btn w-full flex justify-between items-center p-6 text-right focus:outline-none group">
                                <div class="flex items-start">
                                    <span class="w-8 h-8 rounded-full bg-secondary-light/10 dark:bg-secondary-dark/40 text-secondary-light dark:text-white flex items-center justify-center ml-4 mt-0.5 flex-shrink-0 group-hover:bg-secondary-light/20 transition-colors">
                                        <span class="font-bold">۳</span>
                                    </span>
                                    <span class="text-lg  text-gray-800 dark:text-gray-200 group-hover:text-primary-dark transition-colors">
                                        سیاست بازگشت کالا چگونه است؟
                                        <span class="block text-sm font-normal text-gray-500 dark:text-gray-400 mt-1">ضمانت رضایت و بازگشت وجه</span>
                                    </span>
                                </div>
                                <svg class="w-6 h-6 transform transition-transform duration-300 text-secondary-light dark:text-secondary-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="accordion-content max-h-0 overflow-hidden">
                                <div class="px-6 pb-8 ml-14 text-gray-600 dark:text-gray-300 space-y-4">
                                    <div class="overflow-x-auto">
                                        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                                            <thead class="bg-gray-100 dark:bg-gray-700">
                                                <tr>
                                                    <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">نوع محصول</th>
                                                    <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">مدت بازگشت</th>
                                                    <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">شرایط</th>
                                                </tr>
                                            </thead>
                                            <tbody class="bg-white dark:bg-zinc-900 divide-y divide-gray-200 dark:divide-gray-700">

                                                <tr>
                                                    <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-200">پوشاک</td>
                                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">3 روز</td>
                                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">عدم استفاده با برچسب</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="bg-green-50 dark:bg-green-900/20 border-r-4 border-green-500 dark:border-green-400 px-4 py-3 rounded">
                                        <div class="flex items-start">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 dark:text-green-400 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                            </svg>
                                            <p class="text-green-700 dark:text-green-300">در صورت نقص فنی یا عدم تطابق با توضیحات، هزینه بازگشت بر عهده فروشگاه خواهد بود.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Item 4 -->
                        <div class="border-b border-gray-200/50 dark:border-gray-700/30 last:border-0">
                            <button class="accordion-btn w-full flex justify-between items-center p-6 text-right focus:outline-none group">
                                <div class="flex items-start">
                                    <span class="w-8 h-8 rounded-full bg-secondary-light/10 dark:bg-secondary-dark/40 text-secondary-light dark:text-white flex items-center justify-center ml-4 mt-0.5 flex-shrink-0 group-hover:bg-secondary-light/20 transition-colors">
                                        <span class="font-bold">۴</span>
                                    </span>
                                    <span class="text-lg  text-gray-800 dark:text-gray-200 group-hover:text-primary-dark transition-colors">
                                        زمان تحویل سفارشات چقدر است؟
                                        <span class="block text-sm font-normal text-gray-500 dark:text-gray-400 mt-1">سیستم حمل و نقل و پست</span>
                                    </span>
                                </div>
                                <svg class="w-6 h-6 transform transition-transform duration-300 text-secondary-light dark:text-secondary-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="accordion-content max-h-0 overflow-hidden">
                                <div class="px-6 pb-8 ml-14 text-gray-600 dark:text-gray-300 space-y-4">
                                    <p>زمان تحویل سفارشات بستگی به عوامل مختلفی دارد:</p>
                                    <div class="grid md:grid-cols-2 gap-6 mt-4">
                                        <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow-sm border border-gray-200 dark:border-gray-600">
                                            <h3 class="font-bold text-lg mb-3 text-primary-light dark:text-primary-dark flex items-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                زمان‌بندی استاندارد
                                            </h3>
                                            <ul class="space-y-2 text-sm">
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    گلستان: ۱ تا ۲ روز کاری
                                                </li>
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    شهرهای بزرگ: ۲ تا 3 روز کاری
                                                </li>
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    سایر شهرها: ۳ تا 4 روز کاری
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow-sm border border-gray-200 dark:border-gray-600">
                                            <h3 class="font-bold text-lg mb-3 text-secondary-light dark:text-secondary-dark flex items-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                تحویل سریع (اکسپرس)
                                            </h3>
                                            <ul class="space-y-2 text-sm">
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    گلستان: همان روز (سفارش قبل از ۱۲ ظهر)
                                                </li>
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    شهرهای بزرگ: روز بعد
                                                </li>
                                                <li class="flex items-start">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 mt-0.5 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    هزینه اضافه: ۳۰٪ از هزینه پست
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <p class="text-sm text-gray-500 dark:text-gray-400">* سفارشات در روزهای تعطیل پردازش نمی‌شوند و زمان تحویل به همین میزان افزایش می‌یابد.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Contact form -->
            <div class="mt-12 bg-gradient-to-br from-white to-white/80 dark:from-gray-800 dark:to-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg overflow-hidden border border-gray-200/50 dark:border-gray-700/30 p-8">
                <div class="text-center mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-2">پاسخ خود را نیافتید؟</h2>
                    <p class="text-gray-600 dark:text-gray-400">فرم زیر را پر کنید تا در اسرع وقت با شما تماس بگیریم</p>
                </div>
               
                    <EditForm Model="addFaq" OnValidSubmit="Add" FormName="AddForm" class="space-y-6">
                        <DataAnnotationsValidator />

                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                            <CustomLabel ForId="FullName" For="@(() => addFaq.FullName)"></CustomLabel>
                                <ValidationMessage For="@(() => addFaq.FullName)" class="validate" />
                                <InputText placeholder="نام و نام خانوادگی" id="name" @bind-Value="addFaq.FullName" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark focus:border-transparent bg-white dark:bg-gray-700 transition-all duration-300 placeholder-gray-500" />
                            </div>
                            <div>
                            <CustomLabel ForId="Mobile" For="@(() => addFaq.Mobile)"></CustomLabel>
                                <ValidationMessage For="@(() => addFaq.Mobile)" class="validate" />
                            <InputText placeholder="شماره موبایل" id="Mobile" @bind-Value="addFaq.Mobile" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark focus:border-transparent bg-white dark:bg-gray-700 transition-all duration-300 placeholder-gray-500" />
                            </div>

                        </div>
                        <div>

                        <CustomLabel ForId="Subject" For="@(() => addFaq.Subject)"></CustomLabel>
                            <ValidationMessage For="@(() => addFaq.Subject)" class="validate" />
                            <InputSelect @bind-Value=" addFaq.Subject" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark focus:border-transparent bg-white dark:bg-gray-700 transition-all duration-300 placeholder-gray-500">
                                @foreach (var item in ResultSubjects)
                                {
                                    <option value="@item.Title">@item.Title</option>
                                }
                            </InputSelect>

                        </div>
                        <div>
                        <CustomLabel ForId="Message" For="@(() => addFaq.Message)"></CustomLabel>
                            <ValidationMessage For="@(() => addFaq.Message)" class="validate" />
                            <InputTextArea rows="8" placeholder="متن پیام خود را بنویسید..." @bind-Value="addFaq.Message" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark focus:border-transparent bg-white dark:bg-gray-700 transition-all duration-300 placeholder-gray-500" />
                        </div>
                        
                     <div class="row form-group" >
                         <div  style="display:flex;justify-content:space-between;align-items:center;">
                            <div >
                                <ValidationMessage For="@(() => addFaq.EnteredCaptchaText1)" class="validate" />
                                <CustomLabel For="@(() => addFaq.EnteredCaptchaText1)"></CustomLabel>
                                <InputText @bind-Value="addFaq.EnteredCaptchaText1" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary-500 dark:bg-gray-700 dark:text-white transition" />
                            </div>
                                <DntInputCaptcha @bind-Value="addFaq.CaptchaText1"
                                                 Language="@NumberToWordLanguage.English"
                                                 DisplayMode="@DisplayMode.ShowDigits"
                                                 AllowThousandsSeparators="false"
                                                 Max="99999"
                                                 Min="11111"
                                                 AbsoluteExpiration="@TimeSpan.FromMinutes(2)"
                                                 ShowRefreshButton="true"
                                                 FontSize="21"
                                                 FontName="Times New Roman"
                                                 FontColor="#603F83FF"
                                                 BackgroundColor="#FCF6F5FF"
                                                 RandomLinesCount="2"
                                                 RandomCirclesCount="6"
                                                 BorderWidth="0.3"
                                                 BorderColor="grey"
                                                 NoisePointsCount="25"
                                                 Padding="11"
                                                 ShadowBlur="7"
                                                 ShadowColor="navy"
                                                 ShadowOffsetX="-3"
                                                 ShadowOffsetY="-3"
                                                 TimerInterval="@TimeSpan.FromMilliseconds(2500)"
                                                 CaptchaCanvasClass="d-flex align-self-center"
                                                 CaptchaDivClass="align-self-center ms-1"
                                                 RefreshButtonClass="p-4 bg-gray-100 rounded-full hover:bg-gray-200"
                                                 RefreshButtonTitle="Refresh" />

                         </div>
                        
                    </div>
                        <div>
                            <button type="submit" class="w-full bg-primary-grad dark:from-primary-dark dark:to-accent-dark text-white font-medium py-3 px-6 rounded-lg hover:shadow-glow dark:hover:shadow-glow-dark transition-all duration-300">
                                ارسال پیام
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                </svg>
                            </button>
                        </div>

                    </EditForm>
                
            </div>
        </div>
    </div>
</section>
@code {
    private AddFaq? addFaq = new();
    private List<(int ID, string Title)> ResultSubjects = new List<(int, string)>();
    protected override async Task OnInitializedAsync()
    {

        ResultSubjects.Add((1, "پشتیبانی فنی"));
        ResultSubjects.Add((2, "سوالات مالی"));
        ResultSubjects.Add((3, "پیشنهادات"));
        ResultSubjects.Add((4, "انتقادات"));
        ResultSubjects.Add((5, "سایر"));

        _PublicSettingService.OnChange += StateHasChanged;

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Task.Delay(100);
        await JS.InvokeVoidAsync("initPageScripts");
        if (firstRender)
        {
         
            addFaq.Subject = ResultSubjects[0].Title;
        }

    }
    public void Dispose()
    {
        _PublicSettingService.OnChange -= StateHasChanged;
    }
    private async Task Add()
    {
        addFaq.IpAddress = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString();
        var resdata = await RootApiAddFaq.RunMethodApi($"Faqs?Key={Dto.Enum.Keys.CustomerSatisfactionKey}", addFaq, method: Method.Post);
        if (resdata != null && resdata.Status == ResultMessageApi.Success)
        {
            addFaq = new AddFaq();
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = "پیام شما با موفقیت ارسال شد",
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }

        else if (resdata != null && resdata.Status == ResultMessageApi.Error)
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata.Message,
                Icon = resdata.Status,
                ShowConfirmButton = true,
            });
        }
    }
}
