@page "/About"
@using Dto.Models.DtoAbout
@inject IJSRuntime JS

@inject IRootApi<ResponseApiEntities<UpdateAbout>> RootApiUpdateAbouts
@inject AboutService _AboutService
@inject TeamService _TeamService
<section class="py-5">
    <div class="container">
        <!-- Our Story -->
        <section class="mb-20">
            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="md:w-1/2">
                    <h2 class="font-bold dark:text-light text-3xl mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                        داستان ما
                    </h2>
                    <p class="text-gray-600 dark:text-gray-400 mb-4 leading-relaxed  text-justify">
                        @_AboutService.updateAbout.ShortDescription
                    </p>

                    <a href="#"
                       class="inline-flex items-center px-6 py-3 bg-primary-light dark:bg-primary-dark text-white rounded-lg hover:bg-opacity-90 transition font-medium">
                        بیشتر بخوانید
                        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </a>
                </div>
                @*  <div class="md:w-1/2 relative">
                    <div class="relative rounded-2xl overflow-hidden shadow-xl">
                        <img src="assets/images/about/about.jpg" alt="تیم ما" class="w-full h-auto">
                        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-50"></div>
                    </div>

                </div> *@

                <div class="md:w-1/2 relative">
                        <div class="swiper max-w-[1920px] mx-auto !relative default-carousel swiper-container"
                             aria-label="اسلایدر فروشگاه">
                            <div class="swiper-wrapper" style="padding-bottom: 0 !important;">
                                @if (_AboutService.updateAbout.ResultUploadFiles != null)
                                {
                                    foreach (var item in _AboutService.updateAbout.ResultUploadFiles)
                                    {
                                        var filepath = ApiLink.FullPath + item.PathFileName;
                                        <div class="swiper-slide max-w-[1920px]" role="group" aria-roledescription="slide">
                                            <div class="flex justify-center items-center">
                                                <img src="@filepath"
                                                     class="w-full h-[250px] md:h-[400px] object-cover rounded-lg"
                                                     loading="lazy"
                                                     alt="@item.Title">
                                            </div>


                                        </div>
                                    }
                                }


                            </div>
                            <div class="swiper-button-next bg-white rounded-full dark:bg-zinc-800 border border-gray-200 !size-12 after:!text-xl px-3 after:text-primary"
                                 aria-label="اسلاید بعدی"></div>
                            <div class="swiper-button-prev bg-white rounded-full dark:bg-zinc-800 border border-gray-200 !size-12 after:!text-xl px-3 after:text-primary"
                                 aria-label="اسلاید قبلی"></div>
                            <div class="swiper-pagination !z-30 !bottom-0" aria-label="صفحه بندی اسلایدر"></div>
                            <div class="slider-pagination-bg absolute w-40 h-10 -translate-x-1/2 -mb-3 pt-1 left-1/2 bottom-0 z-10"></div>
                        </div>
                    </div>
              


            </div>
        </section>

        <!-- Mission and Values-->
        <section class="mb-20 bg-gray-100 dark:bg-zinc-900 rounded-2xl p-8 md:p-12">
            <div class="text-center mb-12">
                <span class="inline-block px-4 py-2 bg-primary-light dark:bg-primary-dark text-white rounded-full text-sm font-medium mb-4">ارزش‌های ما</span>
                <h2 class="text-3xl font-bold dark:text-white">ماموریت و ارزش‌های ما</h2>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white dark:bg-gray-700 p-6 rounded-xl shadow-sm hover:shadow-md transition">
                    <div class="w-12 h-12 rounded-full bg-primary-light dark:bg-primary-dark bg-opacity-10 dark:bg-opacity-20 flex items-center justify-center mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                        </svg>

                    </div>
                    <h3 class="text-xl font-bold mb-3 dark:text-white">کیفیت بی‌نظیر</h3>
                    <p class="text-gray-600 dark:text-gray-400">
                        ما فقط محصولاتی را ارائه می‌دهیم که خودمان با اطمینان
                        کامل آنها را تأیید کرده‌ایم و از کیفیت آنها مطمئن هستیم.
                    </p>
                </div>

                <div class="bg-white dark:bg-gray-700 p-6 rounded-xl shadow-sm hover:shadow-md transition">
                    <div class="w-12 h-12 rounded-full bg-primary-light dark:bg-primary-dark bg-opacity-10 dark:bg-opacity-20 flex items-center justify-center mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3 dark:text-white">قیمت مناسب</h3>
                    <p class="text-gray-600 dark:text-gray-400">
                        با حذف واسطه‌ها و خرید مستقیم از تولیدکنندگان، بهترین
                        قیمت‌ها را به شما ارائه می‌دهیم.
                    </p>
                </div>

                <div class="bg-white dark:bg-gray-700 p-6 rounded-xl shadow-sm hover:shadow-md transition">
                    <div class="w-12 h-12 rounded-full bg-primary-light dark:bg-primary-dark bg-opacity-10 dark:bg-opacity-20 flex items-center justify-center mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3 dark:text-white">پشتیبانی 24/7</h3>
                    <p class="text-gray-600 dark:text-gray-400">
                        تیم پشتیبانی ما به صورت 24 ساعته و در 7 روز هفته آماده
                        پاسخگویی به سوالات و حل مشکلات شماست.
                    </p>
                </div>
            </div>
        </section>

        <!-- Statistics -->
        <section class="mb-20">
            <div class="grid md:grid-cols-4 gap-6 text-center">
                <div class="bg-white dark:bg-zinc-800 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-primary-light dark:text-primary-dark mb-2">۱۰+</div>
                    <div class="text-gray-600 dark:text-gray-400">سال تجربه</div>
                </div>
                <div class="bg-white dark:bg-zinc-800 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-primary-light dark:text-primary-dark mb-2">۵۰۰۰+</div>
                    <div class="text-gray-600 dark:text-gray-400">مشتری راضی</div>
                </div>
                <div class="bg-white dark:bg-zinc-800 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-primary-light dark:text-primary-dark mb-2">۲۰۰+</div>
                    <div class="text-gray-600 dark:text-gray-400">محصول متنوع</div>
                </div>
                <div class="bg-white dark:bg-zinc-800 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-primary-light dark:text-primary-dark mb-2">۹۸%</div>
                    <div class="text-gray-600 dark:text-gray-400">رضایت مشتریان</div>
                </div>
            </div>
        </section>

        <!-- Our Team -->
        <section>
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold dark:text-white">تیم متخصص ما</h2>
                <p class="max-w-2xl mx-auto text-gray-600 dark:text-gray-400 mt-4">
                    با اعضای با تجربه و متخصص تیم ما آشنا
                    شوید
                </p>
            </div>

            <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
                @foreach (var item in _TeamService.ResultTeams)
                {

                    var filename = item.ResultUploadFiles.Count > 0 ? item.ResultUploadFiles[0].PathFileName : string.Empty;
                    var filepath = ApiLink.FullPath + filename;
                    <div class="bg-white dark:bg-zinc-800 rounded-4xl overflow-hidden shadow-sm hover:shadow-md transition">
                        <img src="@filepath" alt="عضو تیم" class="w-full h-auto object-cover">
                        <div class="p-4">
                            <h3 class="font-bold text-lg dark:text-white">@item.Name</h3>
                            <h3 class="dark:text-white">@item.Title</h3>
                            <p class="text-gray-600 dark:text-gray-400 text-sm">@item.Description</p>
                        </div>
                    </div>
                }
               
            </div>
        </section>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
       _= _AboutService.GetListDate();
       _= _TeamService.GetListDate();
  
         _AboutService.OnChange += StateHasChanged;
         _TeamService.OnChange += StateHasChanged;
    }
    
    public void Dispose()
{
    _AboutService.OnChange -= StateHasChanged;
        _TeamService.OnChange -= StateHasChanged;
}
    
}