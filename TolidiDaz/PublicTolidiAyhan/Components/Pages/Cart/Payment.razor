<!-- ================= end content section ================= -->
@code {
    @inject IRootApi<ResponseApiEntity<ResponseTokenSep>> RootApiResponseTokenSep
    @inject NavigationManager NavManager
    @inject SweetAlertService Swal
    private async Task Pay()
    {
        var resdata = await RootApiResponseTokenSep.RunMethodApi($"Payments/Sep/Public?paymentMethod={PaymentMethod.Sep}", null, method: Method.Get);
        if (resdata != null && resdata.Status == ResultMessageApi.Success)
        {
            var parameter = new Dictionary<string, object>
            {
                {"Token", resdata.Entity.token},
            };
            NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/RedirectToBank", parameter!));
            return;
        }
        else if (resdata != null && resdata.Status == ResultMessageApi.Error)
        {
            var result1 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "خطا",
                Html = resdata.Message,
                ShowConfirmButton = true,
            });
            return;
        }
        else
        {
            var result1 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "خطا",
                Text = "خطایی رخ داده است",
                ShowConfirmButton = true,
            });
        }
    }
}
