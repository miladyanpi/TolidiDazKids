                                <CustomLabel ForId="updateCustomerInfo-Name" For="@(() => updateCustomerInfo.Name)" IsRequired="true"></CustomLabel>
                                <ValidationMessage For="@(() => updateCustomerInfo.Name)" class="validate" />
                                <InputText @bind-Value="updateCustomerInfo.Name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
