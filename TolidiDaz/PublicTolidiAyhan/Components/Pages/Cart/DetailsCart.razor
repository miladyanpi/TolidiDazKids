                            <span class="font-medium delivery-cost-summary dark:text-white">۳۵,۰۰۰ تومان</span>
                        </div>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-gray-600 dark:text-white">زمان تحویل:</span>
                            <span class="font-medium delivery-time-summary dark:text-white">فردا - جمعه ۹ صبح تا ۱۲ ظهر</span>
                        </div>
                    </div> *@
                </div>
            </div>
            <!-- calculate -->
            <CartCalculatePrice EventSubmitCustomerInfo="SubmitCustomerInfo" EnumUrlType="EnumUrlType.Function" GoTitle="ادامه فرآیند پرداخت" BackUrl="/Cart" />

        </div>
    </div>
</section>

