    private async Task<bool> ChackSelectedCartForSendProductMethod()
    {
        var data = await RootApiResultCart.RunMethodApi($"Carts/Public", null, method: Method.Get);
        if (data == null)
            return false;

        resultCart = data.Entity;
        if (resultCart.SendProductMethodID != null)
                return true;
        return false;
    }
