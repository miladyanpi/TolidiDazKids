    private async Task Delete(string identitiCode)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {

            var data = await RootApiDelete.RunMethodApi($"CustomerAddresss/Delete/Public/{identitiCode}", null, method: Method.Delete);
            if (data.Status == ResultMessageApi.Success)
            {
                await JS.CallAlertToast(data.Message);
                await GetData();

            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = data.Message,
                    Icon = data.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }
    private bool ChackSelected()
    {
        bool flag = false;
        foreach (var item in updateCustomer.UpdateCustomerAddresss)
        {
            if (item.Default == true)
                flag = true;
        }
        return flag;
    }
    private async Task GetCart()
    {
        var data = await RootApiResultCart.RunMethodApi($"Carts/Public", null, method: Method.Get);
        if (data != null)
            resultCart = data.Entity;
        int i = -1;
        foreach (var item in ResultSendProductMethods)
        {
            i++;
            if (item.ID == resultCart.SendProductMethodID)
                ResultSendProductMethods[i].Default = true;
        }
    }
    private async Task GetSendProductMethod()
    {
        var data = await RootApiSendProductMethod.RunMethodApi($"SendProductMethods/Public/All", null, method: Method.Get);
        if (data != null)
            ResultSendProductMethods = data.Entities.ToList();
    }
