                        <div class="flex items-center justify-between mb-4">
                            <h1 class="font-bold text-lg relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">
                                تکمیل اطلاعات ارسال
                            </h1>
