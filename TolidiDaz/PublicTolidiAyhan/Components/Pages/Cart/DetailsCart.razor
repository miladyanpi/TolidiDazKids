    {
        var data = await RootApiUpdateCustomer.RunMethodApi($"CustomerAddresss/Add/Public", addCustomerAddresss, method: Method.Post);
        if (data.Status == ResultMessageApi.Success)
        {
            addCustomerAddresss = new AddCustomerAddress
            {
                CustomerID = addCustomerAddresss.CustomerID,
                CityID = addCustomerAddresss.CityID,
