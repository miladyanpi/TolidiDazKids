    private async Task GetProvinces()
    {
        var data = await RootApiResultProvinces.RunMethodApi($"Provinces/Public/All", null, method: Method.Get);
        if (data.Status == ResultMessageApi.Success)
        {
            ResultProvinces = data.Entities.ToList();
            ResultProvinces2 = data.Entities.ToList();
        }

        if (ResultProvinces.Count > 0)
            updateCustomerAddresss.ProvinceID = ResultProvinces[0].ID;
        if (ResultProvinces2.Count > 0)
            addCustomerAddresss.ProvinceID = ResultProvinces2[0].ID;

    }
    private async Task GetCity()
    {
        updateCustomerAddresss.CustomerID = updateCustomer.ID;
        var data = await RootApiResultCitys.RunMethodApi($"Citys/All?ProvinceID={updateCustomerAddresss.ProvinceID}", null, method: Method.Get);

        if (data.Status == ResultMessageApi.Success)
        {
            ResultCitys = data.Entities.ToList();
            ResultCitys2 = data.Entities.ToList();
        }

        if (ResultCitys.Count > 0)
            updateCustomerAddresss.CityID = ResultCitys[0].ID;
        if (ResultCitys2.Count > 0)
            addCustomerAddresss.CityID = ResultCitys2[0].ID;
    }
    private async Task GetData()
    {
        var data = await RootApiUpdateCustomer.RunMethodApi($"Customers/GetInfo/Public", null, method: Method.Get);
        updateCustomer = data.Entity;
        updateCustomerInfo.Name = updateCustomer.Name;
        updateCustomerInfo.LastName = updateCustomer.LastName;
        updateCustomerInfo.Mcode = updateCustomer.Mcode;
        foreach (var item in updateCustomer.UpdateCustomerAddresss)
        {
            if (item.Default)
            {
                updateCustomerAddresss.ProvinceID = item.ProvinceID;

            }

        }
        await GetCity();
    }
