                        </div>
                    </div>

                    <!-- Select the product to send -->
                    <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4">
                        <h2 class="font-bold text-lg mb-4 relative pb-4 before:absolute before:right-0 before:bottom-0 before:size-2 before:rounded-full before:bg-primary after:absolute after:w-40 after:h-2 after:bottom-0 after:right-4 after:bg-primary after:rounded-lg">محصولات سبد خرید شما</h2>

                        <div class="space-y-4">
                            @foreach (var item in cartCalculatorPriceService.Items)
                            {
                                <div class="flex items-center border-b border-gray-100 pb-4">
                                    @if (item.ResultProduct.ResultUploadFiles.Count > 0)
                                    {
                                        string filepath1 = ApiLink.FullPath + item.ResultProduct.ResultUploadFiles[0].PathFileName;
                                        <img src="@filepath1" alt="@item.ResultProduct.Title" class="w-16 h-16 object-cover rounded-md">
