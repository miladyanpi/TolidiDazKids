@page "/Cart"
@using CurrieTechnologies.Razor.SweetAlert2
@using Dto.Enum
@using Dto.Models.Constant
@using Dto.Models.DtoCartItem
@using Dto.Models.ResponseApi
@using Microsoft.AspNetCore.Authorization
@using PublicTolidiAyhan.Code
@using PublicTolidiAyhan.Services

@using RestSharp
@using ServicesLibrary.Services.PricingRuleSrv
@inject IRootApi<ResponseApiEntities<ResultCartItem>> RootApiResultCartItem
@inject IRootApi<ResponseApiEntity<ResultCartItem>> RootApiDelete
@inject IToastMessage JS
@inject CartPublicService CartService
@inject SweetAlertService Swal
@inject NavigationManager NavManager
@inject CartCalculatorPriceService cartCalculatorPriceService
@inject IPricingRuleService _pricingRuleService
@inject LoginStatusCheckService _LoginStatusCheckService

@attribute [Authorize(Roles = ConstantRoles.CustomerName + "," + ConstantRoles.BranchStoreName)]
<!-- ================= start content section ================= -->
<section class="py-5">
    <div class="container">
        <!-- stepper -->
        <ol class="flex items-center w-full bg-white rounded-lg drop-shadow-lg border border-gray-300 mb-4 p-3 space-x-2 text-sm font-medium text-center text-gray-500 dark:text-gray-400 sm:text-base dark:bg-gray-800  sm:p-4 sm:space-x-4 rtl:space-x-reverse">
            <li class="flex font-bold text-primary items-center">
                <span class="flex items-center justify-center w-5 h-5 me-2 text-xs border rounded-full shrink-0 ">
                    1
                </span>
                جزئیات <span class="hidden sm:inline-flex sm:ms-2">سبد خرید</span>
                <svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                     fill="none" viewBox="0 0 12 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="m7 9 4-4-4-4M1 9l4-4-4-4" />
                </svg>
            </li>
            <li class="flex items-center">
                <span class="flex items-center justify-center w-5 h-5 me-2 text-xs border border-gray-500 rounded-full shrink-0 dark:border-gray-400">
                    2
                </span>
                جزئیات <span class="hidden sm:inline-flex sm:ms-2">سفارش</span>
                <svg class="w-3 h-3 ms-2 sm:ms-4 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                     fill="none" viewBox="0 0 12 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="m7 9 4-4-4-4M1 9l4-4-4-4" />
                </svg>
            </li>
            <li class="flex items-center">
                <span class="flex me-2 items-center justify-center w-5 h-5 ms-2 text-xs border border-gray-500 rounded-full shrink-0 dark:border-gray-400">
                    3
                </span>
                جزئیات <span class="hidden sm:inline-flex sm:ms-2">پرداخت</span>
            </li>
        </ol>

        <!-- content -->
        @if (CartService.resultCartItems.Count > 0)
        {
            <div class="grid gap-4 relative grid-cols-4">
                <!-- product -->
                <div class="xl:col-span-3 col-span-4 w-full">
                    <ul class="space-y-4">
                        @foreach (var item in CartService.resultCartItems)
                        {
                          
                            var Price = _pricingRuleService.CalculatePrice(item.ResultProduct, item == null ? 0 : item.Quantity, Roles, ResulLoginStatus.IsLoggedIn);
                            var NewPrice = item.ResultProduct.Discount > 0 ? (Price - item.ResultProduct.Discount) : Price;

                            var SumDiscount = item.ResultProduct.Discount > 0 ? item.Quantity * item.ResultProduct.Discount : 0;
                            var SumNewPrice = item.Quantity * NewPrice;
                            float percent = ((float)item.ResultProduct.Discount / (float)Price) * 100;
                            percent = (float)Math.Round(percent, 2);

                            <li>
                                <div class="grid grid-cols-4 gap-4 dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4">
                                    <div class="lg:col-span-3 col-span-4 w-full">
                                        <div class="flex flex-wrap">
                                            <figure>
                                                <a href="#" @onclick="@(() => GotoProductDetails(item.ResultProduct.IdentityCode.ToString()))" class="text-gray-800 dark:text-white" itemprop="name">
                                                @if (item.ResultProduct.ResultUploadFiles.Count > 0)
                                                {
                                                    string filepath1 = ApiLink.FullPath + item.ResultProduct.ResultUploadFiles[0].PathFileName;
                                                    <img style="border-radius:50px;margin-left:20px;" class="size-40" src="@filepath1" alt="@item.ResultProduct.Title">
                                                }
                                                else
                                                {
                                                    <img class="size-40" src="images/No-Product-Image.png" alt="">
                                                }
                                                </a>
                                            </figure>
                                            <div class="space-y-5">
                                                <div class="flex sm:space-y-0 space-y-2 item-center flex-wrap">
                                                    <h3 class="sm:w-auto w-full font-bold"> @item.ResultProduct.Title (کد:@item.ResultProduct.ProductCode)</h3>
                                                    <h6 class="sm:w-auto w-full font-bold"></h6>
                                                    @if (item.ResultProduct.Discount > 0)
                                                    {
                                                        <span class="bg-secondary px-3 rounded-bl-none text-sm rounded-xl text-white sm:ms-3" itemprop="discount">@percent%</span>
                                                    }
                                                </div>
                                                <div class="flex item-center space-x-2">
                                                    <div>
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
                                                        </svg>
                                                    </div>
                                                    <h6 class="font-bold">فروشنده:</h6>
                                                    <span class="block">@_PublicSettingService.ResultPublicSetting.Name</span>
                                                </div>
                                                <div class="flex item-center space-x-2">
                                                    <div>
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                                                        </svg>
                                                    </div>
                                                    <h6 class="font-bold">گارانتی:</h6>
                                                    <span class="block">تضمین کیفیت</span>
                                                </div>
                                                <div class="flex items-center">
                                                    <div class="inline-flex items-center space-x-2 border rounded-full px-4 py-2 dark:bg-zinc-800 bg-white shadow">
                                                        <button @onclick="@(async () => await AddToCart1Item(item.ProductID))" class="bg-gray-500 text-white w-8 h-8 rounded-full flex items-center justify-center text-lg">
                                                            +
                                                        </button>
                                                        <span id="count2" class="text-lg  px-5 inline-block">@item.Quantity</span>
                                                        <button @onclick="@(async () => await SubFromCart1Item(item.ProductID))" class="bg-gray-200 text-gray-600 w-8 h-8 rounded-full flex items-center justify-center text-lg">
                                                            -
                                                        </button>
                                                    </div>
                                                    <button @onclick="@(async () => await Delete(item.ID))" class="block p-2 bg-red-600 rounded-full text-white ms-2 mt-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="lg:col-span-1 col-span-4 w-full">
                                        <div class="space-y-5 flex flex-col xl:items-end xl:justify-end">
                                            @*  @if (item.ResultProduct.Discount > 0)
                                            {
                                                <del class="text-zinc-400" itemprop="priceSpecification" itemscope="" itemtype="http://schema.org/UnitPriceSpecification">
                                                    <meta itemprop="priceCurrency" content="IRR">
                                                    <span itemprop="price">@item.ResultProduct.Price.ToString("N0")</span>
                                                </del>
                                            }
                                            else
                                            {
                                                <del class="text-zinc-400" itemprop="priceSpecification" itemscope="" itemtype="http://schema.org/UnitPriceSpecification">
                                                    <meta itemprop="priceCurrency" content="IRR">
                                                    <span itemprop="price">&nbsp;</span>
                                                </del>
                                            } *@
                                            <div class="text-gray-700 flex flex-col items-center">
                                                <div class="flex justify-between items-center">
                                                    @if (item.ResultProduct.Discount > 0)
                                                    {
                                                        <del class="text-zinc-400" itemprop="priceSpecification" itemscope
                                                             itemtype="http://schema.org/UnitPriceSpecification">
                                                            <meta itemprop="priceCurrency" content="IRR">
                                                            <span itemprop="price">@Price</span>
                                                        </del>
                                                        <span class="bg-secondary px-3 rounded-bl-none text-sm rounded-xl text-white ms-3"
                                                              itemprop="discount">@percent%</span>
                                                    }
                                                </div>

                                                <span class="text-l font-bold dark:text-white" itemprop="price">
                                                    <span> قیمت محصول: </span>
                                                    <span class="text-blue-600 dark:text-blue-400">
                                                        @NewPrice.ToString("N0")
                                                    </span>
                                                    <span class="text-xs">تومان</span>
                                                </span>


                                            </div>
                                            @if (item.ResultProduct.Discount > 0)
                                            {
                                                <span class="text-l block font-bold dark:text-white" itemprop="price">
                                                    <span>جمع تخفیف: </span>
                                                    <span class="text-red-600 dark:text-red-500">
                                                        @SumDiscount.ToString("N0")
                                                    </span>
                                                    <span class="text-xs">تومان</span>
                                                </span>


                                            }
                                            <span class="text-l block font-bold dark:text-white"
                                                  itemprop="price"
                                                  content="@SumNewPrice.ToString("N0")">
                                                <span>جمع: </span>
                                                <span class="text-green-600 dark:text-green-400">
                                                    @SumNewPrice.ToString("N0")
                                                </span>
                                                <span class="text-xs">تومان</span>
                                            </span>

                                            <a href="#" class="flex justify-center items-center border p-2 rounded-3xl hover:bg-gray-200 transition dark:hover:bg-zinc-700">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 me-2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                                </svg>
                                                <span>
                                                    ذخیره در لیست خرید بعدی
                                                </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }


                    </ul>
                </div>
                <!-- calculate -->
                <CartCalculatePrice GoUrl="/DetailsCart" GoTitle="ادامه فرآیند پرداخت" />
            </div>
        }
        else
        {

            <!-- content -->
            <div class="dark:bg-gray-800 dark:text-white bg-white rounded-lg drop-shadow-lg border-gray-300 border-1 p-4">
                <div class="flex items-center flex-col space-y-5 justify-center w-full">
                    <img src="assets/images/cart/empty-cart.png" class="size-60" alt="">
                    <h2 class="font-black text-3xl">سبد خرید شما خالی است</h2>
                </div>
            </div>


        }
    </div>
</section>
<!-- ================= end content section ================= -->
@code {
    long NewPrice = 0;
    float percent = 0;
    (bool IsLoggedIn, string Name, string UserName, string Role) ResulLoginStatus = new();
    List<string> Roles = new List<string>();
    protected override async Task OnInitializedAsync()
    {

        await GetData();
        // ResultCartItems = cartCalculatorPriceService.Items;

    }
    private async Task GetData(string? SearchText = "")
    {
        await CartService.GetCartItems();
        ResulLoginStatus = await _LoginStatusCheckService.GetLoginStatusCheck();
        Roles.Add(ResulLoginStatus.Role);
    }


    private async Task AddToCart1Item(int productID)
    {
        var Result = await CartService.AddToCart1Item(productID);
        if (Result.Status == ResultMessageApi.Success)
        {
            var CartItem = CartService.resultCartItems.Where(s => s.ProductID == productID).FirstOrDefault();
            //CartItem.Quantity += 1;
        }
        else
        {
            _ = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = Result.Message,
                Icon = Result.Status,
                ShowConfirmButton = true,
            });
        }
    }
    private async Task SubFromCart1Item(int productID)
    {
        var Result = await CartService.SubFromCart1Item(productID);
        if (Result.Status == ResultMessageApi.Success)
        {
            var CartItem = CartService.resultCartItems.Where(s => s.ProductID == productID).FirstOrDefault();
           // CartItem.Quantity -= 1;
           // CartItem.Quantity = CartItem.Quantity <= 0 ? 1 : CartItem.Quantity;
        }
        else
        {
            _ = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = Result.Message,
                Icon = Result.Status,
                ShowConfirmButton = true,
            });
        }
    }
    private async Task Delete(int ID)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {

            var resdata = await RootApiDelete.RunMethodApi($"CartItems/Public/{ID}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {

                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }
    private async Task GotoProductDetails(string UniqCode)
    {
        var parameter = new Dictionary<string, object>
        {
            {"UniqCode", UniqCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/ProductDetails", parameter!));
    }

}