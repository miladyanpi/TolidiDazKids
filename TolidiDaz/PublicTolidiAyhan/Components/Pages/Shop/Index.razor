@code{
    @inject NavigationManager NavManager
    private PagingModel pagingModel { get; set; } = new();
    [SupplyParameterFromQuery]
    public string? Code { get; set; }
    private List<ResultProduct>? ResultProducts { get; set; } = new List<ResultProduct>();
    private ResultCategory? ResultCategory { get; set; } = new ResultCategory();
    [SupplyParameterFromQuery]
    public string? SearchText { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        pagingModel.Page = 1;
        pagingModel.Take = BaseCode.GetCountShowRecord();
        await GetData();
    }

    private async Task GetData()
    {
        int Count = 0;
        var Search = BaseCode.GetSearchText(SearchText);

        if(Code==null)
        {
            var data2 = await RootApiGet.RunMethodApi($"Products/ByGuidCategory?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&UniqCode={Code}", null, method: Method.Get);
            if (data2!=null&&data2.Status == ResultMessageApi.Success)
            {
                Count = data2.CountAllRecordTable;
                ResultProducts = data2.Entities.ToList();
            }
            pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
            pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
            return;
        }

        var data = await RootApiGetResultCategory.RunMethodApi($"Categorys/Public/UniqCode?UniqCode={Code}", null, method: Method.Get);
        if(data==null)
        {
            return;
        }
        ResultCategory = data.Entity;
        if (data.Entity.ParentID==null)
        {
            PaginationParamsIDs paginationParamsIDs = new();
            List<int>? IDs = new List<int>();
            foreach(var item in data.Entity.ResultCategorys)
            {
                foreach (var item2 in item.ResultCategorys)
                {
                    IDs.Add(item2.ID);
                }
            }
            PaginationParamsModel paginationParams = new PaginationParamsModel
            {
                Page = (int)pagingModel.Page,
                Take = (int)pagingModel.Take,
                SearchText = SearchText == null ? string.Empty : SearchText.Trim(),

            };
            paginationParamsIDs.Pagination = paginationParams;
            paginationParamsIDs.IDs = IDs;

            //
            var data2 = await RootApiGet.RunMethodApi($"Products/CategoryIDS", paginationParamsIDs, method: Method.Post);
            if (data2.Status == ResultMessageApi.Success)
            {
                Count = data2.CountAllRecordTable;
                ResultProducts = data2.Entities.ToList();
            }

        }
        else
        {
            var data2 = await RootApiGet.RunMethodApi($"Products/ByGuidCategory?Page={pagingModel.Page}&Take={pagingModel.Take}{Search}&UniqCode={Code}", null, method: Method.Get);
            if (data2.Status == ResultMessageApi.Success)
            {
                Count = data2.CountAllRecordTable;
                ResultProducts = data2.Entities.ToList();
            }
        }
       
        pagingModel.CountPage = Math.Ceiling(Count / pagingModel.Take);
        pagingModel.CountPagePer10 = Math.Ceiling(pagingModel.CountPage / 10);
    }
  
    private async Task CallBackPaging(decimal page)
    {
        pagingModel.Page = page;
        await GetData();
    }
  
