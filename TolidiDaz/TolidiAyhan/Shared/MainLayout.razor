@code
{
    public string? SearchText { get; set; } = string.Empty;
    @inject IJSRuntime JS
    @inject CartService cartService
    @inject NavigationManager NavManager
    @inject AuthenticationStateProvider _AuthStateProvider
    private bool isScriptsLoaded = false;
    private bool IsLoggedIn;
    string Name = string.Empty;
    string Mobile = string.Empty;
    private string UserName = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        var authState = await _AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;
        if (IsLoggedIn)
        {
            Name = user.Claims.First(s => s.Type == ClaimTypes.Name).Value;
            Mobile = user.Claims.First(s => s.Type == ClaimTypes.UserData).Value;
        }

        cartService.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        cartService.OnChange -= StateHasChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var authState = await _AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;
        if(IsLoggedIn)
        {
            UserName = user.Identity.Name;
        }
        

        if (firstRender && !isScriptsLoaded)
        {
            // لود اسکریپت‌ها فقط در اولین رندر
            await LoadScriptsAsync();
            await cartService.GetCartItems();
            isScriptsLoaded = true; // پرچم را تنظیم کنید تا از لود مجدد جلوگیری شود
        }
        // لود داده‌های استوری‌ها و ارسال به جاوااسکریپت

    }
    private async Task LoadScriptsAsync()
    {
        await JS.InvokeVoidAsync("loadScript", "/assets/js/plugin/swiper/swiper-bundle.min.js");
        await JS.InvokeVoidAsync("loadScript", "/assets/js/dependencies/swiper-script.js");
        await JS.InvokeVoidAsync("loadScript", "/assets/js/dependencies/app.js");
        isScriptsLoaded = true;
    }
  
    private void GoToCart()
    {
        NavManager.NavigateTo("/Cart");
    }
  
    private async Task GoShop()
    {
        var parameter = new Dictionary<string, object>
        {
            {"SearchText", SearchText},


        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Shop", parameter!));
    }
    private async Task Search(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GoShop();  // اینجا SearchText همیشه مقدار جدید دارد ✔️
        }
    }
}
