@inject RootApi<ResponseApiEntities<ResultCategory>> RootApiGet
@inject IJSRuntime JS
<div id="megaMenu" class="xl:grid hidden relative grid-cols-12 place-items-center">
    <div class="col-span-10 place-self-start">
        <nav class="flex gap-x-9 mt-10 items-center">
            <!-- menu -->
            <ul class="flex dark:text-white items-center space-x-8 tracking-tight">
                <li id="mega-menu-fire" class="py-2">
                    <a href="" class="flex font-bold hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 me-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                        </svg>
                        فروشگاه
                    </a>
                    <div id="mega-menu-fire-target"
                         class="bg-white dark:bg-zinc-900 container z-50 hidden top-[90%] drop-shadow-sm absolute mt-1 ml-10 shadow-md rounded-b-md">
                        <div class="grid grid-cols-12">
                            <div class="col-span-2 h-[400px] overflow-y-scroll border-l border-gray-400">
                                <ul class="my-2 space-y-1">

                                    @foreach (var item in ResultCategorys)
                                    {
                                        <li data-mega-id="@item.ID.ToString()"
                                            class="px-4 w-full hover:bg-opacity-70 border-opacity-0 hover:border-opacity-100 rounded-lg dark:hover:text-zinc-950 mega-menu-li
                                                    @(SelectedId == item.ID ? "bg-gray-100" : "")"
                                            @onmouseenter="() => ShowCategory(item.ID)">

                                            <a href="#" class="flex items-center justify-between py-3">
                                                <div class="flex items-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"
                                                         viewBox="0 0 20 20"
                                                         fill="currentColor">
                                                        <path fill-rule="evenodd"
                                                              d="M3 5a2 2 0 012-2h10a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5zm11 1H6v8l4-2 4 2V6z"
                                                              clip-rule="evenodd" />
                                                    </svg>
                                                    <div class="mr-1">
                                                        <p class="text-xs">@item.Title</p>
                                                    </div>
                                                </div>
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     class="h-5 w-5 text-gray-500" fill="none"
                                                     viewBox="0 0 24 24"
                                                     stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                          stroke-width="2"
                                                          d="M15 19l-7-7 7-7" />
                                                </svg>
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                            <div class="col-span-10 bg-white dark:bg-zinc-900">
                                @{
                                    int i = 0;
                                    string hidden = string.Empty;
                                }

                                @foreach (var item in ResultCategorys)
                                {

                                    var resultCategorys = item.ResultCategorys;
                                    var pathfile = item.ResultUploadFiles != null && item.ResultUploadFiles.Count > 0 ? ApiLink.FullPath + item.ResultUploadFiles[0].PathFileName : "images/No-Product-Image.png";
                                    var recordCount = Math.Ceiling((float)resultCategorys.Count() / 3);
                                    i++;
                                    int k = i;
                                    if (k == 1)
                                    {
                                        hidden = string.Empty;
                                    }
                                    else
                                    {
                                        hidden = "hidden";

                                    }
                                    <div data-mega-target="@item.ID.ToString()" class="grid  h-[400px] overflow-y-scroll grid-cols-8 gap-10 m-3
                                                    @(SelectedId == item.ID ? "" : "hidden")">
                                        @for (int page = 1; page <= recordCount; page++)
                                        {
                                            int Take = 4;
                                            int Skip = (Take * page) - Take;
                                            var Results = resultCategorys.Skip(Skip).Take(Take).ToList();

                                            <div class="col-span-2">
                                                @foreach (var item2 in Results)
                                                {
                                                    <div class="mb-4">
                                                        <p class="text-sm font-bold">@item2.Title</p>

                                                        <div class="mt-3 space-y-4">
                                                            @foreach (var item3 in item2.ResultCategorys)
                                                            {
                                                                <a  @onclick="@(() => GoToShop(item3.IdentityCode.ToString()))" 
                                                                   class="text-xs text-gray-600 block hover:text-primary dark:text-gray-300">
                                                                    @item3.Title

                                                                </a>
                                                            }

                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <!-- menu thumbnail banner -->
                                        <div class="col-span-2">
                                            <div class="ml-4">
                                                <a href="">
                                                    <img src="@pathfile" loading="lazy"
                                                         alt=""
                                                         class="w-full rounded-lg">
                                                </a>
                                            </div>
                                        </div>
                                    </div>




                                }

                            </div>
                        </div>
                    </div>
                </li>
                <li class="py-2">
                    <a href="#" @onclick="(() => GoToHome())" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        <span>صفحه اصلی</span>
                    </a>
                </li>
                <li class="py-2">
                    <a href="/Shop" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
                        </svg>
                        <span>لیست کالا ها</span>
                    </a>
                </li>
                <li class="py-2">
                    <a href="" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
                        </svg>
                        <span>سوالی دارید</span>
                    </a>
                </li>
                <li class="py-2">
                    <a href="" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                        </svg>
                        <span>پیگیری سفارش</span>
                    </a>
                </li>
                <li class="py-2">
                    <a href="" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z" />
                        </svg>
                        <span>بلاگ</span>
                    </a>
                </li>
                <li class="py-2">
                    <a href="" class="flex space-x-3 hover:text-primary transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" class="size-6 dark:text-white">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                        </svg>
                        <span>تماس با ما</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    <div class="col-span-2 place-self-end place-items-center py-2">
        <div class="text-left dark:text-white before:animate-pulse before:w-22 before:h-1 before:bg-primary before:absolute before:left-1/2 relative before:-translate-x-1/2 before:-bottom-5 before:rounded-l">
            <a href="">فروش ویژه</a>
        </div>
    </div>
</div>



@code {
    @inject NavigationManager NavManager

    private List<ResultCategory>? ResultCategorys { get; set; } = new List<ResultCategory>();
    private int? SelectedId { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetData();
        }
    }
   
    private async Task GetData(string? SearchText = "")
    {
        var (data, authorized) = await RootApiGet.RunMethodApi($"Categorys/Public?ParentID={null}", null, method: Method.Get);
        if (authorized)
        {
            ResultCategorys = data.Entities.ToList();
            StateHasChanged();
        }
        
    }
    private void ShowCategory(int id)
    {
        SelectedId = id;
    }
    private void GoToHome()
    {
        NavManager.NavigateTo("/", forceLoad: true);
    }
  
    private void GoToShop(string? guid)
    {
        var parameter = new Dictionary<string, object>
        {
            {"Code", guid},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/Shop", parameter!));
    }
}

