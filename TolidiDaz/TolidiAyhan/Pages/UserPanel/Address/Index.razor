@page "/Address"
@using Dto.Models.DtoCustomerAddress
@using TolidiAyhan.Code
<!-- Page content -->
<main class="flex-1 overflow-y-auto p-6 bg-gray-50 dark:bg-background-dark">
    <!-- Page header -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-dark dark:text-light">آدرس‌های من</h2>
            <p class="text-gray-600 dark:text-gray-400">مدیریت آدرس‌های تحویل سفارش و صورتحساب</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/InsertAddress" class="flex items-center px-4 py-2 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary/90 dark:bg-primary-dark dark:hover:bg-primary/80 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                افزودن آدرس جدید
            </a>
        </div>
    </div>

    <!-- List of addresses -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- address one -default -->
        @foreach (var item in UpdateCustomerAddresses)
        {
            if (item.Default)
            {
                <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 border-2 border-primary dark:border-primary-dark relative">
                    <div class="absolute top-1 left-4">
                        <span class="px-2 py-1 text-xs rounded-full bg-primary text-white dark:bg-primary-dark">پیش‌فرض</span>
                   
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-medium text-dark dark:text-light mb-2">آدرس</h3>
                            <h3 class="text-lg font-medium text-dark dark:text-light mb-2">استان: @item.ResultProvince.Title  /  شهر: @item.ResultCity.Title</h3>
                            <div class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
                                <p>آدرس:@item.Address</p>
                                <p>کد پستی: @item.PostalCode</p>
                                <p>واحد: @item.BuildingUnit</p>
                                <p>پلاک: @item.Plaque</p>
                                <p>نام مشتری: @item.ResultCustomer.Name @item.ResultCustomer.LastName - @item.ResultCustomer.Mobile</p>
                                <p>توضیحات: @item.Description</p>

                            </div>
                        </div>
                        <div class="flex space-x-2 space-x-reverse">
                            <button @onclick="@(() => GoToUpdate(item.IdentityCode.ToString()))"
                                    class="p-3 text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </button>

                            <button @onclick="@(async () => await Delete(item.IdentityCode.ToString()))" class="text-danger dark:text-danger-dark hover:text-danger/80 dark:hover:text-danger-dark/80">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-end">
                        <button class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 inline" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                            </svg>
                            مشاهده روی نقشه
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- address two -->
                <div class="bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 border border-gray-200 dark:border-gray-700 relative">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-medium text-dark dark:text-light mb-2">آدرس</h3>
                            <h3 class="text-lg font-medium text-dark dark:text-light mb-2">استان: @item.ResultProvince.Title   / شهر: @item.ResultCity.Title</h3>
                            <div class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
                                <p>آدرس:@item.Address</p>
                                <p>کد پستی: @item.PostalCode</p>
                                <p>واحد: @item.BuildingUnit</p>
                                <p>پلاک: @item.Plaque</p>
                                <p>نام مشتری: @item.ResultCustomer.Name @item.ResultCustomer.LastName - @item.ResultCustomer.Mobile</p>
                                <p>توضیحات: @item.Description</p>

                            </div>
                        </div>
                        <div class="flex space-x-2 space-x-reverse">
                            <button @onclick="@(() => GoToUpdate(item.IdentityCode.ToString()))"
                                    class="p-3 text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </button>

                            <button @onclick="@(async () => await Delete(item.IdentityCode.ToString()))" class="text-danger dark:text-danger-dark hover:text-danger/80 dark:hover:text-danger-dark/80">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-between items-center">
                        <button class="text-sm text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 inline" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                            </svg>
                            مشاهده روی نقشه
                        </button>
                        <button @onclick="@(async () =>await Update(item.ID))" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                            تنظیم به عنوان پیش‌فرض
                        </button>
                    </div>
                </div>

            }

        }

        <!-- button create address -->
        <div class="md:hidden bg-white dark:bg-card-dark rounded-xl shadow-soft dark:shadow-soft-dark p-6 border-2 border-dashed border-gray-300 dark:border-gray-600 flex items-center justify-center">
            <button onclick="openAddressModal()" class="flex flex-col items-center text-primary dark:text-primary-dark hover:text-primary/80 dark:hover:text-primary-dark/80">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mb-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                <span>افزودن آدرس جدید</span>
            </button>
        </div>
    </div>
</main>

@code {
    @inject RootApi<ResponseApiEntities<UpdateCustomerAddress>> RootApiGet
    @inject RootApi<ResponseApiEntity<ResultCustomerAddress>> RootApiDelete
    @inject RootApi<ResponseApiEntity<UpdateCustomerAddress>> RootApiUpdateCustomerAddress

    @inject SweetAlertService Swal
    @inject IToastMessage JS
    @inject NavigationManager NavManager
    List<UpdateCustomerAddress> UpdateCustomerAddresses { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await GetData();
    }
    private async Task GetData()
    {
        var (data, authorized) = await RootApiGet.RunMethodApi($"CustomerAddresss/Public", null, method: Method.Get);
        if (authorized)
        {
            UpdateCustomerAddresses = data.Entities.ToList();
        }
    }
    private async Task Delete(string Code)
    {
        var result1 = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "برای حذف مطمئن هستید؟",
            Text = "درصورت تایید شما، رکورد انتخاب شده حذف خواهد شد",
            ShowCancelButton = true,
            ConfirmButtonText = "بله",
            CancelButtonText = "خیر"
        });
        if (!string.IsNullOrEmpty(result1.Value))
        {

            var (resdata, authorized) = await RootApiDelete.RunMethodApi($"CustomerAddresss/Delete/Public/{Code}", null, method: Method.Delete);
            if (resdata.Status == ResultMessageApi.Success)
            {
                await JS.CallAlertToast(resdata.Message);
                await GetData();
            }
            else
            {
                _ = await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "پیام",
                    Text = resdata.Message,
                    Icon = resdata.Status,
                    ShowConfirmButton = true,
                });
            }
        }
    }
    private void GoToUpdate(string identityCode)
    {
        var parameter = new Dictionary<string, object>
        {
            {"identityCode",identityCode},
        };
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters("/EditAddress", parameter!));
    }
    private async Task Update(int ID)
    {
        var (resdata2, auth2) = await RootApiUpdateCustomerAddress.RunMethodApi($"CustomerAddresss/Update/Public/SetDefault/{ID}", null, method: Method.Patch);

        if (resdata2.Status == ResultMessageApi.Success)
        {
            await GetData();
            await JS.CallAlertToast(resdata2.Message);
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text ="به عنوان آدرس پیش فرض تنظیم شد",
                Icon = resdata2.Status,
                ShowConfirmButton = true,
            });
        }
        else
        {
            var result2 = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "پیام",
                Text = resdata2.Message,
                Icon = resdata2.Status,
                ShowConfirmButton = true,
            });
        }


    }
}
