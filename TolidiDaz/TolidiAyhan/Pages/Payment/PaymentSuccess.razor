@page "/Payment-Success"
@* @attribute [Authorize(Roles = ConstantRoles.CustomerName)] *@
<div class="min-h-screen flex flex-col justify-center items-center p-4">
    <div class="w-full max-w-md bg-white rounded-lg shadow-lg overflow-hidden border border-green-100">
        <!-- Header -->
        <div class="bg-green-600 dark:bg-green-950 p-6 text-center">
            <div class="success-animation mx-auto w-20 h-20 bg-white dark:bg-gray-600 rounded-full flex items-center justify-center text-green-600 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white">پرداخت موفق</h1>
            <p class="text-green-100 mt-2">سفارش شما با موفقیت ثبت شد</p>
        </div>

        <!-- Content -->
        <div class="p-6 dark:bg-zinc-800">
            <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <span class="text-gray-600 dark:text-white">شماره سفارش:</span>
                <span class="font-medium dark:text-white">@OrderCode</span>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <span class="text-gray-600 dark:text-white">تاریخ پرداخت:</span>
                <span class="font-medium dark:text-white">@DateOrder</span>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <span class="text-gray-600 dark:text-white">مبلغ پرداختی:</span>
                <span class="font-medium dark:text-white text-green-600">@Amount <span class="text-sm">ریال</span></span>
            </div>
            <div class="flex justify-between items-center py-3">
                <span class="text-gray-600 dark:text-white">روش پرداخت:</span>
                <span class="font-medium dark:text-white flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 ml-1">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                    </svg>
                    کارت بانکی
                </span>
            </div>

            <div class="mt-6 dark:bg-zinc-700 bg-blue-50 border border-blue-100 rounded-lg p-4 flex items-start">
                <div>
                    <p class="text-blue-800 dark:text-white text-sm">رسید پرداخت به ایمیل و پیامک شما ارسال شد. برای پیگیری سفارش می‌توانید به بخش <a href="/Order" class="font-bold underline">سفارشات من</a> مراجعه کنید.</p>
                </div>
            </div>

            <div class="mt-6 flex flex-col space-y-3">
                <a href="/Order" class="bg-green-600 dark:bg-green-900 hover:bg-green-700 text-white py-3 px-4 rounded-lg font-medium dark:text-white text-center flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 ml-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                    </svg>
                    مشاهده سفارش
                </a>
                <a href="/" class="border border-gray-300 hover:bg-gray-50 text-gray-700 py-3 px-4 rounded-lg font-medium dark:text-white text-center flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 ml-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
                    بازگشت به خانه
                </a>
            </div>
        </div>

        <!-- Footer -->
        <div class="bg-gray-50 dark:bg-zinc-700 dark:text-gray-200 p-4 text-center text-sm text-gray-500">
            <p>در صورت هرگونه سوال با پشتیبانی تماس بگیرید</p>
            <div class="mt-2 flex justify-center space-x-4 space-x-reverse">
                <a href="tel:09039637334" class="text-blue-500 hover:text-blue-700">
                    <i class="fab fa-telegram text-xl">0903-963-7334</i>
                </a>
                <a href="#" class="text-green-500 hover:text-green-700">
                    <i class="fab fa-whatsapp text-xl"></i>
                </a>
                <a href="#" class="text-blue-600 hover:text-blue-800">
                    <i class="fab fa-instagram text-xl"></i>
                </a>
            </div>
        </div>
    </div>

   
</div>

@code {
    [SupplyParameterFromQuery]
    public string? OrderCode { get; set; }
    [SupplyParameterFromQuery]
    public string? DateOrder { get; set; }
    [SupplyParameterFromQuery]
    public string? Amount { get; set; }
    protected override async Task OnInitializedAsync()
    {
        string formattedAmount;

        if (decimal.TryParse(Amount, out var amountDecimal))
        {
            formattedAmount = amountDecimal.ToString("N0");
        }
        else
        {
            formattedAmount = "0";
        }
        Amount = formattedAmount;

    }
}
