    private async Task LoadStoriesAsync()
    {
        stories = await GetStoriesAsync();
        try
        {
            await JS.InvokeVoidAsync("initStories", stories);
        }
        catch (JSDisconnectedException)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
        }
    }

    public async Task<List<StoryItem>> GetStoriesAsync()
    {
        int i = 0;
        List<StoryItem> StoryItems = new List<StoryItem>();
        foreach (var item in ResultStorys)
        {
            i++;
            ResultUploadImages = item.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonPicture) : new List<ResultUploadFile>();
            ResultUploadVideo = item.JsonVideo != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonVideo) : new List<ResultUploadFile>();
            if (ResultUploadImages.Count > 0)
                StoryItems.Add(new StoryItem
                {
                    Type = "image",
                    User = $"استوری {i}",
                    Avatar = ApiLink.FullPath + ResultUploadImages[0].PathFileName,
                    Url = ApiLink.FullPath + ResultUploadImages[0].PathFileName,
                    Duration = 5000,
                    Link = item.Url
                });

            if (ResultUploadVideo.Count > 0)
            {
                var ffProbe = new FFProbe();
                i++;
                StoryItems.Add(new StoryItem
                {
                    Type = "video",
                    User = $"استوری {i}",
                    Avatar = ResultUploadImages.Count > 0 ? ApiLink.FullPath + ResultUploadImages[0].PathFileName : string.Empty,
                    Url = ApiLink.FullPath + ResultUploadVideo[0].PathFileName,
                    Duration = 10000,
                    Link = item.Url
                });
            }

           
        }
        return StoryItems;

    }
    private int? GetmsVideo()
    {

        var ffProbe = new FFProbe();
        var videoInfo = ffProbe.GetMediaInfo(ApiLink.FullPath + ResultUploadVideo[0].PathFileName);
        var ts = videoInfo.Duration;
        return (int)ts.TotalMilliseconds;
    }
}


