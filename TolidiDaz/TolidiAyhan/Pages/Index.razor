    private async Task LoadScriptsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("loadScript", "/assets/js/plugin/story-player/story-player.js");
        }
        catch (JSDisconnectedException)
        {
            return; // کاربر صفحه را ترک کرده
        }
    }

    private async Task GetData(string? SearchText = "")
    {
        var (data, authorized) = await RootApiGet.RunMethodApi($"Storys/Public/All", null, method: Method.Get);
        ResultStorys = data.Entities.ToList();

    }
    // private async Task LoadStoriesAsync()
    // {
    //     stories = await GetStoriesAsync();
