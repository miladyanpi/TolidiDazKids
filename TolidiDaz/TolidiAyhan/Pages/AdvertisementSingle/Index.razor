@using Dto.Models.DtoAdvertisementSingle
@using Dto.Models.DtoUploadFile
@inject RootApi<ResponseApiEntities<ResultAdvertisementSingle>> RootApiGet
@using Newtonsoft.Json
<section class="py-5" aria-label="تبلیغات ویژه"
         itemscope
         itemtype="https://schema.org/ItemList"
         id="advertisementsTwo">
    <h2 class="sr-only" itemprop="name">تبلیغات و پیشنهادات ویژه</h2>
    <div class="container">
        @foreach (var item in ResultAdvertisementSingles)
        {
            var ResultUploadFile = item.JsonPicture != null ? JsonConvert.DeserializeObject<List<ResultUploadFile>>(item.JsonPicture) : new List<ResultUploadFile>();

            var filepath = ResultUploadFile.Count > 0 ? ApiLink.FullPath + ResultUploadFile[0].PathFileName :ApiLink.FullPath + "images/No-Product-Image.png";
            <div class="lg:col-span-1 col-span-2"
            itemprop="itemListElement"
            itemscope
                 itemtype="@item.SiteUrl"
            itemid="#summer-promo">
                <a href="@item.SiteUrl"
                aria-label="مشاهده پیشنهادات"
                itemprop="url">
                    <img style="width:100%" src="@filepath"
                    class="rounded-lg transition block duration-300 hover:-translate-y-2"
                         alt="@item.Description"
                    loading="lazy"
                    itemprop="image">
                    <meta itemprop="name" content="@item.Title">
                    <meta itemprop="description" content="@item.Description">
                    <div itemprop="validFrom" content="2024-06-01T00:00:00+03:30"></div>
                    <div itemprop="validThrough" content="2024-09-22T23:59:59+03:30"></div>
                    <div itemprop="publisher" itemscope itemtype="@item.SiteUrl">
                        <meta itemprop="name" content="@item.SiteName">
                        <meta itemprop="url" content="@item.SiteUrl">
                    </div>
                </a>
            </div>
        }
    </div>
</section>

@code {
    @inject NavigationManager NavManager
    private List<ResultAdvertisementSingle>? ResultAdvertisementSingles { get; set; } = new List<ResultAdvertisementSingle>();
    protected override async Task OnInitializedAsync()
    {
        await GetData();
    }
    private async Task GetData(string? SearchText = "")
    {
        var (data, authorized) = await RootApiGet.RunMethodApi($"AdvertisementSingles/Public/All", null, method: Method.Get);
        if (authorized)
        {
            ResultAdvertisementSingles = data.Entities.ToList();
        }
        
        // StateHasChanged();
    }

}